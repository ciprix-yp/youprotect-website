# Doar numele variabilelor; valorile stau în Keychain (secret set youprotect-website <VAR>)
# și, pentru producție, în Cloudflare Pages → Settings → Variables and Secrets.
RESEND_API_KEY=
CRM_SYNC_TOKEN=
# Cheia Google Places API (recenziile de pe homepage, preluate la build). Producție: Cloudflare Pages.
GOOGLE_PLACES_API_KEY=
# URL-ul deploy hook-ului Cloudflare Pages (build lunar pentru recenzii). Folosit doar ca secret GitHub Actions.
CF_PAGES_DEPLOY_HOOK=
# Cheia contului de serviciu Google pentru Search Console (JSON în base64, pe un rând). Doar local, pentru
# scripts/seo/gsc.mjs; nu merge în Cloudflare și nici în GitHub.
GSC_SERVICE_ACCOUNT_B64=
# Cheia OpenAI API (doar local): scripts/seo/ai-visibility.mjs (vizibilitatea în ChatGPT) și scripts/images/generate-scenes.mjs.
OPENAI_API_KEY=

# Portalul B2B Sir Safety (b2b.sirsafety.com): documente și date tehnice pentru catalog. Doar local, nu în CI.
SIRSAFETY_B2B_USER=
SIRSAFETY_B2B_PASSWORD=

# Contul Portwest (portwest.com, logare cu numărul de cont): linkurile de marketing (poze, fișe, date de produs).
# Doar local, nu în CI. Vezi catalog/sources/portwest.md.
PORTWEST_ACCOUNT=
PORTWEST_PASSWORD=
