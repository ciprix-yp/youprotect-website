  "faq": [
    {
      "q": "Este jacheta MASCOT® Food & Care 20254 potrivită pentru industria alimentară?",
      "a": "Da. Jacheta MASCOT® Food & Care 20254 respectă principiile HACCP și este aprobată conform DIN 10524, standardul pentru îmbrăcămintea de lucru din industria alimentară."
    },
    {
      "q": "Rezistă la spălare industrială?",
      "a": "Da. Jacheta 20254 este certificată ProWash®, testată conform EN ISO 15797, și se poate spăla la maximum 60 °C."
    },
    {
      "q": "Se vede prin material în varianta albă?",
      "a": "Nu. Materialul jachetei MASCOT® Food & Care 20254 este netransparent, așa că jacheta arată îngrijit și în alb."
    },
    {
      "q": "Pot folosi jacheta cu un sistem de evidență prin cip?",
      "a": "Da. Jacheta 20254 e pregătită pentru o etichetă personalizată și pentru un cip HF sau UHF."
    },
    {
      "q": "Ce culori și mărimi sunt disponibile?",
      "a": "Pe site sunt prezentate culorile alb și bleumarin închis, în mărimile XS–6XL. Producătorul oferă și variante albe cu detalii colorate: roșu, verde, galben curry sau albastru azur."
    },
    {
      "q": "De unde pot comanda jachete HACCP MASCOT pentru echipa mea?",
      "a": "De la You Protect, din Satu Mare. Ceri ofertă de pe această pagină și poți cere să testezi jachetele înainte de decizie."
    }
  ],
