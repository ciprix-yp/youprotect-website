  "faq": [
    {
      "q": "Cât de elastici sunt pantalonii MASCOT® Frontline 20739?",
      "a": "Pantalonii MASCOT® Frontline 20739 sunt din țesătura ULTIMATE STRETCH, elastică pe patru direcții (88 % poliester, 12 % elastolefină), gândită ca nimic să nu strângă sau să jeneze la mișcare."
    },
    {
      "q": "Sunt potriviți pentru uniforme de birou sau recepție?",
      "a": "Da. Pantalonii MASCOT® Frontline 20739 fac parte din gama Corporate Casual, au croială modernă și arată îngrijit la birou, la recepție sau la client, cu confortul unui pantalon de lucru."
    },
    {
      "q": "Ce mărimi și lungimi există?",
      "a": "Mărimile C42–C68 la lungimea piciorului de 82 cm și C46–C62 la 90 cm. Talia se măsoară imediat deasupra buricului."
    },
    {
      "q": "Există un model pentru femei?",
      "a": "Da, MASCOT produce variantele pentru femei cu codurile 20637-511 și 20638-511."
    },
    {
      "q": "Pot personaliza pantalonii cu logo?",
      "a": "Da. Poți pune logoul pe buzunarele din spate, pe coapse și pe gambe, în zonele indicate de producător."
    },
    {
      "q": "De unde pot comanda pantaloni MASCOT® Frontline pentru echipa mea?",
      "a": "De la You Protect, din Satu Mare. Ceri ofertă de pe această pagină, inclusiv cu logo, și poți cere să testezi pantalonii înainte de decizie."
    }
  ],
