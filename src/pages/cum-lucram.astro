---
// Cum lucrăm (SEO-003, 27.11.2026): pașii spun ce faci tu, ce facem noi și termenul (08 §7, „Cum lucrăm / proces”);
// răspunde la obiecția „avem deja un furnizor” (09 §5). Doar fapte confirmate: consultanța gratuită, recomandarea pe
// roluri și planificarea comenzilor (homepage), showroom-ul cu cabină de probă, personalizarea, testarea
// (RISK_FREE_TESTING), programarea discuției din calendar (/confirmare/) și termenul din RESPONSE_TIME.
import { jsonLd } from "../lib/json-ld";
import ActionPhoto from "../components/media/ActionPhoto.astro";
import { imageGraph } from "../lib/poze-actiune";
import InnerPageLayout from "../layouts/InnerPageLayout.astro";
import { CTA_DISCUSS, RESPONSE_TIME, RISK_FREE_TESTING, SITE } from "../lib/site";

const inlineLink = "text-yp-white underline decoration-yp-white/30 underline-offset-4 hover:text-yp-yellow";

const industries = [
  { label: "Construcții și instalații", href: "/industrii/constructii/" },
  { label: "Transport și logistică", href: "/industrii/logistica/" },
  { label: "Producție și manufactură", href: "/industrii/productie/" },
];
// Termenul de răspuns, cu ultimul cuvânt lipit de cel dinainte, ca „ore.” să nu rămână singur pe rând.
const responseTime = RESPONSE_TIME.replace(/ (\S+)$/, "\u00a0$1");

// Întrebările de pe pagină, și în FAQPage.
const faq = [
  {
    q: "Cum alegi echipamentele de protecție potrivite pentru echipă?",
    a: "Pornești de la evaluarea riscurilor de la fiecare loc de muncă: ea spune ce echipament de protecție trebuie, iar angajatorul o face înainte să aleagă (HG\u00a0nr.\u00a01.048/2006, art.\u00a014). Apoi alegi pe rol, după ce face omul și unde lucrează: pe șantier, în depozit, în hală, la frig sau pe ploaie. Oamenii probează mărimea și modelul, iar înainte de comanda mare testezi produsele cu câțiva dintre ei.",
  },
  {
    q: "Cât costă discuția și recomandarea?",
    a: "Nimic. Consultanța la alegerea echipamentelor de protecție și recomandarea pentru fiecare rol sunt gratuite.",
  },
  {
    q: "În cât timp primesc oferta?",
    a: `O primești ${RESPONSE_TIME} de la cerere, cu prețurile pentru cantitățile echipei tale.`,
  },
  {
    q: "Avem deja un furnizor. De ce am schimba?",
    a: "Nu schimbi dintr-odată. Testezi produsele cu 3–5 oameni pe rol, 90 de zile, în condiții reale de lucru, iar noi măsurăm împreună cât rezistă și cât te costă pe zi de purtare față de ce folosești acum. Pe rolurile unde nu ies mai eficiente și nu ești mulțumit, îți dăm banii înapoi integral.",
  },
  {
    q: "Cum programez discuția?",
    a: `Apeși „${CTA_DISCUSS}”, răspunzi la câteva întrebări despre echipă, apoi îți alegi ziua și ora din calendar. Dacă nu alegi, revenim noi ${RESPONSE_TIME}.`,
  },
  {
    q: "Pot veni cu echipa să probeze în Satu\u00a0Mare?",
    a: `Da. Showroom-ul You Protect e în ${SITE.address.addressLocality}, pe ${SITE.address.streetAddress}, județul Satu\u00a0Mare, și are cabină de probă. Programul e de luni până vineri, între 09:00 și 17:00.`,
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({ "@type": "Question", name: item.q, acceptedAnswer: { "@type": "Answer", text: item.a } })),
};
---

<InnerPageLayout
  title="Cum alegem echipamentele de protecție pentru firme"
  description={`Cum lucrăm: discuție gratuită, recomandare pe fiecare rol, ofertă ${RESPONSE_TIME} și testare 90 de zile cu oamenii tăi, înainte de comanda mare.`}
  heroTitle="Cum alegem echipamentele de protecție pentru firma ta"
  heroSubtitle={`You Protect, din Vetiș, Satu Mare, te ajută să alegi echipamentele de protecție și hainele de lucru pentru fiecare rol din echipă. Discutăm, primești oferta ${RESPONSE_TIME}, apoi testezi produsele cu câțiva oameni înainte să echipezi toată firma.`}
  breadcrumb="Cum lucrăm"
  heroPhoto="S01"
  ctaHeading="Spune-ne ce face echipa ta"
  ctaButtonText={CTA_DISCUSS}
  ctaSecondaryButtonText="Vezi catalogul"
  ctaSecondaryButtonLink="/produse/"
>
  <script type="application/ld+json" set:html={jsonLd(imageGraph(["S01", "M05", "M01", "S16"]))} />

  <!-- Pentru cine -->
  <section class="py-16 md:py-24 lg:py-32 bg-[#0a0a0a] border-y border-white/5">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex flex-col lg:flex-row gap-16 lg:gap-24">
        <div class="lg:w-1/3 shrink-0">
          <h2
            class="text-4xl md:text-5xl md:leading-none font-light text-white leading-tight sticky top-32"
          >
            Pentru echipe de pe șantier, din depozit și din&nbsp;hală
          </h2>
        </div>

        <div class="lg:w-2/3 space-y-16">
          <div>
            <h3
              class="text-2xl text-white font-medium mb-4 flex items-center gap-4"
            >
              <span class="text-yp-yellow text-xl">01/</span> Ai deja un furnizor, dar ceva nu merge
            </h3>
            <p
              class="text-neutral-400 text-lg leading-relaxed pl-10 md:pl-12"
            >
              Mărimile nu se potrivesc, echipamentul se rupe repede sau oamenii nu-l poartă. Nu schimbi furnizorul
              dintr-odată: testezi produsele cu câțiva oameni pe rol, 90 de zile, și le compari cu ce folosești acum.
            </p>
          </div>

          <div>
            <h3
              class="text-2xl text-white font-medium mb-4 flex items-center gap-4"
            >
              <span class="text-yp-yellow text-xl">02/</span> Cumperi o dată sau de două ori pe an
            </h3>
            <p
              class="text-neutral-400 text-lg leading-relaxed pl-10 md:pl-12"
            >
              Planificăm împreună comenzile și livrările, ca oamenii să nu rămână fără echipament între două comenzi.
              Când ne scrii, poți spune și în ce lună comanzi de obicei.
            </p>
          </div>

          <div>
            <h3
              class="text-2xl text-white font-medium mb-4 flex items-center gap-4"
            >
              <span class="text-yp-yellow text-xl">03/</span> Lucrezi într-una din industriile noastre
            </h3>
            <div class="pl-10 md:pl-12">
              <ul
                class="grid grid-cols-1 md:grid-cols-2 gap-x-4 text-neutral-400 text-lg font-light"
              >
                {industries.map((i) => (
                  <li class="flex min-h-11 items-center gap-3">
                    <span class="w-1.5 h-1.5 shrink-0 rounded-full bg-white/20"></span>
                    <a href={i.href} class={`${inlineLink} inline-flex min-h-11 items-center`}>{i.label}</a>
                  </li>
                ))}
              </ul>
              <p class="mt-4 text-neutral-400 text-lg leading-relaxed">Lucrăm și cu firme din energie, utilități și servicii tehnice.</p>
            </div>
          </div>

          <div
            class="border-l-2 border-yp-yellow pl-6 py-2 mt-8"
          >
            <p class="text-neutral-300 italic">
              Dacă alegi strict după cel mai mic preț pe bucată, nu suntem alegerea potrivită. Noi comparăm costul pe zi
              de purtare: îl calculezi în <a href="/calculator-cost-echipamente/" class={inlineLink}>calculatorul de cost</a>
              sau îl măsurăm împreună în&nbsp;test.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ce primești -->
  <section class="py-16 md:py-24 lg:py-32 bg-yp-black border-y border-white/5">
    <div class="max-w-7xl mx-auto px-4">
      <div class="mb-16 text-center">
        <h2 class="text-3xl md:text-4xl md:leading-10 font-light leading-tight text-white">
          Ce primește echipa ta
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        <div class="sd-rise bg-white/5 p-8 md:p-12 rounded-xs border border-white/10 relative overflow-hidden group">
          <div class="absolute top-0 right-0 w-32 h-32 bg-yp-yellow/5 rounded-bl-[100px] -mr-8 -mt-8"></div>
          <div class="text-yp-yellow text-xl font-medium mb-6 border-b border-yp-yellow/30 pb-4 inline-block">01/</div>
          <h3 class="text-2xl text-white font-medium mb-4 relative z-10">Oamenii probează înainte de comandă</h3>
          <p class="text-neutral-400 text-lg leading-relaxed relative z-10">
            În showroom-ul din Vetiș, probează în cabină mărimea și modelul. Comanda o faci după ce știi ce li se
            potrivește.
          </p>
        </div>

        <div class="sd-rise bg-white/5 p-8 md:p-12 rounded-xs border border-white/10 relative overflow-hidden group">
          <div class="absolute top-0 right-0 w-32 h-32 bg-yp-yellow/5 rounded-bl-[100px] -mr-8 -mt-8"></div>
          <div class="text-yp-yellow text-xl font-medium mb-6 border-b border-yp-yellow/30 pb-4 inline-block">02/</div>
          <h3 class="text-2xl text-white font-medium mb-4 relative z-10">O recomandare pentru fiecare rol</h3>
          <p class="text-neutral-400 text-lg leading-relaxed relative z-10">
            Pentru fiecare rol primești echipamentul potrivit și motivul pentru care l-am ales. Nu o listă lungă de
            produse din care să alegi singur.
          </p>
        </div>

        <div class="sd-rise bg-white/5 p-8 md:p-12 rounded-xs border border-white/10 relative overflow-hidden group">
          <div class="absolute top-0 right-0 w-32 h-32 bg-yp-yellow/5 rounded-bl-[100px] -mr-8 -mt-8"></div>
          <div class="text-yp-yellow text-xl font-medium mb-6 border-b border-yp-yellow/30 pb-4 inline-block">03/</div>
          <h3 class="text-2xl text-white font-medium mb-4 relative z-10">Compari costul pe zi de&nbsp;purtare</h3>
          <p class="text-neutral-400 text-lg leading-relaxed relative z-10">
            Un produs mai scump poate costa mai puțin pe an. Cât te costă pe an și pe zi de purtare vezi în calculator,
            cu prețurile tale, iar în test măsurăm împreună.
          </p>
        </div>

        <div class="sd-rise bg-white/5 p-8 md:p-12 rounded-xs border border-white/10 relative overflow-hidden group">
          <div class="absolute top-0 right-0 w-32 h-32 bg-yp-yellow/5 rounded-bl-[100px] -mr-8 -mt-8"></div>
          <div class="text-yp-yellow text-xl font-medium mb-6 border-b border-yp-yellow/30 pb-4 inline-block">04/</div>
          <h3 class="text-2xl text-white font-medium mb-4 relative z-10">Haine de lucru cu logoul firmei</h3>
          <p class="text-neutral-400 text-lg leading-relaxed relative z-10">
            Tricourile, gecile, vestele și pantalonii primesc logoul prin broderie, serigrafie sau transfer termic, la
            partenerii noștri.
          </p>
        </div>
      </div>

      <div class="mt-12 text-center">
        <a
          href="/produse/"
          class="inline-flex border border-white/10 text-white/80 h-11 px-6 rounded-lg font-medium text-sm items-center justify-center gap-2 hover:bg-white/5 hover:border-white/30 hover:text-white transition-colors duration-200"
        >
          Vezi catalogul
        </a>
      </div>
    </div>
  </section>

  <!-- Pașii -->
  <section
    class="py-16 md:py-24 lg:py-32 bg-[#0a0a0a] border-y border-white/5"
  >
    <div class="max-w-7xl mx-auto px-4">
      <div class="mb-20 text-center">
        <h2 class="text-3xl md:text-4xl md:leading-10 font-light leading-tight text-white">
          În trei pași: <br/>discutăm, primești oferta, testezi
        </h2>
        <p
          class="mt-6 text-neutral-400 text-lg max-w-2xl mx-auto"
        >
          Tu ne spui ce face echipa ta. Restul îl pregătim noi, iar discuția și recomandarea sunt gratuite.
        </p>
      </div>

      <div class="flex flex-col gap-24 lg:gap-32">
        <!-- Pasul 1 -->
        <div
          class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center"
        >
          <div class="col-span-1 lg:col-span-5">
              <h3 class="text-3xl lg:text-4xl font-light text-white mb-6">
                Ne spui ce face echipa și unde&nbsp;lucrează
              </h3>
              <p
                class="text-lg text-neutral-400 leading-relaxed mb-6"
              >
                Apeși „{CTA_DISCUSS}”, răspunzi la câteva întrebări și îți alegi ziua și ora din calendar. Dacă nu
                alegi, revenim noi {responseTime}.
              </p>
              <p class="text-lg text-neutral-400 leading-relaxed">
                În discuție ne spui unde lucrează oamenii (pe șantier, în depozit, în hală, la frig sau pe ploaie), ce
                folosesc acum și ce nu merge. Dacă vrei, veniți în showroom-ul din Vetiș și probați în&nbsp;cabină.
              </p>
          </div>
          <div class="col-span-1 lg:col-span-7">
            <div
              class="aspect-[16/9] md:aspect-[21/9] lg:aspect-[16/9] bg-neutral-900 overflow-clip relative rounded-xl"
            >
              <ActionPhoto
                id="M05"
                sizes="(min-width: 1280px) 768px, (min-width: 1024px) 58vw, calc(100vw - 2rem)"
                motion
                class="absolute inset-0"
              />
            </div>
          </div>
        </div>

        <!-- Pasul 2 -->
        <div
          class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center"
        >
          <div
            class="col-span-1 lg:col-span-7 order-2 lg:order-1"
          >
            <div
              class="aspect-[16/9] md:aspect-[21/9] lg:aspect-[16/9] bg-neutral-900 overflow-clip relative rounded-xl"
            >
              <ActionPhoto
                id="M01"
                sizes="(min-width: 1280px) 768px, (min-width: 1024px) 58vw, calc(100vw - 2rem)"
                motion
                class="absolute inset-0"
              />
            </div>
          </div>
          <div
            class="col-span-1 lg:col-span-5 order-1 lg:order-2"
          >
              <h3 class="text-3xl lg:text-4xl font-light text-white mb-6">
                Primești recomandarea pe roluri și&nbsp;oferta
              </h3>
              <p
                class="text-lg text-neutral-400 leading-relaxed mb-6"
              >
                Pentru fiecare rol alegem echipamentul de protecție și hainele de lucru potrivite activității, bugetului
                și imaginii firmei, cu motivul fiecărei alegeri. Oferta o primești {responseTime}.
              </p>
              <p class="text-lg text-neutral-400 leading-relaxed">
                Îți spunem și unde poți simplifica. Dacă vrei logoul firmei pe haine, personalizarea intră în aceeași
                ofertă, cu un singur&nbsp;interlocutor.
              </p>
          </div>
        </div>

        <!-- Pasul 3 (ancora #testare: aici duce linkul din „Testezi fără riscuri”, RISK_FREE_TESTING) -->
        <div
          id="testare"
          class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center scroll-mt-28"
        >
          <div class="col-span-1 lg:col-span-5">
              <h3 class="text-3xl lg:text-4xl font-light text-white mb-6">
                Testezi înainte să echipezi toată&nbsp;firma
              </h3>
              <p
                class="text-lg text-neutral-400 leading-relaxed mb-6"
              >
                {RISK_FREE_TESTING.text} <a href={RISK_FREE_TESTING.href} class="text-yp-yellow underline underline-offset-4 hover:text-white">{RISK_FREE_TESTING.linkLabel}</a>
              </p>
              <p class="text-lg text-neutral-400 leading-relaxed">
                Testarea nu se aplică la unele echipamente, de exemplu căști, hamuri sau măști: lista e pe pagina cu
                condițiile. După test comanzi pentru toată echipa, iar noi livrăm în toată&nbsp;România.
              </p>
          </div>
          <div class="col-span-1 lg:col-span-7">
            <div
              class="aspect-[16/9] md:aspect-[21/9] lg:aspect-[16/9] bg-neutral-900 overflow-clip relative rounded-xl"
            >
              <ActionPhoto
                id="S16"
                sizes="(min-width: 1280px) 768px, (min-width: 1024px) 58vw, calc(100vw - 2rem)"
                motion
                class="absolute inset-0"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- CTA după pași -->
      <div class="mt-20 flex flex-col sm:flex-row justify-center items-center gap-4">
        <a href="/programeaza-discutie/"
            class="inline-flex h-12 items-center justify-center rounded-lg bg-yp-yellow px-6 text-sm font-medium text-yp-black transition-colors hover:bg-white">
            {CTA_DISCUSS}
        </a>
        <a href="/cere-oferta/"
            class="inline-flex h-12 items-center justify-center rounded-lg border border-yp-white/25 px-6 text-sm font-medium text-yp-white transition-colors hover:border-yp-yellow hover:text-yp-yellow">
            Cere ofertă
        </a>
      </div>
    </div>
  </section>

  <!-- Ce mai include -->
  <section class="py-16 md:py-24 lg:py-32 bg-yp-black">
    <div class="max-w-7xl mx-auto px-4">
      <div class="mb-16 text-center lg:text-left">
        <h2 class="text-xl md:text-2xl text-white font-light tracking-wide">
          Ce mai include colaborarea cu You&nbsp;Protect
        </h2>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 gap-y-12"
      >
        <div>
          <h3
            class="text-white text-lg font-medium mb-3 border-b border-white/10 pb-3"
          >
            Consultanță gratuită
          </h3>
          <p class="text-neutral-400 text-sm">
            Discuția despre echipă și recomandarea pe roluri nu te costă nimic.
          </p>
        </div>
        <div>
          <h3
            class="text-white text-lg font-medium mb-3 border-b border-white/10 pb-3"
          >
            O singură ofertă
          </h3>
          <p class="text-neutral-400 text-sm">
            Echipamentul de protecție, hainele de lucru și personalizarea cu logo vin într-o singură ofertă, de la
            You&nbsp;Protect.
          </p>
        </div>
        <div>
          <h3
            class="text-white text-lg font-medium mb-3 border-b border-white/10 pb-3"
          >
            Documentele producătorului
          </h3>
          <p class="text-neutral-400 text-sm">
            În catalog, fiecare produs are fișa lui, cu documentele producătorului și, unde există, standardele declarate
            de el.
          </p>
        </div>
        <div>
          <h3
            class="text-white text-lg font-medium mb-3 border-b border-white/10 pb-3"
          >
            Livrare în toată România
          </h3>
          <p class="text-neutral-400 text-sm">
            Avem baza în Vetiș, județul Satu Mare, și livrăm firmelor din toată țara.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Întrebări frecvente -->
  <section class="py-16 md:py-24 bg-[#050505]" aria-labelledby="intrebari">
    <script type="application/ld+json" set:html={jsonLd(faqSchema)} />
    <div class="max-w-7xl mx-auto px-4">
      <div class="max-w-3xl">
        <h2 id="intrebari" class="text-3xl md:text-4xl md:leading-10 font-light text-white leading-tight">
          Întrebări frecvente despre cum lucrăm
        </h2>
        <dl class="mt-10 space-y-8">
          {faq.map((item) => (
            <div>
              <dt class="text-lg text-white font-medium">{item.q}</dt>
              <dd class="mt-2 text-neutral-300 font-light leading-relaxed">{item.a}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-10 text-neutral-400 leading-relaxed">
          Pe larg, în ghidurile despre <a href="/ghiduri/cost-echipament-protectie-muncitor/" class={inlineLink}>costul echipamentului pe muncitor</a>
          și <a href="/ghiduri/haine-de-lucru-care-rezista/" class={inlineLink}>hainele de lucru rezistente</a>.
        </p>
      </div>
    </div>
  </section>
</InnerPageLayout>
