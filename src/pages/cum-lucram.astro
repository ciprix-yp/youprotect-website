---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Cum Lucrăm - You Protect">
  <!-- Hero Section -->
  <section class="py-20 bg-yp-black relative">
    <div class="absolute inset-0 bg-gradient-to-b from-yp-black/70 to-yp-black/90 z-10"></div>
    <div class="absolute inset-0 z-0">
      <div class="bg-yp-gray/30 w-full h-full flex items-center justify-center">
        <span class="text-yp-white/30 text-xl">[Imagine: Manager + Inginer pe șantier, echipament YP, atmosferă colaborare]</span>
      </div>
    </div>
    <div class="max-w-6xl mx-auto px-4 text-center relative z-20 py-20">
      <h1 class="text-5xl md:text-6xl font-heading mb-6 leading-tight">
        Partenerul de încredere<br/>
        pentru echipe care construiesc viitorul
      </h1>
      <p class="text-xl md:text-2xl text-yp-white/90 max-w-4xl mx-auto">
        Soluții complete de echipamente de protecție și identitate vizuală pentru companii care pun preț pe siguranța și imaginea angajaților lor.
      </p>
    </div>
  </section>

  <!-- Profilul Clientului (Filter Logic) -->
  <section class="py-20 bg-yp-gray">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading mb-16 text-center">
        Pentru cine suntem partenerul ideal?
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Companii cu Viziune -->
        <div class="bg-yp-black p-8 rounded-xl">
          <div class="text-5xl mb-6">🎯</div>
          <h3 class="text-2xl font-heading mb-4 text-yp-yellow">
            Companii cu viziune
          </h3>
          <p class="text-yp-white/80 leading-relaxed">
            Lucrăm cel mai bine cu organizații de <strong class="text-yp-white">15-40+ angajați</strong>, unde decizia este rapidă, dar nevoia de structură și predictibilitate este critică.
          </p>
        </div>

        <!-- Industrii Tehnice -->
        <div class="bg-yp-black p-8 rounded-xl">
          <div class="text-5xl mb-6">🏗️</div>
          <h3 class="text-2xl font-heading mb-4 text-yp-yellow">
            Industrii tehnice
          </h3>
          <p class="text-yp-white/80 leading-relaxed">
            <strong class="text-yp-white">Construcții, Instalații, Producție, Service Auto.</strong> Înțelegem specificul muncii voastre și normele de protecție necesare.
          </p>
        </div>

        <!-- Lideri Care Respectă Echipa -->
        <div class="bg-yp-black p-8 rounded-xl">
          <div class="text-5xl mb-6">⭐</div>
          <h3 class="text-2xl font-heading mb-4 text-yp-yellow">
            Lideri care își respectă echipa
          </h3>
          <p class="text-yp-white/80 leading-relaxed">
            Ne adresăm managerilor care știu că un echipament de calitate <strong class="text-yp-white">nu este o cheltuială, ci o investiție</strong> în mândria și performanța echipei.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Procesul Nostru în 3 Pași -->
  <section class="py-20 bg-yp-black">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading mb-6 text-center">
        Procesul Nostru în 3 Pași
      </h2>
      <p class="text-xl text-yp-white/70 text-center mb-16 max-w-3xl mx-auto">
        Claritate și simplificare. Nu complicăm lucrurile. Nu îți vindem "din catalog".
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <!-- Pasul 1: Consultanță -->
        <div class="text-center">
          <div class="w-24 h-24 bg-yp-yellow rounded-full flex items-center justify-center text-yp-black text-4xl font-heading mx-auto mb-6">
            1
          </div>
          <div class="text-6xl mb-4">✓</div>
          <h3 class="text-2xl font-heading mb-4 text-yp-yellow">
            Consultanță & Audit
          </h3>
          <p class="text-sm text-yp-green mb-4 font-semibold">Gratuit</p>
          <p class="text-yp-white/80 leading-relaxed">
            Nu îți vindem din catalog. Discutăm despre <strong class="text-yp-white">riscurile specifice</strong>, bugetul și nevoile de branding. Identificăm exact ce echipamente sunt necesare conform normelor SSM și imaginii dorite.
          </p>
        </div>

        <!-- Pasul 2: Testare -->
        <div class="text-center">
          <div class="w-24 h-24 bg-yp-yellow rounded-full flex items-center justify-center text-yp-black text-4xl font-heading mx-auto mb-6">
            2
          </div>
          <div class="text-6xl mb-4">👕</div>
          <h3 class="text-2xl font-heading mb-4 text-yp-yellow">
            Testare & Mostre
          </h3>
          <p class="text-sm text-yp-white/50 mb-4">Încerci înainte să cumperi</p>
          <p class="text-yp-white/80 leading-relaxed">
            Echipa ta <strong class="text-yp-white">probează echipamentele</strong>. Verificăm mărimile, confortul și materialele în condiții reale de lucru. Nimic nu se comandă "pe nevăzute".
          </p>
        </div>

        <!-- Pasul 3: Achiziție -->
        <div class="text-center">
          <div class="w-24 h-24 bg-yp-yellow rounded-full flex items-center justify-center text-yp-black text-4xl font-heading mx-auto mb-6">
            3
          </div>
          <div class="text-6xl mb-4">📦</div>
          <h3 class="text-2xl font-heading mb-4 text-yp-yellow">
            Achiziție & Recurență
          </h3>
          <p class="text-sm text-yp-white/50 mb-4">Simplificare maximă</p>
          <p class="text-yp-white/80 leading-relaxed">
            Livrăm echipamentele personalizate. Păstrăm <strong class="text-yp-white">istoricul comenzilor tale</strong> pentru reaprovizionare rapidă (noii angajați, schimb sezon), fără a relua procesul de la zero.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- De ce You Protect? (Diferențiatori) -->
  <section class="py-20 bg-yp-gray">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading mb-16 text-center">
        De ce You Protect?
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Partener, Nu Furnizor -->
        <div class="bg-yp-black p-8 rounded-xl text-center">
          <div class="text-5xl mb-4">🤝</div>
          <h3 class="text-xl font-heading mb-4 text-yp-yellow">
            Nu doar furnizor, ci partener
          </h3>
          <p class="text-yp-white/70">
            Îți luăm grija echipamentelor de pe cap. Tu te ocupi de afacere.
          </p>
        </div>

        <!-- Identitate Vizuală -->
        <div class="bg-yp-black p-8 rounded-xl text-center">
          <div class="text-5xl mb-4">✨</div>
          <h3 class="text-xl font-heading mb-4 text-yp-yellow">
            Identitate vizuală
          </h3>
          <p class="text-yp-white/70">
            Transformăm uniforma într-o carte de vizită. Echipa ta arată ca o firmă serioasă.
          </p>
        </div>

        <!-- Predictibilitate -->
        <div class="bg-yp-black p-8 rounded-xl text-center">
          <div class="text-5xl mb-4">📊</div>
          <h3 class="text-xl font-heading mb-4 text-yp-yellow">
            Predictibilitate
          </h3>
          <p class="text-yp-white/70">
            Știi exact ce primești și când primești. Fără surprize neplăcute.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-20 bg-yp-yellow">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-4xl md:text-5xl font-heading text-yp-black mb-6">
        Pregătit să ridici standardul echipei tale?
      </h2>
      <p class="text-xl text-yp-black/80 mb-8">
        Consultanța inițială este <strong>gratuită și fără obligații</strong>. Discutăm, identificăm soluții, iar tu decizi dacă mergem mai departe.
      </p>
      <button class="bg-yp-black text-yp-yellow font-heading font-bold px-8 py-4 rounded-lg text-lg hover:bg-yp-black/90 hover:shadow-xl transition-all">
        Programează o Discuție
      </button>
      <p class="text-sm text-yp-black/60 mt-4">
        Răspundem în maximum 24 de ore.
      </p>
    </div>
  </section>
</BaseLayout>
