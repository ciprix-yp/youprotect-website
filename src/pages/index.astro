---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="You Protect - Echipamente de Protecție Profesionale">
  <main class="min-h-screen flex items-center justify-center px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-5xl md:text-6xl font-heading mb-6">
        You Protect
      </h1>
      <p class="text-xl md:text-2xl text-yp-white/80 mb-8">
        Echipamente de Protecție și Uniforme Profesionale
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <button class="bg-yp-yellow text-yp-black font-heading font-bold px-8 py-4 rounded-lg text-lg hover:bg-yp-yellow/90 transition-all">
          Cere Ofertă Personalizată
        </button>
        <button class="border-2 border-yp-green text-yp-green font-heading font-bold px-6 py-3 rounded-lg text-lg hover:bg-yp-green hover:text-yp-white transition-all">
          Vezi Produsele
        </button>
      </div>
      <div class="mt-12 text-yp-white/60">
        <p>Website în construcție - Coming Soon</p>
        <p class="text-sm mt-2">Staging Environment: Cloudflare Pages</p>
      </div>
    </div>
  </main>
</BaseLayout>
