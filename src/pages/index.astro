---
// Homepage, restructurat pe 20.11.2026 (D-2026-11-20-05): ce vinzi și de ce să alegi You Protect, cu fapte, nu cu
// abstracțiuni. Ordinea: hero, mărci, recenzii, categorii, „De ce You Protect”, pași, ce include, CTA, întrebări.
// Textele, rescrise pe 21.11.2026 după harta cuvintelor-cheie (PROJECT_OS/09-HARTA-CUVINTE-CHEIE.md): expresia
// principală „echipamente de protecție și haine de lucru”, plus „protecția muncii”, „uniforme de lucru”, Satu Mare.
import BaseLayout from "../layouts/BaseLayout.astro";
import Testimonials from "../components/home/Testimonials.astro";
import RiskFreeTesting from "../components/global/RiskFreeTesting.astro";
import CategoryTiles from "../components/products/CategoryTiles.astro";
import { publishedTestimonials as testimonials } from "../lib/testimonials";
import { CTA_DISCUSS, RESPONSE_TIME, RISK_FREE_TESTING, SITE } from "../lib/site";
import { btnPrimary, btnSecondary, pageContainer } from "../lib/ui";
import ActionPhoto from "../components/media/ActionPhoto.astro";
import HeroPhotoSet from "../components/home/HeroPhotoSet.astro";
import FaqList from "../components/FaqList.astro";
import { jsonLd } from "../lib/json-ld";
import { heroPreload, imageGraph } from "../lib/poze-actiune";


const sectionHeading = "font-heading text-3xl font-light leading-tight text-white lg:text-4xl lg:leading-10";
const textLink = "inline-flex min-h-11 items-center text-sm font-medium text-yp-yellow underline underline-offset-4 hover:text-white";

const brands = [
  { name: "MASCOT", logo: "/logos/logo-1.webp", href: "/produse/mascot/" },
  { name: "Sir Safety", logo: "/logos/logo-2.webp", href: "/produse/sir-safety/" },
  { name: "Portwest", logo: "/logos/logo-3.webp", href: "/produse/portwest/" },
  { name: "Malfini", logo: "/logos/logo-4.webp" },
];

// Patru fapte, fiecare cu pagina care îl dovedește.
const reasons = [
  {
    title: "Alegi după costul real",
    text: "Prețul de pe factură e doar o parte. Calculatorul îți arată cât te costă pe zi de purtare bocancii și hainele pe care le folosești acum, față de unele care țin mai mult.",
    link: { label: "Calculează costul real", href: "/calculator-cost-echipamente/" },
  },
  {
    title: "Testezi 90 de zile, fără riscuri",
    text: RISK_FREE_TESTING.short,
    link: { label: RISK_FREE_TESTING.linkLabel, href: RISK_FREE_TESTING.href },
  },
  {
    title: "Vezi și probezi înainte",
    text: "În showroom-ul din Vetiș, Satu Mare, probezi în cabină mărimea și modelul pentru echipă. Pe fiecare fișă din catalog găsești documentele producătorului și, unde există, standardele declarate de el.",
    link: { label: "Vezi showroom-ul", href: "/echipamente-protectie-satu-mare/#showroom" },
  },
  {
    title: "Uniforme de lucru cu logo-ul firmei",
    text: "Tricourile, gecile, vestele și pantalonii primesc logo-ul firmei prin broderie, serigrafie sau transfer termic, la partenerii noștri. Livrăm în toată România.",
    link: { label: "Cum funcționează personalizarea", href: "/haine-de-lucru-personalizate/" },
  },
];

const steps = [
  {
    title: "Discutăm despre activitatea și echipa ta",
    text: "Ne spui ce face echipa și unde lucrează: pe șantier, în depozit, în hală, la frig sau pe ploaie. Și ce nu merge cu echipamentele de acum.",
  },
  {
    title: "Primești o recomandare și o ofertă",
    text: `Alegem echipamentele de protecție și hainele de lucru potrivite activității, bugetului și imaginii firmei tale. Oferta o primești ${RESPONSE_TIME}.`,
  },
  {
    title: "Testezi, apoi echipezi toată firma",
    text: "Încerci produsele cu 3–5 oameni pe rol, 90 de zile, în condiții reale de lucru. Comanda pentru toată echipa o faci abia după ce știi ce merge.",
  },
];

const includes = [
  "Consultanță gratuită la alegerea echipamentelor de protecție",
  "O recomandare pentru fiecare rol din echipă, nu o listă lungă de produse",
  "Cumperi o dată sau de două ori pe an? Planificăm împreună comenzile și livrările, ca oamenii să nu rămână fără echipament",
];

// Întrebările frecvente: aceeași listă pentru pagină și pentru FAQPage (JSON-LD).
const faq = [
  {
    q: "Ce echipamente de protecție sunt obligatorii pentru angajatori în România?",
    a: "Cele cerute de evaluarea riscurilor de la fiecare loc de muncă: legea nu dă o listă unică pentru toate firmele. Angajatorul le dă oamenilor gratuit și răspunde de întreținerea și înlocuirea lor (HG nr. 1.048/2006, art. 10). De aceea, echipamentele de protecția muncii se aleg după activitate, mediul de lucru și oamenii care le poartă.",
    more: { label: "Cât costă echipamentul pe muncitor", href: "/ghiduri/cost-echipament-protectie-muncitor/" },
  },
  {
    q: "Cum aleg corect hainele de lucru pentru echipa mea?",
    a: "Pornești de la ce face echipa: activitatea, sezonul, cât de repede se uzează hainele și cum se spală. Apoi alegi confortul și imaginea pe care vrei să o transmită oamenii, cu logo-ul firmei dacă vrei uniforme de lucru. O recomandare pe fiecare rol e mai utilă decât o listă lungă de produse.",
    more: { label: "Cum alegi haine de lucru care rezistă", href: "/ghiduri/haine-de-lucru-care-rezista/" },
  },
  {
    q: "Care este diferența dintre S1P și S3 la bocancii de protecție?",
    a: "Și S1P, și S3 au bombeu de protecție, călcâi închis, proprietăți antistatice, absorbție de energie la călcâi și protecție la perforare. S3 adaugă două lucruri: fața încălțămintei rezistă la pătrunderea și absorbția apei, iar talpa are crampoane. Dacă oamenii tăi lucrează afară, pe teren denivelat sau pe ude, ai nevoie de ce adaugă S3.",
    more: { label: "Ghidul S1P sau S3", href: "/ghiduri/s1p-sau-s3/" },
  },
  {
    q: "Pot testa produsele înainte să echipez toată firma?",
    a: `Da, prin programul „Testare fără riscuri”. ${RISK_FREE_TESTING.text}`,
    more: { label: RISK_FREE_TESTING.linkLabel, href: RISK_FREE_TESTING.href },
  },
  {
    q: "Aveți showroom unde pot proba produsele?",
    a: "Da. Showroom-ul You Protect e în Vetiș, pe Strada Careiului nr. 45, în Parc Industrial Areli, județul Satu Mare, și are cabină de probă. Programul e de luni până vineri, între 09:00 și 17:00.",
    more: { label: "Adresa și harta", href: "/echipamente-protectie-satu-mare/#showroom" },
  },
  {
    q: "Livrați echipamente de protecție în toată România?",
    a: "Da. You Protect livrează echipamente de protecție, haine de lucru și uniforme cu logo firmelor din toată România, de la Satu Mare și Baia Mare la Oradea, Cluj sau București. Avem baza în Vetiș, județul Satu Mare, și lucrăm cu firme din nord-vestul țării. După proiect și volum, colaborarea poate include consultanță, alegerea produselor, personalizare și planificarea comenzilor recurente.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};

// Pozele eroului rotativ: singurul loc unde sunt numite (HeroPhotoSet, scriptul din <head> și imageGraph le citesc de aici).
// La fiecare încărcare se afișează una la întâmplare (vezi HeroPhotoSet.astro); prima, S02, e și cea fără JavaScript. Fiecare
// poză trebuie să aibă `erou: true`, `portret` și `eroul` (cadru + gradient) în src/data/poze-actiune.json.
const heroPhotos = ["S02", "M24", "M25", "M26", "M27", "P14", "P15", "P16", "S18", "S19"];
---

<BaseLayout
  preloadFonts={["heading-300", "heading-300-ext"]}
  title="Echipamente de protecție și haine de lucru"
  description="Echipamente de protecție și haine de lucru pentru firme, cu logo, alese după costul real. You Protect: showroom în Vetiș, Satu Mare, livrare în toată România."
>
  <script type="application/ld+json" set:html={jsonLd(faqSchema)} />
  {/* ImageObject pentru TOATE cele 10 poze ale eroului (și M12): oricare poate fi afișată la o încărcare, iar creditul trebuie să
      stea în datele structurate pentru poza afișată (nu apare vizibil pe pagină). */}
  <script type="application/ld+json" set:html={jsonLd(imageGraph(["M12", ...heroPhotos]))} />
  {/* Alege poza eroului la întâmplare și îi preîncarcă fișierul (telefon: decupajul portret; desktop: varianta de erou), înainte
      ca parserul să ajungă la erou. Nu citește și nu scrie nimic în afara paginii: indexul ajunge doar în `data-erou` pe <html>.
      `imagesrcset`/`imagesizes` trebuie să fie identice cu `srcset`/`sizes` din <picture>-ul eroului (ActionPhoto: telefon `50vw`
      pe <source>, desktop `100vw` pe <img>), altfel browserul ar descărca două fișiere. Datele ([slug, lățimi erou, lățimi
      portret]) vin din heroPreload(), generate la build din poze-actiune-variante.json. */}
  <script slot="head" is:inline define:vars={{ H: heroPreload(heroPhotos) }}>
    (function () {
      var i = 0;
      try {
        i = Math.floor(Math.random() * H.photos.length);
      } catch (e) {}
      if (!(i >= 0 && i < H.photos.length)) i = 0;
      document.documentElement.setAttribute("data-erou", i);
      var d = H.photos[i];
      var preload = function (media, prefix, widths, sizes) {
        var l = document.createElement("link");
        l.rel = "preload";
        l.as = "image";
        l.media = media;
        l.setAttribute("fetchpriority", "high");
        l.setAttribute("imagesizes", sizes);
        l.setAttribute(
          "imagesrcset",
          widths.map(function (w) { return H.dir + d[0] + "-" + prefix + w + ".webp " + w + "w"; }).join(", ")
        );
        document.head.appendChild(l);
      };
      preload("(max-width: 767px)", "p", d[2], "50vw");
      preload("(min-width: 768px)", "", d[1], "100vw");
    })();
  </script>

  <!-- Butonul fix de pe telefon: dispare la derulare în jos, revine la derulare în sus. -->
  <div
    id="mobile-sticky-catalog"
    class="md:hidden fixed z-[999] left-1/2 top-24 transition duration-300 ease-out"
    style="transform: translate(-50%, -12px); opacity: 0; visibility: hidden"
  >
    <a
      href="/programeaza-discutie/"
      class="flex min-h-[44px] items-center justify-center whitespace-nowrap rounded-full border border-yp-black/10 bg-yp-yellow px-5 py-2.5 text-sm font-medium text-yp-black shadow-lg"
    >
      {CTA_DISCUSS}
    </a>
  </div>

  <script>
    // Apare doar după hero (unde butoanele sunt deja vizibile) și doar la derularea în sus.
    let lastScrollY = window.scrollY;
    const stickyBtn = document.getElementById("mobile-sticky-catalog");
    const hero = document.getElementById("hero");
    window.addEventListener(
      "scroll",
      () => {
        if (!stickyBtn) return;
        const y = window.scrollY;
        const pastHero = y > (hero?.offsetHeight ?? 600);
        const show = pastHero && y < lastScrollY;
        stickyBtn.style.transform = show ? "translate(-50%, 0)" : "translate(-50%, -12px)";
        stickyBtn.style.opacity = show ? "1" : "0";
        stickyBtn.style.visibility = show ? "visible" : "hidden";
        lastScrollY = y;
      },
      { passive: true },
    );
  </script>

  <section id="hero" class="relative overflow-clip border-b border-white/5">
    {/* Poza eroului, aleasă la întâmplare la fiecare încărcare (HeroPhotoSet: ActionPhoto cu `portret`). Telefon: decupaj portret 4:5, 768 px lățime pe un ecran de 390 px
        (~2x), pus ca bloc în partea de sus a secțiunii; titlul începe peste ultimul sfert al pozei, pe gradient, iar restul
        textului stă pe fond negru. De la 768 px: fundal pe toată secțiunea, ca înainte (opacitate și gradient neschimbate). */}
    <div class="absolute inset-x-0 top-0 h-[30rem] md:inset-y-0 md:h-auto">
      <HeroPhotoSet photos={heroPhotos} />
    </div>

    <div class:list={[pageContainer, "relative pb-14 pt-[19rem] md:py-24 lg:py-28"]}>
      <div class="sd-hero-content max-w-3xl">
        <h1 class="font-heading text-[2rem] font-light leading-[1.12] tracking-tight text-white sm:text-4xl sm:leading-10 md:text-5xl md:leading-none xl:text-6xl">
          Echipamente de protecție și haine de lucru alese după costul real, nu după preț
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-yp-white/80 sm:text-lg sm:leading-7">
          You Protect, din Satu Mare, echipează firme cu echipamente de protecția muncii și haine de lucru MASCOT, Portwest
          și Sir Safety. Le alegem după ce face echipa ta, le personalizăm cu logo-ul firmei și le livrăm în toată România.
          În showroom-ul din Vetiș le vezi și le probezi înainte de comandă.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/programeaza-discutie/" class={btnPrimary}>{CTA_DISCUSS}</a>
          <a href="/cere-oferta/" class={btnSecondary}>Cere ofertă</a>
        </div>
        <div class="mt-3 flex flex-wrap gap-x-6">
          <a href="/produse/" class={textLink}>Vezi catalogul</a>
          <a href="/calculator-cost-echipamente/" class={textLink}>Calculează cât te costă de fapt echipamentele</a>
        </div>
        <div class="mt-6 max-w-2xl border-t border-white/10 pt-6">
          <RiskFreeTesting variant="inline" />
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-white/5" aria-labelledby="marci">
    <div class:list={[pageContainer, "py-12"]}>
      <h2 id="marci" class="mb-8 text-center text-sm text-yp-white/60">Mărci cu care lucrăm</h2>
      <ul class="grid grid-cols-4 items-center justify-items-center gap-2 sm:gap-10">
        {brands.map((b) => (
          <li class="w-full max-w-[96px] sm:max-w-[200px] md:max-w-[240px]">
            {b.href ? (
              <a href={b.href} class="group flex min-h-11 items-center justify-center rounded-xl border border-transparent p-1 transition-colors hover:border-yp-yellow/40 sm:p-4 md:p-6">
                <img src={b.logo} alt={`Produse ${b.name}`} class="h-14 w-auto rounded-md object-contain sm:h-16 md:h-24 md:opacity-70 md:grayscale md:transition md:group-hover:opacity-100 md:group-hover:grayscale-0" loading="lazy" />
              </a>
            ) : (
              <div class="flex items-center justify-center p-1 sm:p-4 md:p-6">
                <img src={b.logo} alt={b.name} class="h-14 w-auto rounded-md object-contain sm:h-16 md:h-24 md:opacity-70 md:grayscale" loading="lazy" />
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {
    testimonials.length > 0 && (
      <section class="border-b border-white/5 bg-[#0a0a0a]" aria-labelledby="recenzii">
        <div class:list={[pageContainer, "py-14 md:py-24"]}>
          <h2 id="recenzii" class:list={[sectionHeading, "mb-12 text-center"]}>Ce spun firmele cu care lucrăm</h2>
          <Testimonials testimonials={testimonials} />
        </div>
      </section>
    )
  }

  <section class="border-b border-white/5" aria-labelledby="categorii">
    <div class:list={[pageContainer, "py-12 md:py-20"]}>
      <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <h2 id="categorii" class:list={[sectionHeading, "max-w-3xl"]}>
          De la bocanci de protecție la cască: tot ce poartă echipa ta
        </h2>
        <a href="/produse/" class:list={[textLink, "shrink-0"]}>Vezi tot catalogul</a>
      </div>
      <CategoryTiles />
    </div>
  </section>

  <section class="border-b border-white/5 bg-[#0a0a0a]" aria-labelledby="de-ce">
    <div class:list={[pageContainer, "py-14 md:py-24"]}>
      <h2 id="de-ce" class:list={[sectionHeading, "max-w-3xl"]}>Ce câștigi când lucrezi cu You Protect</h2>
      <ul class="mt-10 grid gap-4 md:grid-cols-2">
        {reasons.map((r) => (
          <li data-tilt="4" class="card-3d relative flex flex-col rounded-xl border border-white/[0.08] bg-yp-surface p-6 shadow-card hover:border-yp-yellow/30 hover:shadow-card-hover md:p-8">
            <h3 class="font-heading text-xl font-medium text-white">{r.title}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-yp-white/75">{r.text}</p>
            <a href={r.link.href} class:list={[textLink, "relative z-10 mt-4 w-fit"]}>{r.link.label}</a>
            <span class="tilt-sheen" aria-hidden="true"></span>
          </li>
        ))}
      </ul>
      <div class="mt-4 aspect-[4/3] overflow-clip rounded-xl sm:aspect-[16/9]">
        <ActionPhoto id="M12" sizes="(min-width: 1280px) 1248px, calc(100vw - 2rem)" motion />
      </div>
    </div>
  </section>

  <section class="border-b border-white/5" aria-labelledby="pasi">
    <div class:list={[pageContainer, "py-14 md:py-24"]}>
      <h2 id="pasi" class:list={[sectionHeading, "max-w-3xl"]}>Cum începe colaborarea cu You Protect</h2>
      <ol class="mt-10 grid gap-8 md:grid-cols-3">
        {steps.map((s, i) => (
          <li class="sd-step border-t border-yp-yellow/60 pt-6">
            <p class="text-sm font-medium text-yp-yellow">Pasul {i + 1}</p>
            <h3 class="mt-2 font-heading text-xl font-medium text-white">{s.title}</h3>
            <p class="mt-3 leading-relaxed text-yp-white/75">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="border-b border-white/5 bg-[#0a0a0a]" aria-labelledby="include">
    <div class:list={[pageContainer, "py-14 md:py-24"]}>
      <h2 id="include" class:list={[sectionHeading, "max-w-3xl"]}>Ce include colaborarea cu You Protect</h2>
      <ul class="mt-10 grid gap-x-12 gap-y-5 md:grid-cols-2">
        {includes.map((item) => (
          <li class="sd-check flex items-start gap-3 leading-relaxed text-yp-white/85">
            <svg class="mt-1 h-5 w-5 shrink-0 text-yp-yellow" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sd-expand bg-yp-yellow">
    <div class:list={[pageContainer, "py-16 text-center md:py-20"]}>
      <div class="mx-auto flex max-w-3xl flex-col items-center">
        <h2 class="font-heading text-3xl font-medium leading-tight text-yp-black md:text-4xl md:leading-10">Spune-ne ce echipă ai de echipat</h2>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-yp-black/80">
          Nu trebuie să știi dinainte ce produse îți trebuie. Ne spui activitatea și câți oameni ai, iar noi venim cu o
          propunere. Fără obligații.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/programeaza-discutie/" class="inline-flex h-12 items-center justify-center rounded-lg bg-yp-black px-6 text-sm font-medium text-white transition-colors hover:bg-yp-gray">
            {CTA_DISCUSS}
          </a>
          <a href="/cere-oferta/" class="inline-flex h-12 items-center justify-center rounded-lg border border-yp-black/40 px-6 text-sm font-medium text-yp-black transition-colors hover:border-yp-black">
            Cere ofertă
          </a>
        </div>
        <p class="mt-6 text-sm text-yp-black/70">
          Sau sună-ne la <a href={`tel:${SITE.telephone}`} class="font-medium underline underline-offset-4">0742 226 127</a>, de luni până vineri, 09:00–17:00.
        </p>
      </div>
    </div>
  </section>

  <section aria-labelledby="intrebari">
    <div class="mx-auto max-w-3xl px-4 py-14 md:py-24">
      <h2 id="intrebari" class:list={[sectionHeading, "mb-10"]}>Întrebări frecvente despre echipamentele de protecție și hainele de lucru</h2>
      <FaqList items={faq} />
    </div>
  </section>
</BaseLayout>
