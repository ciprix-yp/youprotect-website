---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';

// Mock featured products (TODO: Replace cu date reale din Baserow/n8n)
const featuredProducts = [
  {
    id: 1,
    nume: "Jachetă Softshell Pro",
    slug: "jacheta-softshell-pro",
    categorie: "Îmbrăcăminte de Lucru",
    descriereScurta: "Rezistentă la apă și vânt, perfectă pentru șantiere în orice anotimp.",
    imaginePrincipala: "/images/jacheta-placeholder.jpg",
    tipProdus: ["Jachete", "High-Vis"],
    featured: true
  },
  {
    id: 2,
    nume: "Bocanci S3 Safety",
    slug: "bocanci-s3-safety",
    categorie: "Încălțăminte de Protecție",
    descriereScurta: "Protecție completă cu bombeu metalic și talpă anti-perforație.",
    imaginePrincipala: "/images/bocanci-placeholder.jpg",
    tipProdus: ["Bocanci", "S3"],
    featured: true
  },
  {
    id: 3,
    nume: "Vestă High-Visibility",
    slug: "vesta-high-visibility",
    categorie: "Echipamente & Accesorii",
    descriereScurta: "Vizibilitate maximă conform EN ISO 20471, personalizabilă cu logo.",
    imaginePrincipala: "/images/vesta-placeholder.jpg",
    tipProdus: ["Veste", "High-Vis"],
    featured: true
  },
  {
    id: 4,
    nume: "Mănuși Mecanice Pro",
    slug: "manusi-mecanice-pro",
    categorie: "Echipamente & Accesorii",
    descriereScurta: "Protecție mecanică nivel 4, grip excelent, rezistente la uzură.",
    imaginePrincipala: "/images/manusi-placeholder.jpg",
    tipProdus: ["Mănuși", "Protecție Mecanică"],
    featured: true
  }
];
---

<BaseLayout title="You Protect - Echipamente de Protecție și Uniforme Personalizate">
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center bg-yp-black">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
      <img 
        src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?q=80&w=2000" 
        alt="Echipă de construcții" 
        class="w-full h-full object-cover opacity-40"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-yp-black/70 via-yp-black/80 to-yp-black"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-6xl mx-auto px-4 py-20 text-center">
      <h1 class="text-5xl md:text-7xl font-heading mb-6 leading-tight">
        [COMPLETEAZĂ: Headline Principal]<br/>
        <span class="text-yp-yellow">[COMPLETEAZĂ: Emphasis]</span>
      </h1>
      <p class="text-xl md:text-2xl text-yp-white/80 mb-12 max-w-3xl mx-auto">
        [COMPLETEAZĂ: Subheadline - beneficiul principal pentru client]
      </p>
      
      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <button class="bg-yp-yellow text-yp-black font-heading font-bold px-8 py-4 rounded-lg text-lg hover:bg-yp-yellow/90 hover:shadow-lg hover:-translate-y-0.5 transition-all">
          Cere Ofertă Personalizată
        </button>
        <a 
          href="#featured-products"
          class="border-2 border-yp-green text-yp-green font-heading font-bold px-6 py-3 rounded-lg text-lg bg-transparent hover:bg-yp-green hover:text-yp-white transition-all"
        >
          Vezi Produsele
        </a>
      </div>
    </div>
  </section>

  <!-- Problem Section (Pain Points) -->
  <section class="py-20 bg-yp-gray relative overflow-hidden">
    <!-- Pattern Overlay (Optional) -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0" style="background-image: repeating-linear-gradient(45deg, transparent, transparent 35px, rgba(227, 252, 2, 0.1) 35px, rgba(227, 252, 2, 0.1) 70px);"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 relative z-10">
      <h2 class="text-4xl md:text-5xl font-heading mb-4 text-center">
        [COMPLETEAZĂ: Titlu Probleme]
      </h2>
      <p class="text-xl text-yp-white/70 text-center mb-16 max-w-3xl mx-auto">
        [COMPLETEAZĂ: Subtitle probleme comune]
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Pain Point 1 -->
        <div class="bg-yp-black p-8 rounded-xl">
          <div class="text-5xl mb-4">⚠️</div>
          <h3 class="text-2xl font-heading mb-4 text-yp-yellow">
            [COMPLETEAZĂ: Problemă 1]
          </h3>
          <p class="text-yp-white/80">
            [COMPLETEAZĂ: Descriere problemă 1 - ex: Achiziții dezorganizate, pierdere de timp]
          </p>
        </div>

        <!-- Pain Point 2 -->
        <div class="bg-yp-black p-8 rounded-xl">
          <div class="text-5xl mb-4">💸</div>
          <h3 class="text-2xl font-heading mb-4 text-yp-yellow">
            [COMPLETEAZĂ: Problemă 2]
          </h3>
          <p class="text-yp-white/80">
            [COMPLETEAZĂ: Descriere problemă 2 - ex: Costuri ascunse, înlocuiri frecvente]
          </p>
        </div>

        <!-- Pain Point 3 -->
        <div class="bg-yp-black p-8 rounded-xl">
          <div class="text-5xl mb-4">⏱️</div>
          <h3 class="text-2xl font-heading mb-4 text-yp-yellow">
            [COMPLETEAZĂ: Problemă 3]
          </h3>
          <p class="text-yp-white/80">
            [COMPLETEAZĂ: Descriere problemă 3 - ex: Imagine neprofesională, echipamente neuniforme]
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution Section (Beneficii) -->
  <section class="py-20 bg-yp-black">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading mb-16 text-center">
        [COMPLETEAZĂ: Titlu Soluții]
      </h2>

      <!-- Benefit 1 (Image Left, Text Right) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mb-20">
        <div class="order-2 md:order-1">
          <div class="bg-yp-gray/30 aspect-video rounded-xl flex items-center justify-center">
            <span class="text-yp-white/50">[Imagine: Achiziții organizate]</span>
          </div>
        </div>
        <div class="order-1 md:order-2">
          <div class="text-5xl mb-4">✓</div>
          <h3 class="text-3xl font-heading mb-6 text-yp-yellow">
            [COMPLETEAZĂ: Beneficiu 1 - ex: Achiziții Organizate]
          </h3>
          <p class="text-yp-white/80 text-lg leading-relaxed mb-4">
            [COMPLETEAZĂ: Descriere beneficiu 1]
          </p>
          <ul class="space-y-2 text-yp-white/70">
            <li class="flex items-start">
              <span class="text-yp-yellow mr-2">•</span>
              <span>[COMPLETEAZĂ: Sub-beneficiu 1]</span>
            </li>
            <li class="flex items-start">
              <span class="text-yp-yellow mr-2">•</span>
              <span>[COMPLETEAZĂ: Sub-beneficiu 2]</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Benefit 2 (Image Right, Text Left) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="text-5xl mb-4">✨</div>
          <h3 class="text-3xl font-heading mb-6 text-yp-yellow">
            [COMPLETEAZĂ: Beneficiu 2 - ex: Imagine Impecabilă]
          </h3>
          <p class="text-yp-white/80 text-lg leading-relaxed mb-4">
            [COMPLETEAZĂ: Descriere beneficiu 2]
          </p>
          <ul class="space-y-2 text-yp-white/70">
            <li class="flex items-start">
              <span class="text-yp-yellow mr-2">•</span>
              <span>[COMPLETEAZĂ: Sub-beneficiu 1]</span>
            </li>
            <li class="flex items-start">
              <span class="text-yp-yellow mr-2">•</span>
              <span>[COMPLETEAZĂ: Sub-beneficiu 2]</span>
            </li>
          </ul>
        </div>
        <div>
          <div class="bg-yp-gray/30 aspect-video rounded-xl flex items-center justify-center">
            <span class="text-yp-white/50">[Imagine: Echipă uniformă pe șantier]</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section id="featured-products" class="py-20 bg-yp-gray">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-heading mb-4">
          Produse Recomandate
        </h2>
        <p class="text-xl text-yp-white/70">
          Echipamente de calitate superioară, testate în condiții reale
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        {featuredProducts.map(product => (
          <ProductCard {...product} />
        ))}
      </div>

      <div class="text-center">
        <a 
          href="/produse" 
          class="inline-block text-yp-yellow font-heading text-lg hover:underline"
        >
          Vezi tot catalogul →
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Indicators -->
  <section class="py-20 bg-yp-black">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
        <!-- Stat 1 -->
        <div>
          <div class="text-5xl md:text-6xl font-heading text-yp-yellow mb-4">
            [COMPLETEAZĂ: Număr]
          </div>
          <p class="text-xl text-yp-white/80">
            [COMPLETEAZĂ: Metrica - ex: Ani de experiență]
          </p>
        </div>

        <!-- Stat 2 -->
        <div>
          <div class="text-5xl md:text-6xl font-heading text-yp-yellow mb-4">
            [COMPLETEAZĂ: Număr]
          </div>
          <p class="text-xl text-yp-white/80">
            [COMPLETEAZĂ: Metrica - ex: Clienți activi]
          </p>
        </div>

        <!-- Stat 3 -->
        <div>
          <div class="text-5xl md:text-6xl font-heading text-yp-yellow mb-4">
            [COMPLETEAZĂ: Număr]
          </div>
          <p class="text-xl text-yp-white/80">
            [COMPLETEAZĂ: Metrica - ex: Produse livrate]
          </p>
        </div>
      </div>

      <!-- Optional: Certifications -->
      <div class="mt-16 text-center">
        <p class="text-yp-white/50 mb-6">Certificări și Standarde</p>
        <div class="flex flex-wrap justify-center gap-8 items-center">
          <div class="bg-yp-gray/30 px-8 py-4 rounded-lg">
            <span class="text-yp-white/50">[Logo Certificare 1]</span>
          </div>
          <div class="bg-yp-gray/30 px-8 py-4 rounded-lg">
            <span class="text-yp-white/50">[Logo Certificare 2]</span>
          </div>
          <div class="bg-yp-gray/30 px-8 py-4 rounded-lg">
            <span class="text-yp-white/50">[Logo Certificare 3]</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-20 bg-yp-gray">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading mb-16 text-center">
        Ce Spun Clienții Noștri
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Testimonial 1 -->
        <div class="bg-yp-black p-8 rounded-xl">
          <div class="flex mb-4">
            {[...Array(5)].map((_, i) => (
              <span key={i} class="text-yp-yellow text-2xl">★</span>
            ))}
          </div>
          <p class="text-yp-white/80 font-accent italic text-lg mb-6 leading-relaxed">
            "[COMPLETEAZĂ: Testimonial 1 - feedback autentic de la client]"
          </p>
          <div class="border-t border-yp-gray pt-4">
            <p class="text-yp-yellow font-heading">
              [COMPLETEAZĂ: Nume Client]
            </p>
            <p class="text-yp-white/60 text-sm">
              [COMPLETEAZĂ: Funcție, Companie]
            </p>
          </div>
        </div>

        <!-- Testimonial 2 -->
        <div class="bg-yp-black p-8 rounded-xl">
          <div class="flex mb-4">
            {[...Array(5)].map((_, i) => (
              <span key={i} class="text-yp-yellow text-2xl">★</span>
            ))}
          </div>
          <p class="text-yp-white/80 font-accent italic text-lg mb-6 leading-relaxed">
            "[COMPLETEAZĂ: Testimonial 2]"
          </p>
          <div class="border-t border-yp-gray pt-4">
            <p class="text-yp-yellow font-heading">
              [COMPLETEAZĂ: Nume Client]
            </p>
            <p class="text-yp-white/60 text-sm">
              [COMPLETEAZĂ: Funcție, Companie]
            </p>
          </div>
        </div>

        <!-- Testimonial 3 -->
        <div class="bg-yp-black p-8 rounded-xl">
          <div class="flex mb-4">
            {[...Array(5)].map((_, i) => (
              <span key={i} class="text-yp-yellow text-2xl">★</span>
            ))}
          </div>
          <p class="text-yp-white/80 font-accent italic text-lg mb-6 leading-relaxed">
            "[COMPLETEAZĂ: Testimonial 3]"
          </p>
          <div class="border-t border-yp-gray pt-4">
            <p class="text-yp-yellow font-heading">
              [COMPLETEAZĂ: Nume Client]
            </p>
            <p class="text-yp-white/60 text-sm">
              [COMPLETEAZĂ: Funcție, Companie]
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-20 bg-yp-yellow">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-4xl md:text-5xl font-heading text-yp-black mb-6">
        [COMPLETEAZĂ: CTA Final - ex: Hai Să Începem]
      </h2>
      <p class="text-xl text-yp-black/80 mb-8">
        [COMPLETEAZĂ: CTA Description - beneficiul apelului]
      </p>
      <button class="bg-yp-black text-yp-yellow font-heading font-bold px-8 py-4 rounded-lg text-lg hover:bg-yp-black/90 hover:shadow-xl transition-all">
        Cere Ofertă Personalizată
      </button>
      <p class="text-sm text-yp-black/60 mt-4">
        Consultanță gratuită. Răspundem în 24 de ore.
      </p>
    </div>
  </section>
</BaseLayout>
