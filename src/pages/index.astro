---
// Homepage, restructurat pe 20.11.2026 (D-2026-11-20-05): ce vinzi și de ce să alegi You Protect, cu fapte, nu cu
// abstracțiuni. Ordinea: hero, mărci, recenzii, categorii, „De ce You Protect”, pași, ce include, CTA, întrebări.
import BaseLayout from "../layouts/BaseLayout.astro";
import Testimonials from "../components/home/Testimonials.astro";
import RiskFreeTesting from "../components/global/RiskFreeTesting.astro";
import CategoryTiles from "../components/products/CategoryTiles.astro";
import { getCollection } from "astro:content";
import { modelsLabel } from "../lib/catalog-categories";
import { publishedTestimonials as testimonials } from "../lib/testimonials";
import { RISK_FREE_TESTING, SITE } from "../lib/site";
import { btnPrimary, btnSecondary, pageContainer } from "../lib/ui";
import { jsonLd } from "../lib/json-ld";

const publishedCount = (await getCollection("products", ({ data }) => data.status === "published")).length;
const models = modelsLabel(publishedCount);

const sectionHeading = "font-heading text-3xl font-light leading-tight text-white lg:text-4xl";
const textLink = "inline-flex min-h-11 items-center text-sm font-medium text-yp-yellow underline underline-offset-4 hover:text-white";

const brands = [
  { name: "MASCOT", logo: "/logos/logo-1.webp", href: "/produse/mascot/" },
  { name: "Sir Safety", logo: "/logos/logo-2.webp", href: "/produse/sir-safety/" },
  { name: "Portwest", logo: "/logos/logo-3.webp", href: "/produse/portwest/" },
  { name: "Malfini", logo: "/logos/logo-4.webp" },
];

// Patru fapte, fiecare cu pagina care îl dovedește.
const reasons = [
  {
    title: "Alegi după costul real",
    text: "Prețul de pe factură e doar o parte. Calculatorul compară cât te costă pe zi de purtare ce folosești acum și produsele care durează mai mult.",
    link: { label: "Calculează costul real", href: "/calculator-cost-echipamente/" },
  },
  {
    title: "Testezi 90 de zile, fără riscuri",
    text: RISK_FREE_TESTING.short,
    link: { label: RISK_FREE_TESTING.linkLabel, href: RISK_FREE_TESTING.href },
  },
  {
    title: "Vezi și probezi înainte",
    text: "În showroom-ul din Vetiș, Satu Mare, ai cabină de probă. Pe fiecare fișă din catalog găsești documentele producătorului și, unde există, standardele declarate de el.",
    link: { label: "Vezi showroom-ul", href: "/echipamente-protectie-satu-mare/#showroom" },
  },
  {
    title: "Logo-ul firmei, livrat în toată țara",
    text: "Hainele de lucru le poți personaliza cu logo prin broderie, serigrafie sau transfer termic. Livrăm în toată România.",
    link: { label: "Cum funcționează personalizarea", href: "/haine-de-lucru-personalizate/" },
  },
];

const steps = [
  {
    title: "Discutăm despre activitatea și echipa ta",
    text: "Începem cu o discuție despre contextul real: ce face echipa, în ce condiții lucrează și ce vrei să îmbunătățești în procesul de echipare.",
  },
  {
    title: "Primești o recomandare și o ofertă",
    text: "Selectăm variante potrivite de echipamente de protecție și haine de lucru și construim o propunere adaptată activității, bugetului și imaginii pe care vrei să o transmiți.",
  },
  {
    title: "Testezi și alegi informat",
    text: "Poți testa produsele cu o parte din echipă, compara și decide, astfel încât alegerea finală să fie potrivită și pentru oameni, și pentru firmă.",
  },
];

const includes = [
  "Consultanță pentru alegerea echipamentelor potrivite",
  "Selecție clară pentru activitatea și echipa ta",
  "Livrări programate, pentru mai multă predictibilitate",
  "Personalizare cu logo prin broderie, serigrafie sau transfer termic",
  "Fișe de produs cu documentele producătorului și certificările declarate de el",
  "Testare de 90 de zile înainte de decizia finală, cu banii înapoi pe rolurile unde produsele nu ies mai eficiente și nu ești mulțumit",
  "Sprijin pentru comenzi recurente sau anuale",
  "Showroom cu cabină de probă în Vetiș, Satu Mare",
];

// Întrebările frecvente: aceeași listă pentru pagină și pentru FAQPage (JSON-LD).
const faq = [
  {
    q: "Ce echipamente de protecție sunt obligatorii pentru angajatori în România?",
    a: "Depinde de riscurile de la locul de muncă și de activitate. Angajatorul trebuie să asigure echipamente individuale de protecție adecvate riscurilor identificate, conforme și potrivite pentru utilizarea reală din teren. De aceea, alegerea nu se face generic, ci în funcție de activitate, mediu de lucru și nevoile echipei.",
  },
  {
    q: "Cum aleg corect hainele de lucru pentru echipa mea?",
    a: "Pornești de la activitate, sezon, nivelul de uzură, confort, imaginea pe care vrei să o transmită echipa și nevoia de personalizare. Pentru multe firme, o recomandare clară e mai utilă decât o listă lungă de produse.",
  },
  {
    q: "Care este diferența dintre S1P și S3 la bocancii de protecție?",
    a: "Și S1P, și S3 au bombeu de protecție, călcâi închis, proprietăți antistatice, absorbție de energie la călcâi și protecție la perforare. S3 adaugă două lucruri: fața încălțămintei rezistă la pătrunderea și absorbția apei, iar talpa are crampoane. Dacă oamenii tăi lucrează afară, pe teren denivelat sau pe ude, ai nevoie de ce adaugă S3.",
    more: { label: "Ghidul S1P sau S3", href: "/ghiduri/s1p-sau-s3/" },
  },
  {
    q: "Pot testa produsele înainte să echipez toată firma?",
    a: `Da, prin programul „Testare fără riscuri”. ${RISK_FREE_TESTING.text}`,
    more: { label: RISK_FREE_TESTING.linkLabel, href: RISK_FREE_TESTING.href },
  },
  {
    q: "Aveți showroom unde pot proba produsele?",
    a: "Da. Showroom-ul You Protect e în Vetiș, pe Strada Careiului nr. 45, în Parc Industrial Areli, județul Satu Mare, și are cabină de probă. Programul e de luni până vineri, între 09:00 și 17:00.",
    more: { label: "Adresa și harta", href: "/echipamente-protectie-satu-mare/#showroom" },
  },
  {
    q: "Livrați echipamente de protecție în toată România?",
    a: "Da. You Protect livrează echipamente de protecție, haine de lucru și articole personalizate firmelor din toată România. Avem baza în Satu Mare și lucrăm des cu firme din nord-vestul țării. În funcție de proiect și de volum, colaborarea poate include consultanță, selecție de produse, personalizare și planificarea comenzilor recurente.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<BaseLayout
  title="Echipamente de protecție și haine de lucru"
  description="Echipamente de protecție și haine de lucru pentru firme, personalizate cu logo. Showroom cu cabină de probă în Vetiș, Satu Mare, livrare în toată România."
>
  <script type="application/ld+json" set:html={jsonLd(faqSchema)} />

  <!-- Butonul fix de pe telefon: dispare la derulare în jos, revine la derulare în sus. -->
  <div
    id="mobile-sticky-catalog"
    class="md:hidden fixed z-[999] left-1/2 top-24 transition duration-300 ease-out"
    style="transform: translate(-50%, -12px); opacity: 0; visibility: hidden"
  >
    <a
      href="/programeaza-discutie/"
      class="flex min-h-[44px] items-center justify-center whitespace-nowrap rounded-full border border-yp-black/10 bg-yp-yellow px-5 py-2.5 text-sm font-medium text-yp-black shadow-lg"
    >
      Programează o discuție
    </a>
  </div>

  <script>
    // Apare doar după hero (unde butoanele sunt deja vizibile) și doar la derularea în sus.
    let lastScrollY = window.scrollY;
    const stickyBtn = document.getElementById("mobile-sticky-catalog");
    const hero = document.getElementById("hero");
    window.addEventListener(
      "scroll",
      () => {
        if (!stickyBtn) return;
        const y = window.scrollY;
        const pastHero = y > (hero?.offsetHeight ?? 600);
        const show = pastHero && y < lastScrollY;
        stickyBtn.style.transform = show ? "translate(-50%, 0)" : "translate(-50%, -12px)";
        stickyBtn.style.opacity = show ? "1" : "0";
        stickyBtn.style.visibility = show ? "visible" : "hidden";
        lastScrollY = y;
      },
      { passive: true },
    );
  </script>

  <section id="hero" class="relative overflow-hidden border-b border-white/5">
    <div class="absolute inset-0">
      <img
        src="/hero-youprotect-highvis.webp"
        alt="Echipamente de protecție și haine de lucru You Protect, Satu Mare"
        class="h-full w-full object-cover object-[85%_center] opacity-80 md:object-[70%_center]"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-yp-black via-yp-black/70 to-yp-black/30"></div>
    </div>

    <div class:list={[pageContainer, "relative pb-14 pt-12 md:py-24 lg:py-28"]}>
      <div class="max-w-3xl">
        <h1 class="font-heading text-[2rem] font-light leading-[1.12] tracking-tight text-white sm:text-4xl md:text-5xl xl:text-6xl">
          Echipamente de protecție și haine de lucru alese după costul real, nu după preț
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-yp-white/80 sm:text-lg">
          {models} de la MASCOT, Portwest, Sir Safety și alte mărci, pe care le poți personaliza cu logo-ul firmei și le
          livrăm în toată România. Le vezi și le probezi în showroom-ul nostru din Vetiș, Satu Mare.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/programeaza-discutie/" class={btnPrimary}>Programează o discuție</a>
          <a href="/cere-oferta/" class={btnSecondary}>Cere ofertă</a>
        </div>
        <div class="mt-3 flex flex-wrap gap-x-6">
          <a href="/produse/" class={textLink}>Vezi catalogul</a>
          <a href="/calculator-cost-echipamente/" class={textLink}>Calculează cât te costă de fapt echipamentele</a>
        </div>
        <div class="mt-6 max-w-2xl border-t border-white/10 pt-6">
          <RiskFreeTesting variant="inline" />
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-white/5" aria-labelledby="marci">
    <div class:list={[pageContainer, "py-12"]}>
      <h2 id="marci" class="mb-8 text-center text-sm text-yp-white/60">Mărci cu care lucrăm</h2>
      <ul class="grid grid-cols-4 items-center justify-items-center gap-2 sm:gap-10">
        {brands.map((b) => (
          <li class="w-full max-w-[96px] sm:max-w-[200px] md:max-w-[240px]">
            {b.href ? (
              <a href={b.href} class="group flex min-h-11 items-center justify-center rounded-xl border border-transparent p-1 transition-colors hover:border-yp-yellow/40 sm:p-4 md:p-6">
                <img src={b.logo} alt={`Produse ${b.name}`} class="h-14 w-auto rounded-md object-contain sm:h-16 md:h-24 md:opacity-70 md:grayscale md:transition md:group-hover:opacity-100 md:group-hover:grayscale-0" loading="lazy" />
              </a>
            ) : (
              <div class="flex items-center justify-center p-1 sm:p-4 md:p-6">
                <img src={b.logo} alt={b.name} class="h-14 w-auto rounded-md object-contain sm:h-16 md:h-24 md:opacity-70 md:grayscale" loading="lazy" />
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {
    testimonials.length > 0 && (
      <section class="border-b border-white/5 bg-[#0a0a0a]" aria-labelledby="recenzii">
        <div class:list={[pageContainer, "py-14 md:py-24"]}>
          <h2 id="recenzii" class:list={[sectionHeading, "mb-12 text-center"]}>Ce spun clienții noștri</h2>
          <Testimonials testimonials={testimonials} />
        </div>
      </section>
    )
  }

  <section class="border-b border-white/5" aria-labelledby="categorii">
    <div class:list={[pageContainer, "py-12 md:py-20"]}>
      <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <h2 id="categorii" class:list={[sectionHeading, "max-w-3xl"]}>
          Echipamente de protecție și haine de lucru pentru echipe tehnice
        </h2>
        <a href="/produse/" class:list={[textLink, "shrink-0"]}>Vezi tot catalogul</a>
      </div>
      <CategoryTiles />
    </div>
  </section>

  <section class="border-b border-white/5 bg-[#0a0a0a]" aria-labelledby="de-ce">
    <div class:list={[pageContainer, "py-14 md:py-24"]}>
      <h2 id="de-ce" class:list={[sectionHeading, "max-w-3xl"]}>De ce să echipezi echipa cu You Protect</h2>
      <ul class="mt-10 grid gap-4 md:grid-cols-2">
        {reasons.map((r) => (
          <li data-tilt="4" class="card-3d relative flex flex-col rounded-xl border border-white/[0.08] bg-yp-surface p-6 shadow-card hover:border-yp-yellow/30 hover:shadow-card-hover md:p-8">
            <h3 class="font-heading text-xl font-medium text-white">{r.title}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-yp-white/75">{r.text}</p>
            <a href={r.link.href} class:list={[textLink, "relative z-10 mt-4 w-fit"]}>{r.link.label}</a>
            <span class="tilt-sheen" aria-hidden="true"></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-b border-white/5" aria-labelledby="pasi">
    <div class:list={[pageContainer, "py-14 md:py-24"]}>
      <h2 id="pasi" class:list={[sectionHeading, "max-w-3xl"]}>Cum începe colaborarea cu You Protect</h2>
      <ol class="mt-10 grid gap-8 md:grid-cols-3">
        {steps.map((s, i) => (
          <li class="border-t border-yp-yellow/60 pt-6">
            <p class="text-sm font-medium text-yp-yellow">Pasul {i + 1}</p>
            <h3 class="mt-2 font-heading text-xl font-medium text-white">{s.title}</h3>
            <p class="mt-3 leading-relaxed text-yp-white/75">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="border-b border-white/5 bg-[#0a0a0a]" aria-labelledby="include">
    <div class:list={[pageContainer, "py-14 md:py-24"]}>
      <h2 id="include" class:list={[sectionHeading, "max-w-3xl"]}>Ce include colaborarea cu You Protect</h2>
      <ul class="mt-10 grid gap-x-12 gap-y-5 md:grid-cols-2">
        {includes.map((item) => (
          <li class="flex items-start gap-3 leading-relaxed text-yp-white/85">
            <svg class="mt-1 h-5 w-5 shrink-0 text-yp-yellow" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-yp-yellow">
    <div class:list={[pageContainer, "py-16 text-center md:py-20"]}>
      <div class="mx-auto flex max-w-3xl flex-col items-center">
        <h2 class="font-heading text-3xl font-medium leading-tight text-yp-black md:text-4xl">Spune-ne ce echipă ai de echipat</h2>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-yp-black/80">
          Nu trebuie să știi dinainte ce produse îți trebuie. Ne spui activitatea și câți oameni ai, iar noi venim cu o
          propunere. Fără obligații.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/programeaza-discutie/" class="inline-flex h-12 items-center justify-center rounded-lg bg-yp-black px-6 text-sm font-medium text-white transition-colors hover:bg-yp-gray">
            Programează o discuție
          </a>
          <a href="/cere-oferta/" class="inline-flex h-12 items-center justify-center rounded-lg border border-yp-black/40 px-6 text-sm font-medium text-yp-black transition-colors hover:border-yp-black">
            Cere ofertă
          </a>
        </div>
        <p class="mt-6 text-sm text-yp-black/70">
          Sau sună-ne la <a href={`tel:${SITE.telephone}`} class="font-medium underline underline-offset-4">0742 226 127</a>, de luni până vineri, 09:00–17:00.
        </p>
      </div>
    </div>
  </section>

  <section aria-labelledby="intrebari">
    <div class="mx-auto max-w-3xl px-4 py-14 md:py-24">
      <h2 id="intrebari" class:list={[sectionHeading, "mb-10"]}>Întrebări frecvente despre echipamentele de protecție și hainele de lucru</h2>
      <div class="flex flex-col gap-3">
        {faq.map((f) => (
          <details class="group border border-white/10 bg-[#0f0f0f] p-6 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-lg font-medium text-white">
              {f.q}
              <svg class="h-6 w-6 shrink-0 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
              </svg>
            </summary>
            <div class="mt-4 border-t border-white/10 pt-4 text-sm leading-relaxed text-yp-white/75">
              <p>{f.a}</p>
              {f.more && <a href={f.more.href} class:list={[textLink, "mt-2"]}>{f.more.label}</a>}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
