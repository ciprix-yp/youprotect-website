---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadModal from '../components/forms/LeadModal';
---

<BaseLayout 
  title="Acasă - You Protect" 
  description="Echipament de protecție premium pentru companii care respectă echipa și imaginea. Consultanță gratuită în selecția pe roluri."
>

<main class="relative min-h-screen flex items-center overflow-hidden">
  
  <div class="absolute inset-0 z-0">
    <img 
      src="/hero-youprotect-highvis.jpg" 
      alt="Echipamente de Protecție You Protect" 
      class="w-full h-full object-cover object-[70%_center] opacity-70"
    >
    <div class="absolute inset-0 bg-gradient-to-r from-black via-black/90 to-black/30"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/40"></div>
    <div class="absolute inset-0 bg-blue-950/20 mix-blend-overlay"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center h-full py-32">
    <div class="lg:col-span-7 flex flex-col justify-center">
      
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/10 bg-white/5 backdrop-blur-sm w-fit mb-8">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-yp-yellow opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-yp-yellow"></span>
        </span>
        <span class="text-xs font-medium text-neutral-300 tracking-wide">Consultanță Gratuită 24/7</span>
      </div>

      <h1 class="text-5xl lg:text-[4.5rem] font-semibold tracking-tight leading-[1.05] text-white mb-6">
        Echipamentul de protecție care <span class="text-yp-yellow">respectă echipa</span> și imaginea firmei
      </h1>

      <p class="text-lg lg:text-xl text-neutral-400 font-normal leading-relaxed mb-10 max-w-xl">
        Te consiliem gratuit în selecția pe roluri, astfel <strong class="text-white font-medium">elimini disconfortul</strong>, <strong class="text-white font-medium">scazi costul real</strong> al înlocuirilor și <strong class="text-white font-medium">crești rata de purtare</strong> în teren.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 mb-16">
        <button 
          class="bg-yp-yellow text-yp-black h-12 px-8 rounded-[4px] font-medium text-sm flex items-center justify-center gap-2 hover:bg-white transition-all duration-200 group border border-transparent"
          onclick="document.getElementById('leadModal')?.classList.remove('hidden')"
        >
          Cere Consultanță Gratuită
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </button>
        
        <a 
          href="/produse"
          class="border border-white/15 text-white h-12 px-8 rounded-[4px] font-medium text-sm flex items-center justify-center gap-2 hover:bg-white/5 hover:border-white/30 transition-all duration-200"
        >
          Vezi Produsele
          <svg class="w-4 h-4 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <div class="border-t border-white/10 pt-8 w-full max-w-2xl">
        <p class="text-xs font-medium text-neutral-500 uppercase tracking-wider mb-6">
          Echipamente certificate și confortabile
        </p>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          
          <div class="group cursor-pointer bg-transparent border border-white/10 rounded-[4px] p-4 hover:border-yp-yellow/50 transition-all duration-300 h-20 flex items-center justify-center">
            <img 
              src="/logos/logo-1.png" 
              alt="Mascot" 
              class="max-h-12 w-auto object-contain opacity-60 grayscale group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-300"
              loading="lazy"
            />
          </div>

          <div class="group cursor-pointer bg-transparent border border-white/10 rounded-[4px] p-4 hover:border-yp-yellow/50 transition-all duration-300 h-20 flex items-center justify-center">
            <img 
              src="/logos/logo-2.png" 
              alt="Sir Safety" 
              class="max-h-12 w-auto object-contain opacity-60 grayscale group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-300"
              loading="lazy"
            />
          </div>

          <div class="group cursor-pointer bg-transparent border border-white/10 rounded-[4px] p-4 hover:border-yp-yellow/50 transition-all duration-300 h-20 flex items-center justify-center">
            <img 
              src="/logos/logo-3.png" 
              alt="Certificare EN" 
              class="max-h-12 w-auto object-contain opacity-60 grayscale group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-300"
              loading="lazy"
            />
          </div>

          <div class="group cursor-pointer bg-transparent border border-white/10 rounded-[4px] p-4 hover:border-yp-yellow/50 transition-all duration-300 h-20 flex items-center justify-center">
            <img 
              src="/logos/logo-4.png" 
              alt="Certificare ISO" 
              class="max-h-12 w-auto object-contain opacity-60 grayscale group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-300"
              loading="lazy"
            />
          </div>

        </div>
      </div>
    </div>

    <div class="hidden lg:block lg:col-span-5 h-full"></div>
  </div>
</main>

<LeadModal client:load />

</BaseLayout>
