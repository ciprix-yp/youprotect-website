---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/products/ProductCard.astro';
import { getCatalogProducts } from '../../lib/catalog';

const { products, mode, warning } = await getCatalogProducts();

const categoryCountMap = new Map<string, number>();
for (const product of products) {
  const currentCount = categoryCountMap.get(product.categoryName) ?? 0;
  categoryCountMap.set(product.categoryName, currentCount + 1);
}

const categorySummary = [...categoryCountMap.entries()]
  .map(([name, count]) => ({ name, count }))
  .sort((left, right) => left.name.localeCompare(right.name, 'ro-RO'));

const featuredProducts = products.filter((product) => product.featured);
const regularProducts = products.filter((product) => !product.featured);

const hasProducts = products.length > 0;
---

<BaseLayout
  title="Produse"
  description="Catalog You Protect conectat la baza de date: echipamente de protectie, detalii tehnice si testare fara risc pentru echipa."
>
  <section class="relative overflow-hidden border-b border-yp-white/10 bg-yp-black">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-24 left-0 w-[440px] h-[440px] rounded-full bg-yp-yellow/10 blur-3xl"></div>
      <div class="absolute -bottom-24 right-0 w-[460px] h-[460px] rounded-full bg-cyan-400/10 blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 py-16 md:py-20">
      <p class="text-xs uppercase tracking-[0.2em] text-yp-yellow/80">Catalog showroom</p>
      <h1 class="mt-3 text-4xl md:text-5xl text-yp-white max-w-3xl leading-tight">
        Produse selectate pentru companii care trateaza siguranta ca standard
      </h1>
      <p class="mt-6 text-yp-white/70 max-w-2xl leading-relaxed">
        Catalogul nu este ecommerce. Alegi ce vrei sa testezi, definim impreuna setul potrivit pentru echipa ta, iar apoi decizi informat.
      </p>

      <div class="mt-8 flex flex-wrap gap-3 text-sm">
        <span class="px-3 py-1.5 rounded-full border border-yp-white/20 text-yp-white/70">
          {products.length} produse in catalog
        </span>
        <span class="px-3 py-1.5 rounded-full border border-yp-white/20 text-yp-white/70">
          max 12 produse in selectie
        </span>
        <button
          type="button"
          id="catalog-open-modal-top"
          class="px-3 py-1.5 rounded-full bg-yp-yellow text-yp-black font-semibold hover:bg-yp-white transition-colors"
        >
          Vreau sa testez
        </button>
        <button
          type="button"
          id="catalog-open-booking-top"
          class="px-3 py-1.5 rounded-full border border-yp-yellow/40 text-yp-yellow hover:border-yp-white/40 hover:text-yp-white transition-colors"
        >
          Book a call
        </button>
      </div>

      <div class="mt-6 rounded-xl border border-yp-white/15 bg-yp-gray/30 p-4 max-w-3xl">
        <p class="text-sm text-yp-white/80 leading-relaxed">
          Testare fara risc: echipam 3-5 membri ai echipei tale, cadem de acord pe produsele testate, platesti produsele, iar ai 90 de zile garantie money-back daca nu esti multumit.
        </p>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-10 md:py-14">
    {mode === 'degraded' && (
      <div class="mb-8 rounded-lg border border-amber-400/30 bg-amber-400/10 px-4 py-3 text-sm text-amber-100">
        Catalogul nu a putut fi incarcat din DB in acest build. Motiv: {warning ?? 'necunoscut'}
      </div>
    )}

    {hasProducts && (
      <div id="shortlist-summary" class="mb-8 rounded-xl border border-yp-white/15 bg-yp-gray/30 p-5">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <div>
            <p class="text-sm uppercase tracking-wide text-yp-yellow/80">Selectia pentru testare</p>
            <p id="shortlist-count" class="text-yp-white text-lg mt-1">0 produse selectate</p>
          </div>

          <div class="flex flex-wrap gap-2">
            <button
              type="button"
              id="shortlist-open-modal"
              class="px-4 py-2 rounded-md bg-yp-yellow text-yp-black font-semibold hover:bg-yp-white transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Continua cu testarea
            </button>
            <button
              type="button"
              id="shortlist-clear"
              class="px-4 py-2 rounded-md border border-yp-white/30 text-yp-white hover:border-yp-yellow/40 hover:text-yp-yellow transition-colors"
            >
              Goleste selectia
            </button>
          </div>
        </div>

        <div id="shortlist-chip-list" class="mt-4 flex flex-wrap gap-2"></div>
        <p id="shortlist-warning" class="mt-3 text-sm text-amber-200 hidden"></p>
      </div>
    )}

    {hasProducts && categorySummary.length > 0 && (
      <div class="mb-10">
        <h2 class="text-lg text-yp-white mb-3">Categorii disponibile</h2>
        <div class="flex flex-wrap gap-2">
          {categorySummary.map((category) => (
            <span class="px-3 py-1.5 rounded-full text-xs border border-yp-white/20 text-yp-white/70">
              {category.name} ({category.count})
            </span>
          ))}
        </div>
      </div>
    )}

    {!hasProducts ? (
      <div class="rounded-xl border border-yp-white/15 bg-yp-gray/30 p-8 text-center">
        <h2 class="text-2xl text-yp-white">Catalog in curs de sincronizare</h2>
        <p class="mt-3 text-yp-white/70 max-w-xl mx-auto">
          Nu avem inca produse publicate in feed-ul `vw_catalog_products`. Dupa ce datele sunt disponibile, paginile se regenereaza la urmatorul deploy.
        </p>
      </div>
    ) : (
      <>
        {featuredProducts.length > 0 && (
          <div class="mb-12">
            <h2 class="text-2xl text-yp-white mb-5">Produse recomandate</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
              {featuredProducts.map((product) => (
                <ProductCard
                  id={product.id}
                  slug={product.slug}
                  name={product.name}
                  categoryName={product.categoryName}
                  shortDescription={product.shortDescription}
                  producatorName={product.producatorName}
                  featured={product.featured}
                />
              ))}
            </div>
          </div>
        )}

        {regularProducts.length > 0 && (
          <div>
            <h2 class="text-2xl text-yp-white mb-5">Toate produsele</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
              {regularProducts.map((product) => (
                <ProductCard
                  id={product.id}
                  slug={product.slug}
                  name={product.name}
                  categoryName={product.categoryName}
                  shortDescription={product.shortDescription}
                  producatorName={product.producatorName}
                  featured={product.featured}
                />
              ))}
            </div>
          </div>
        )}
      </>
    )}
  </section>

  <script is:inline>
    (() => {
      const shortlist = window.YouProtectShortlist;
      if (!shortlist) return;

      const warningEl = document.getElementById('shortlist-warning');
      const countEl = document.getElementById('shortlist-count');
      const chipListEl = document.getElementById('shortlist-chip-list');
      const openModalBtn = document.getElementById('shortlist-open-modal');
      const clearBtn = document.getElementById('shortlist-clear');
      const openModalTopBtn = document.getElementById('catalog-open-modal-top');
      const openBookingTopBtn = document.getElementById('catalog-open-booking-top');
      const toggleButtons = Array.from(document.querySelectorAll('[data-shortlist-toggle]'));

      const showWarning = (message) => {
        if (!warningEl) return;
        warningEl.textContent = message;
        warningEl.classList.remove('hidden');
      };

      const clearWarning = () => {
        if (!warningEl) return;
        warningEl.textContent = '';
        warningEl.classList.add('hidden');
      };

      const productFromButton = (button) => ({
        id: button.getAttribute('data-product-id') || '',
        name: button.getAttribute('data-product-name') || '',
        slug: button.getAttribute('data-product-slug') || '',
        categoryName: button.getAttribute('data-product-category') || '',
      });

      const refreshButtons = () => {
        toggleButtons.forEach((button) => {
          const productId = button.getAttribute('data-product-id') || '';
          const selected = shortlist.isSelected(productId);
          button.textContent = selected ? 'In selectie' : 'Adauga in selectie';
          button.classList.toggle('bg-yp-yellow', !selected);
          button.classList.toggle('text-yp-black', !selected);
          button.classList.toggle('hover:bg-yp-white', !selected);
          button.classList.toggle('bg-transparent', selected);
          button.classList.toggle('text-yp-white', selected);
          button.classList.toggle('border', selected);
          button.classList.toggle('border-yp-yellow/40', selected);
          button.classList.toggle('hover:border-yp-white/60', selected);
        });
      };

      const refreshSummary = () => {
        const items = shortlist.getItems();
        const label = items.length === 1 ? 'produs selectat' : 'produse selectate';

        if (countEl) {
          countEl.textContent = `${items.length} ${label}`;
        }

        if (chipListEl) {
          chipListEl.innerHTML = '';

          if (items.length === 0) {
            const emptyMessage = document.createElement('span');
            emptyMessage.className = 'text-sm text-yp-white/60';
            emptyMessage.textContent =
              'Selecteaza produse din catalog pentru a porni formularul de testare.';
            chipListEl.appendChild(emptyMessage);
          } else {
            items.forEach((item) => {
              const chip = document.createElement('span');
              chip.className =
                'inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs border border-yp-white/20 text-yp-white/80';
              chip.textContent = item.name;
              chipListEl.appendChild(chip);
            });
          }
        }

        if (openModalBtn) {
          openModalBtn.disabled = items.length === 0;
        }
      };

      const openSamplesFlow = (source) => {
        const items = shortlist.getItems();
        if (items.length === 0) {
          showWarning('Selecteaza cel putin un produs pentru testare.');
          return;
        }
        clearWarning();
        shortlist.openLeadModal({ intent: 'view_samples', source });
      };

      toggleButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const result = shortlist.toggle(productFromButton(button));
          if (!result.ok && result.error === 'max_reached') {
            showWarning('Ai ajuns la limita de 12 produse in selectie.');
            return;
          }
          clearWarning();
          refreshButtons();
          refreshSummary();
        });
      });

      openModalBtn?.addEventListener('click', () => openSamplesFlow('catalog_summary'));
      openModalTopBtn?.addEventListener('click', () => openSamplesFlow('catalog_top_cta'));

      openBookingTopBtn?.addEventListener('click', () => {
        clearWarning();
        shortlist.openLeadModal({ intent: 'book_call', source: 'catalog_top_booking' });
      });

      clearBtn?.addEventListener('click', () => {
        shortlist.clear();
        clearWarning();
        refreshButtons();
        refreshSummary();
      });

      window.addEventListener('yp:shortlist-changed', () => {
        refreshButtons();
        refreshSummary();
      });

      refreshButtons();
      refreshSummary();
    })();
  </script>
</BaseLayout>
