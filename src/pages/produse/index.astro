---
// Catalogul (/produse/): antet scurt, categoriile ca dale egale, apoi grila cu filtre. Produsele publicate vin din
// src/content/products/; ordinea implicită urmează categoriile (CATEGORIES), ca modelele de același tip să stea
// împreună. Cardurile au aceeași structură peste tot (ProductCard + src/lib/product-card.ts).
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/products/ProductCard.astro';
import CategoryTiles from '../../components/products/CategoryTiles.astro';
import RiskFreeTesting from '../../components/global/RiskFreeTesting.astro';
import { CATEGORIES, INDUSTRIES, type CategoryKey } from '../../lib/catalog-taxonomy';
import { activeBrandPages } from '../../lib/catalog-brands';
import { toCardProps } from '../../lib/product-card';
import { jsonLd } from '../../lib/json-ld';
import { CTA_DISCUSS, RESPONSE_TIME } from '../../lib/site';
import { searchKey } from '../../lib/search.js';

const roCollator = new Intl.Collator('ro', { sensitivity: 'base' });
const categoryOrder = Object.keys(CATEGORIES) as CategoryKey[];
const entries = (await getCollection('products', ({ data }) => data.status === 'published')).sort(
  (a, b) =>
    categoryOrder.indexOf(a.data.category) - categoryOrder.indexOf(b.data.category) ||
    roCollator.compare(a.data.name, b.data.name),
);
const datas = entries.map((e) => e.data);
const brandPages = activeBrandPages(datas);

// Filtrul de categorie: în ordinea din taxonomie, doar categoriile cu modele publicate.
const categories = categoryOrder
  .map((key) => {
    const items = entries.filter((e) => e.data.category === key);
    if (items.length === 0) return null;
    return { key, label: CATEGORIES[key] };
  })
  .filter((c): c is NonNullable<typeof c> => c !== null);

const industries = (Object.keys(INDUSTRIES) as (keyof typeof INDUSTRIES)[])
  .map((key) => ({ key, label: INDUSTRIES[key], count: entries.filter((e) => e.data.industries.includes(key)).length }))
  .filter((i) => i.count > 0);

const brands = [...new Set(entries.map((e) => toCardProps(e).brand))]
  .map((name) => ({
    name,
    count: entries.filter((e) => toCardProps(e).brand === name).length,
    page: brandPages.find((b) => b.brand.replace('®', '') === name),
  }))
  // Mărcile cu mai multe modele primele; numărul nu se afișează (owner, 21.11.2026).
  .sort((a, b) => b.count - a.count || roCollator.compare(a.name, b.name));
// „MASCOT, Sir Safety și Climax”: mărcile cu pagină au link.
const brandParts = brands.map((b, i) => ({
  text: b.page ? b.page.name : b.name,
  href: b.page ? `/produse/${b.page.slug}/` : null,
  sep: i === brands.length - 1 ? '' : i === brands.length - 2 ? ' și ' : ', ',
}));
// Descrierea din Google numește doar mărcile cu pagină („MASCOT, Sir Safety și Portwest”), din aceleași date.
const brandPageNames = brandPages.map((b) => b.name);
const brandPagesText =
  brandPageNames.length > 1 ? `${brandPageNames.slice(0, -1).join(', ')} și ${brandPageNames.at(-1)}` : brandPageNames.join('');

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Acasă', item: siteOrigin.href },
    { '@type': 'ListItem', position: 2, name: 'Catalog', item: new URL('/produse/', siteOrigin).href },
  ],
};
const filterHeading = 'mb-3 text-sm font-medium text-yp-white';
const filterOption =
  'flex w-full items-center justify-between gap-3 py-1.5 text-left text-sm text-yp-white/70 hover:text-yp-white aria-pressed:font-medium aria-pressed:text-yp-yellow';
---

<BaseLayout
  title="Catalog echipamente de protecție și haine de lucru"
  description={`Catalog echipamente de protecție și haine de lucru ${brandPagesText}, de la bocanci la geci reflectorizante. Oferta vine ${RESPONSE_TIME}.`}
>
  <script type="application/ld+json" set:html={jsonLd(breadcrumbSchema)} />

  <section class="border-b border-yp-white/10">
    <div class="mx-auto max-w-7xl px-4 py-8 md:py-12">
      <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center text-sm text-yp-white/60">
        <a href="/" class="inline-flex min-h-11 items-center hover:text-yp-yellow">Acasă</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-yp-white">Catalog</span>
      </nav>
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
        <div>
          <h1 class="max-w-3xl font-heading text-3xl font-light leading-tight text-yp-white md:text-4xl md:leading-10">
            Catalog echipamente de protecție și haine de lucru
          </h1>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-yp-white/75">
            You Protect, din Satu Mare, are în catalog modele{' '}
            {brandParts.map((part) => (<>{part.href ? <a href={part.href} class="text-yp-white underline decoration-yp-white/30 underline-offset-4 hover:text-yp-yellow">{part.text}</a> : part.text}{part.sep}</>))},
            pentru bărbații și femeile care lucrează în construcții, producție, depozite și logistică sau energie. Adaugi la
            ofertă modelele care te interesează și primești prețurile pentru cantitățile echipei tale {RESPONSE_TIME}.
          </p>
        </div>
        <div class="flex flex-col gap-4 lg:max-w-sm">
          <div class="flex flex-col gap-3 sm:flex-row">
            <a href="/cere-oferta/" class="inline-flex h-12 items-center justify-center rounded-lg bg-yp-yellow px-6 text-sm font-medium text-yp-black transition-colors hover:bg-white">
              Cere ofertă
            </a>
            <a href="/programeaza-discutie/" class="inline-flex h-12 items-center justify-center rounded-lg border border-yp-white/25 px-6 text-sm font-medium text-yp-white transition-colors hover:border-yp-yellow hover:text-yp-yellow">
              {CTA_DISCUSS}
            </a>
          </div>
          <RiskFreeTesting variant="inline" />
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="categorii" class="border-b border-yp-white/10">
    <div class="mx-auto max-w-7xl px-4 py-8 md:py-10">
      <h2 id="categorii" class="mb-4 font-heading text-lg font-medium text-yp-white">Alege după tipul de echipament</h2>
      <CategoryTiles />
    </div>
  </section>

  <section id="modele" aria-labelledby="modele-titlu" class="mx-auto max-w-7xl scroll-mt-24 px-4 py-8 md:py-12">
    <h2 id="modele-titlu" class="sr-only">Toate modelele</h2>
    <div class="flex flex-col gap-8 lg:flex-row">
      <aside class="shrink-0 lg:sticky lg:top-24 lg:h-fit lg:w-60" aria-label="Filtre">
        <button
          id="catalog-filter-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="catalog-filters"
          class="flex w-full items-center justify-between border border-yp-white/20 px-4 py-3 text-sm font-medium text-yp-white lg:hidden"
        >
          <span>Filtre <span id="catalog-filter-count" class="text-yp-yellow"></span></span>
          <svg class="h-4 w-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
        <div id="catalog-filters" class="mt-4 hidden space-y-6 lg:mt-0 lg:block">
          <div>
            <label for="catalog-search" class={filterHeading + ' block'}>Caută în catalog</label>
            <input
              type="search"
              id="catalog-search"
              placeholder="Ex.: bocanci, cască, S3"
              autocomplete="off"
              class="w-full rounded-lg border border-yp-white/25 bg-yp-gray/40 px-3 py-2.5 text-base text-yp-white placeholder:text-yp-white/50 md:text-sm focus:border-yp-yellow focus:outline-hidden"
            />
          </div>
          <div>
            <h3 class={filterHeading}>Categorie</h3>
            <div class="flex flex-col" data-filter-group="category">
              <button type="button" data-value="all" aria-pressed="true" class={filterOption}>Toate categoriile</button>
              {categories.map((c) => (
                <button type="button" data-value={c.key} aria-pressed="false" class={filterOption}>
                  <span>{c.label}</span>
                </button>
              ))}
            </div>
          </div>
          <div>
            <h3 class={filterHeading}>Industrie</h3>
            <div class="flex flex-col" data-filter-group="industry">
              <button type="button" data-value="all" aria-pressed="true" class={filterOption}>Toate industriile</button>
              {industries.map((i) => (
                <button type="button" data-value={i.key} aria-pressed="false" class={filterOption}>
                  <span>{i.label}</span>
                </button>
              ))}
            </div>
          </div>
          <div>
            <h3 class={filterHeading}>Marcă</h3>
            <div class="flex flex-col" data-filter-group="brand">
              <button type="button" data-value="all" aria-pressed="true" class={filterOption}>Toate mărcile</button>
              {brands.map((b) => (
                <button type="button" data-value={b.name} aria-pressed="false" class={filterOption}>
                  <span>{b.name}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </aside>

      <div class="min-w-0 flex-1">
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3 border-b border-yp-white/10 pb-4">
          <p id="catalog-count" class="text-sm text-yp-white/75" aria-live="polite">Toate produsele</p>
          <div class="flex items-center gap-4">
            <button id="catalog-reset" type="button" hidden class="py-2 text-sm text-yp-yellow underline underline-offset-4 hover:text-yp-white">
              Șterge filtrele
            </button>
            <label class="flex items-center gap-2 text-sm text-yp-white/75">
              Ordine
              <select id="catalog-sort" class="h-11 rounded-lg border border-yp-white/25 bg-yp-black px-2 text-base text-yp-white md:text-sm focus:border-yp-yellow focus:outline-hidden">
                <option value="category">pe categorii</option>
                <option value="az">alfabetică</option>
              </select>
            </label>
          </div>
        </div>

        <ul id="catalog-grid" class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 xl:grid-cols-4">
          {entries.map((e, index) => (
            <li
              data-catalog-item
              data-order={index}
              data-name={e.data.name.toLocaleLowerCase('ro-RO')}
              data-category={e.data.category}
              data-industries={`|${e.data.industries.join('|')}|`}
              data-brand={toCardProps(e).brand}
              data-search={searchKey(`${e.data.name} ${CATEGORIES[e.data.category]} ${e.data.supplier.brand} ${e.data.supplier.model} ${e.data.certifications.map((c) => c.code).join(' ')}`)}
            >
              <ProductCard {...toCardProps(e)} />
            </li>
          ))}
        </ul>

        <div id="catalog-empty" hidden class="border border-yp-white/10 px-6 py-16 text-center">
          <p class="text-base text-yp-white">Niciun model nu se potrivește filtrelor alese.</p>
          <p class="mx-auto mt-2 max-w-md text-sm text-yp-white/70">
            Scrie-ne ce îți trebuie și verificăm dacă putem aduce și modele care nu sunt în catalog.
          </p>
          <a href="/cere-oferta/" class="mt-6 inline-flex h-11 items-center justify-center rounded-lg bg-yp-yellow px-6 text-sm font-medium text-yp-black hover:bg-white">
            Cere ofertă
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-yp-white/10 bg-[#050505]">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center md:py-20">
      <h2 class="font-heading text-2xl font-light text-yp-white md:text-3xl">Nu trebuie să alegi singur modelul potrivit</h2>
      <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-yp-white/75">
        Spune-ne ce lucrează oamenii tăi și în ce condiții, iar noi îți propunem echipamentul de protecția muncii potrivit
        fiecărui rol. Consultanța e gratuită, iar oferta vine {RESPONSE_TIME}. Mărimile le probezi înainte de comandă, în
        <a href="/echipamente-protectie-satu-mare/#showroom" class="text-yp-white underline decoration-yp-white/30 underline-offset-4 hover:text-yp-yellow">showroom-ul din Vetiș</a>.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/cere-oferta/" class="inline-flex h-12 items-center justify-center rounded-lg bg-yp-yellow px-8 text-sm font-medium text-yp-black transition-colors hover:bg-white">
          Cere ofertă
        </a>
        <a href="/programeaza-discutie/" class="inline-flex h-12 items-center justify-center rounded-lg border border-yp-white/25 px-8 text-sm font-medium text-yp-white transition-colors hover:border-yp-yellow hover:text-yp-yellow">
          {CTA_DISCUSS}
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const grid = document.getElementById('catalog-grid');
      if (!grid) return;
      const items = Array.from(grid.querySelectorAll('[data-catalog-item]'));
      const state = { category: 'all', industry: 'all', brand: 'all', query: '', sort: 'category' };
      const groups = Array.from(document.querySelectorAll('[data-filter-group]'));
      const search = document.getElementById('catalog-search');
      const sort = document.getElementById('catalog-sort');
      const count = document.getElementById('catalog-count');
      const reset = document.getElementById('catalog-reset');
      const empty = document.getElementById('catalog-empty');
      const toggle = document.getElementById('catalog-filter-toggle');
      const panel = document.getElementById('catalog-filters');
      const activeCount = document.getElementById('catalog-filter-count');

      const params = new URLSearchParams(window.location.search);
      const fromUrl = params.get('categorie');
      if (fromUrl && document.querySelector(`[data-filter-group="category"] [data-value="${CSS.escape(fromUrl)}"]`)) {
        state.category = fromUrl;
      }

      // Aceeași cheie ca src/lib/search.js (searchKey), cu care s-a construit data-search la build.
      const searchKey = (s) =>
        String(s ?? '')
          .normalize('NFD')
          .replace(/\p{M}/gu, '')
          .toLocaleLowerCase('ro-RO')
          .replace(/[^\p{L}\p{N}]+/gu, ' ')
          .trim();

      const refresh = () => {
        const q = searchKey(state.query);
        const words = q.split(' ').filter(Boolean);
        let visible = 0;
        for (const item of items) {
          const show =
            (state.category === 'all' || item.dataset.category === state.category) &&
            (state.industry === 'all' || item.dataset.industries.includes(`|${state.industry}|`)) &&
            (state.brand === 'all' || item.dataset.brand === state.brand) &&
            words.every((word) => item.dataset.search.includes(word));
          item.hidden = !show;
          if (show) visible += 1;
        }
        const sorted = [...items].sort((a, b) =>
          state.sort === 'az'
            ? a.dataset.name.localeCompare(b.dataset.name, 'ro')
            : Number(a.dataset.order) - Number(b.dataset.order),
        );
        for (const item of sorted) grid.appendChild(item);
        for (const group of groups) {
          const key = group.dataset.filterGroup;
          for (const button of group.querySelectorAll('button')) {
            button.setAttribute('aria-pressed', String(button.dataset.value === state[key]));
          }
        }
        const active = ['category', 'industry', 'brand'].filter((k) => state[k] !== 'all').length + (q ? 1 : 0);
        // Ce arată lista acum (filtrele alese și căutarea), fără numărul de produse (owner, 21.11.2026).
        const chosen = groups
          .filter((group) => state[group.dataset.filterGroup] !== 'all')
          .map((group) => group.querySelector('[aria-pressed="true"]')?.textContent?.trim())
          .filter(Boolean);
        if (q) chosen.push(`„${state.query.trim()}”`);
        count.textContent = chosen.length ? chosen.join(', ') : 'Toate produsele';
        reset.hidden = active === 0;
        activeCount.textContent = active ? `(${active})` : '';
        empty.hidden = visible > 0;
        grid.hidden = visible === 0;
      };

      for (const group of groups) {
        group.addEventListener('click', (event) => {
          const button = event.target.closest('button');
          if (!button) return;
          state[group.dataset.filterGroup] = button.dataset.value;
          refresh();
        });
      }
      search.addEventListener('input', () => {
        state.query = search.value;
        refresh();
      });
      sort.addEventListener('change', () => {
        state.sort = sort.value;
        refresh();
      });
      reset.addEventListener('click', () => {
        Object.assign(state, { category: 'all', industry: 'all', brand: 'all', query: '' });
        search.value = '';
        refresh();
      });
      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        panel.classList.toggle('hidden', !open);
        toggle.querySelector('svg').classList.toggle('rotate-180', open);
      });
      refresh();
    })();
  </script>
</BaseLayout>
