---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/products/ProductCard.astro";
import { getCatalogProducts } from "../../lib/catalog";
import { getDirectusProducts } from "../../lib/directus";

let products: any[] = [];
let mode = "live";
let warning: string | null = null;

try {
  const directusData = await getDirectusProducts();
  if (directusData && directusData.length > 0) {
    products = directusData.map((dp: any) => ({
      id: dp.id,
      slug: dp.slug,
      name: dp.name,
      description: dp.description || "",
      shortDescription: dp.description || "",
      thumbnailUrl: dp.cover_image_url || null,
      topCategory: dp.category_name || "Generala",
      professionTags: [],
      featured: dp.is_featured || false,
      categoryName: dp.category_name || "Catalog general",
      categorySlug: (dp.category_name || "general")
        .toLowerCase()
        .replace(/\s+/g, "-"),
      producatorName: "You Protect",
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString(),
      merchandisingTags: dp.is_featured ? ["Bestseller"] : [],
      supplierSku: dp.supplier_sku || null,
    }));
  } else {
    const dbResult = await getCatalogProducts();
    products = dbResult.products;
    mode = dbResult.mode;
    warning = dbResult.warning;
  }
} catch (e) {
  const dbResult = await getCatalogProducts();
  products = dbResult.products;
  mode = dbResult.mode;
  warning = dbResult.warning;
}

const categoryCountMap = new Map<string, number>();
for (const product of products) {
  const currentCount = categoryCountMap.get(product.categoryName) ?? 0;
  categoryCountMap.set(product.categoryName, currentCount + 1);
}

const categorySummary = [...categoryCountMap.entries()]
  .map(([name, count]) => ({ name, count }))
  .sort((left, right) => left.name.localeCompare(right.name, "ro-RO"));

const hasExactTag = (product: (typeof products)[number], target: string) =>
  product.merchandisingTags.some((tag) => tag.trim().toLowerCase() === target);

const hasSeasonTag = (product: (typeof products)[number]) =>
  product.merchandisingTags.some((tag) =>
    tag.trim().toLowerCase().startsWith("sezon"),
  );

const bestsellerCount = products.filter((product) =>
  hasExactTag(product, "bestseller"),
).length;
const noveltyCount = products.filter((product) =>
  hasExactTag(product, "noutate"),
).length;
const seasonalCount = products.filter((product) =>
  hasSeasonTag(product),
).length;

const hasProducts = products.length > 0;
---

<BaseLayout
  title="Catalog"
  description="Catalog You Protect conectat la baza de date: produse premium, selectie rapida si flux de cerere oferta."
>
  <section
    class="relative pt-12 pb-16 md:pt-24 md:pb-24 border-b border-yp-white/10"
  >
    <div class="absolute inset-0 pointer-events-none">
      <div
        class="absolute top-0 right-0 w-[500px] h-[500px] rounded-full bg-cyan-400/5 blur-[100px]"
      >
      </div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4">
      <p
        class="text-[11px] font-medium uppercase tracking-[0.2em] text-cyan-400/90 mb-4"
      >
        Digital Lookbook
      </p>
      <h1
        class="text-5xl md:text-6xl lg:text-7xl font-light text-yp-white max-w-4xl leading-[1.1] tracking-tight"
      >
        Echipamente tehnice. <br /><span class="text-yp-white/50"
          >Curație pentru profesioniști.</span
        >
      </h1>
      <p
        class="mt-8 text-lg font-light text-yp-white/70 max-w-2xl leading-relaxed"
      >
        Renunțăm la coșul de cumpărături clasi. Explorează selecția noastră,
        construiește un "moodboard" tehnic pentru echipa ta, iar noi trimitem
        mostre pentru testare gratuită.
      </p>

      <div
        class="mt-12 flex items-center gap-6 text-sm font-light text-yp-white/50 border-t border-yp-white/10 pt-6"
      >
        <span class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-yp-yellow"></span>
          {products.length} concepte live
        </span>
        <span class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
          Selecție B2B privată
        </span>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 pt-10 pb-24 md:py-14">
    {
      mode === "degraded" && (
        <div class="mb-8 rounded-lg border border-amber-400/30 bg-amber-400/10 px-4 py-3 text-sm text-amber-100">
          Catalogul nu a putut fi incarcat din DB in acest build. Motiv:{" "}
          {warning ?? "necunoscut"}
        </div>
      )
    }

    {
      hasProducts && (
        <div
          id="shortlist-summary"
          class="mb-8 rounded-xl border border-yp-white/15 bg-yp-gray/30 p-5"
        >
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
              <p class="text-sm uppercase tracking-wide text-yp-yellow/80">
                Selectia ta pentru oferta
              </p>
              <p id="shortlist-count" class="text-yp-white text-lg mt-1">
                0 produse selectate
              </p>
            </div>

            <div id="shortlist-actions" class="hidden flex flex-wrap gap-2">
              <button
                type="button"
                id="shortlist-open-modal"
                class="px-4 py-2 rounded-md bg-yp-yellow text-yp-black font-semibold hover:bg-yp-white transition-colors"
              >
                Cere oferta
              </button>
              <button
                type="button"
                id="shortlist-open-booking"
                class="px-4 py-2 rounded-md border border-yp-white/30 text-yp-white hover:border-yp-yellow/40 hover:text-yp-yellow transition-colors"
              >
                Discuta cu noi
              </button>
              <button
                type="button"
                id="shortlist-clear"
                class="px-4 py-2 rounded-md border border-yp-white/20 text-yp-white/70 hover:border-yp-white/45 hover:text-yp-white transition-colors"
              >
                Reseteaza
              </button>
            </div>
          </div>

          <p id="shortlist-empty-hint" class="mt-3 text-sm text-yp-white/65">
            Selecteaza produse din catalog pentru a activa cererea de oferta.
          </p>
          <div
            id="shortlist-chip-list"
            class="hidden mt-4 flex flex-wrap gap-2"
          />
          <p
            id="shortlist-warning"
            class="mt-3 text-sm text-amber-200 hidden"
          />
        </div>
      )
    }

    {
      hasProducts && categorySummary.length > 0 && (
        <div class="mb-14 flex flex-col md:flex-row md:items-end justify-between gap-8 border-b border-yp-white/10 pb-6">
          <div class="flex-1">
            <p class="text-[10px] uppercase tracking-[0.2em] text-yp-white/40 mb-4">
              Navigare Cromatică / Roluri
            </p>
            <div class="flex flex-wrap gap-4" id="catalog-category-filters">
              <button
                type="button"
                data-category-filter="all"
                class="text-sm font-medium text-yp-white border-b border-yp-white pb-1 transition-colors hover:text-yp-white"
              >
                Toată Selecția
              </button>
              {categorySummary.map((category) => (
                <button
                  type="button"
                  data-category-filter={category.name}
                  class="text-sm font-light text-yp-white/50 pb-1 border-b border-transparent hover:text-yp-white transition-colors"
                >
                  {category.name}{" "}
                  <span class="text-[10px] align-top text-yp-white/30 ml-0.5">
                    {category.count}
                  </span>
                </button>
              ))}
            </div>
          </div>

          <div>
            <p class="text-[10px] uppercase tracking-[0.2em] text-yp-white/40 mb-4">
              Tag-uri Rapide
            </p>
            <div class="flex flex-wrap gap-3" id="catalog-tag-filters">
              <button
                type="button"
                data-tag-filter="all"
                class="px-3 py-1 rounded-full text-[11px] uppercase tracking-wider border border-yp-white/30 text-yp-white"
              >
                Reset
              </button>
              <button
                type="button"
                data-tag-filter="bestseller"
                class="px-3 py-1 rounded-full text-[11px] uppercase tracking-wider border border-yp-white/10 text-yp-white/60 hover:border-yp-white/40 hover:text-yp-white transition-colors"
              >
                Bestsellers
              </button>
              <button
                type="button"
                data-tag-filter="new"
                class="px-3 py-1 rounded-full text-[11px] uppercase tracking-wider border border-yp-white/10 text-yp-white/60 hover:border-yp-white/40 hover:text-yp-white transition-colors"
              >
                Noutăți
              </button>
              <button
                type="button"
                data-tag-filter="seasonal"
                class="px-3 py-1 rounded-full text-[11px] uppercase tracking-wider border border-yp-white/10 text-yp-white/60 hover:border-yp-white/40 hover:text-yp-white transition-colors"
              >
                Sezon
              </button>
            </div>
          </div>
        </div>
      )
    }

    <div>
      <h2 class="text-lg text-yp-white mb-3">Sortare</h2>
      <div class="flex flex-wrap gap-2" id="catalog-sort-filters">
        <button
          type="button"
          data-sort-filter="relevance"
          class="px-3 py-1.5 rounded-full text-xs border bg-yp-yellow border-yp-yellow text-yp-black font-semibold"
        >
          Relevanta
        </button>
        <button
          type="button"
          data-sort-filter="new"
          class="px-3 py-1.5 rounded-full text-xs border border-yp-white/20 text-yp-white/75 hover:border-yp-white/50 hover:text-yp-white transition-colors"
        >
          Noutati
        </button>
        <button
          type="button"
          data-sort-filter="az"
          class="px-3 py-1.5 rounded-full text-xs border border-yp-white/20 text-yp-white/75 hover:border-yp-white/50 hover:text-yp-white transition-colors"
        >
          A-Z
        </button>
      </div>
    </div>
  </section>
  ) }

  {
    !hasProducts ? (
      <div class="py-20 text-center">
        <h2 class="text-3xl font-light text-yp-white">
          Lookbook în pregătire.
        </h2>
        <p class="mt-4 text-yp-white/50 font-light max-w-xl mx-auto">
          Echipa actualizeză conceptele vizuale din Directus. Catalogul curent
          se va regenera curând.
        </p>
      </div>
    ) : (
      <div>
        <div
          id="catalog-grid"
          class="columns-1 sm:columns-2 lg:columns-3 gap-8 space-y-8"
        >
          {products.map((product, index) => (
            <div
              data-catalog-item
              data-original-index={index}
              data-category={product.categoryName}
              data-is-bestseller={
                hasExactTag(product, "bestseller") ? "1" : "0"
              }
              data-is-new={hasExactTag(product, "noutate") ? "1" : "0"}
              data-is-seasonal={hasSeasonTag(product) ? "1" : "0"}
              data-sort-name={product.name.toLocaleLowerCase("ro-RO")}
              data-sort-created={product.createdAt}
              data-sort-featured={product.featured ? "1" : "0"}
              class="break-inside-avoid"
            >
              <ProductCard
                id={product.id}
                slug={product.slug}
                name={product.name}
                categoryName={product.categoryName}
                shortDescription={product.shortDescription}
                producatorName={product.producatorName}
                featured={product.featured}
                merchandisingTags={product.merchandisingTags}
                thumbnailUrl={product.thumbnailUrl}
              />
            </div>
          ))}
        </div>
        <p
          id="catalog-empty-filter"
          class="hidden mt-10 text-center text-yp-white/50 font-light py-20 border border-yp-white/10 rounded-sm"
        >
          Nu au fost găsite curatoare digitale pentru selecția ta.
        </p>
      </div>
    )
  }
</BaseLayout>

<div
  id="mobile-shortlist-bar"
  class="hidden md:hidden fixed bottom-4 left-4 right-4 z-40 rounded-xl border border-yp-white/20 bg-yp-black/95 backdrop-blur-sm p-3 shadow-[0_10px_30px_rgba(0,0,0,0.45)]"
>
  <div class="flex items-center justify-between gap-3">
    <p id="mobile-shortlist-count" class="text-sm text-yp-white/85">
      0 produse selectate
    </p>
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="mobile-shortlist-open-booking"
        class="px-3 py-2 rounded-md border border-yp-white/25 text-yp-white text-xs hover:border-yp-yellow/40 hover:text-yp-yellow transition-colors"
      >
        Discuta
      </button>
      <button
        type="button"
        id="mobile-shortlist-open-modal"
        class="px-3 py-2 rounded-md bg-yp-yellow text-yp-black text-xs font-semibold hover:bg-yp-white transition-colors"
      >
        Cere oferta
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    let initialized = false;

    const initShortlistBindings = () => {
      if (initialized) {
        return true;
      }

      const shortlist = window.YouProtectShortlist;
      if (!shortlist) {
        return false;
      }

      const warningEl = document.getElementById("shortlist-warning");
      const countEl = document.getElementById("shortlist-count");
      const chipListEl = document.getElementById("shortlist-chip-list");
      const emptyHintEl = document.getElementById("shortlist-empty-hint");
      const actionsEl = document.getElementById("shortlist-actions");
      const openModalBtn = document.getElementById("shortlist-open-modal");
      const openBookingBtn = document.getElementById("shortlist-open-booking");
      const clearBtn = document.getElementById("shortlist-clear");
      const mobileBarEl = document.getElementById("mobile-shortlist-bar");
      const mobileCountEl = document.getElementById("mobile-shortlist-count");
      const mobileOpenModalBtn = document.getElementById(
        "mobile-shortlist-open-modal",
      );
      const mobileOpenBookingBtn = document.getElementById(
        "mobile-shortlist-open-booking",
      );
      const toggleButtons = Array.from(
        document.querySelectorAll("[data-shortlist-toggle]"),
      );

      const categoryButtons = Array.from(
        document.querySelectorAll("[data-category-filter]"),
      );
      const tagButtons = Array.from(
        document.querySelectorAll("[data-tag-filter]"),
      );
      const sortButtons = Array.from(
        document.querySelectorAll("[data-sort-filter]"),
      );
      const catalogItems = Array.from(
        document.querySelectorAll("[data-catalog-item]"),
      );
      const catalogGridEl = document.getElementById("catalog-grid");
      const emptyFilterEl = document.getElementById("catalog-empty-filter");
      let activeCategory = "all";
      let activeTag = "all";
      let activeSort = "relevance";

      const showWarning = (message) => {
        if (!warningEl) return;
        warningEl.textContent = message;
        warningEl.classList.remove("hidden");
      };

      const clearWarning = () => {
        if (!warningEl) return;
        warningEl.textContent = "";
        warningEl.classList.add("hidden");
      };

      const productFromButton = (button) => ({
        id: button.getAttribute("data-product-id") || "",
        name: button.getAttribute("data-product-name") || "",
        slug: button.getAttribute("data-product-slug") || "",
        categoryName: button.getAttribute("data-product-category") || "",
      });

      const refreshButtons = () => {
        toggleButtons.forEach((button) => {
          const productId = button.getAttribute("data-product-id") || "";
          const selected = shortlist.isSelected(productId);
          button.textContent = selected ? "In selectie" : "Selecteaza produs";
          button.classList.toggle("bg-yp-yellow", !selected);
          button.classList.toggle("text-yp-black", !selected);
          button.classList.toggle("hover:bg-yp-white", !selected);
          button.classList.toggle("bg-transparent", selected);
          button.classList.toggle("text-yp-white", selected);
          button.classList.toggle("border", selected);
          button.classList.toggle("border-yp-yellow/40", selected);
          button.classList.toggle("hover:border-yp-white/60", selected);
        });
      };

      const refreshSummary = () => {
        const items = shortlist.getItems();
        const label =
          items.length === 1 ? "produs selectat" : "produse selectate";

        if (countEl) {
          countEl.textContent = `${items.length} ${label}`;
        }
        if (mobileCountEl) {
          mobileCountEl.textContent = `${items.length} ${label}`;
        }

        if (actionsEl) {
          actionsEl.classList.toggle("hidden", items.length === 0);
        }
        if (emptyHintEl) {
          emptyHintEl.classList.toggle("hidden", items.length > 0);
        }

        if (chipListEl) {
          chipListEl.innerHTML = "";
          chipListEl.classList.toggle("hidden", items.length === 0);

          if (items.length > 0) {
            items.forEach((item) => {
              const chip = document.createElement("span");
              chip.className =
                "inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs border border-yp-white/20 text-yp-white/80";
              chip.textContent = item.name;
              chipListEl.appendChild(chip);
            });
          }
        }

        if (mobileBarEl) {
          mobileBarEl.classList.toggle("hidden", items.length === 0);
        }
      };

      const openSamplesFlow = (source) => {
        const items = shortlist.getItems();
        if (items.length === 0) {
          showWarning(
            "Selecteaza cel putin un produs pentru cererea de oferta.",
          );
          return;
        }
        clearWarning();
        shortlist.openLeadModal({ intent: "view_samples", source });
      };

      const matchesTag = (item) => {
        if (activeTag === "all") {
          return true;
        }

        if (activeTag === "bestseller") {
          return item.getAttribute("data-is-bestseller") === "1";
        }

        if (activeTag === "new") {
          return item.getAttribute("data-is-new") === "1";
        }

        if (activeTag === "seasonal") {
          return item.getAttribute("data-is-seasonal") === "1";
        }

        return true;
      };

      const parseDateValue = (value) => {
        const timestamp = Date.parse(value || "");
        return Number.isNaN(timestamp) ? 0 : timestamp;
      };

      const compareItems = (left, right) => {
        if (activeSort === "az") {
          const leftName = left.getAttribute("data-sort-name") || "";
          const rightName = right.getAttribute("data-sort-name") || "";
          return leftName.localeCompare(rightName, "ro-RO");
        }

        if (activeSort === "new") {
          const leftCreated = parseDateValue(
            left.getAttribute("data-sort-created"),
          );
          const rightCreated = parseDateValue(
            right.getAttribute("data-sort-created"),
          );
          if (rightCreated !== leftCreated) {
            return rightCreated - leftCreated;
          }
        }

        const leftFeatured =
          left.getAttribute("data-sort-featured") === "1" ? 1 : 0;
        const rightFeatured =
          right.getAttribute("data-sort-featured") === "1" ? 1 : 0;
        if (rightFeatured !== leftFeatured) {
          return rightFeatured - leftFeatured;
        }

        const leftBestseller =
          left.getAttribute("data-is-bestseller") === "1" ? 1 : 0;
        const rightBestseller =
          right.getAttribute("data-is-bestseller") === "1" ? 1 : 0;
        if (rightBestseller !== leftBestseller) {
          return rightBestseller - leftBestseller;
        }

        const leftNew = left.getAttribute("data-is-new") === "1" ? 1 : 0;
        const rightNew = right.getAttribute("data-is-new") === "1" ? 1 : 0;
        if (rightNew !== leftNew) {
          return rightNew - leftNew;
        }

        const leftCreated = parseDateValue(
          left.getAttribute("data-sort-created"),
        );
        const rightCreated = parseDateValue(
          right.getAttribute("data-sort-created"),
        );
        if (rightCreated !== leftCreated) {
          return rightCreated - leftCreated;
        }

        const leftIndex = Number(
          left.getAttribute("data-original-index") || "0",
        );
        const rightIndex = Number(
          right.getAttribute("data-original-index") || "0",
        );
        return leftIndex - rightIndex;
      };

      const refreshFilters = () => {
        let visibleCount = 0;

        catalogItems.forEach((item) => {
          const category = item.getAttribute("data-category") || "";
          const categoryMatch =
            activeCategory === "all" || category === activeCategory;
          const tagMatch = matchesTag(item);
          const isVisible = categoryMatch && tagMatch;

          item.classList.toggle("hidden", !isVisible);
          if (isVisible) {
            visibleCount += 1;
          }
        });

        if (emptyFilterEl) {
          emptyFilterEl.classList.toggle("hidden", visibleCount > 0);
        }

        if (catalogGridEl) {
          const ordered = [...catalogItems].sort(compareItems);
          ordered.forEach((item) => {
            catalogGridEl.appendChild(item);
          });
        }

        categoryButtons.forEach((button) => {
          const filterValue =
            button.getAttribute("data-category-filter") || "all";
          const isActive = filterValue === activeCategory;
          button.classList.toggle("border-yp-white", isActive);
          button.classList.toggle("text-yp-white", isActive);
          button.classList.toggle("font-medium", isActive);
          button.classList.toggle("border-transparent", !isActive);
          button.classList.toggle("text-yp-white/50", !isActive);
          button.classList.toggle("font-light", !isActive);
        });

        tagButtons.forEach((button) => {
          const filterValue = button.getAttribute("data-tag-filter") || "all";
          const isActive = filterValue === activeTag;
          button.classList.toggle("border-yp-white/30", isActive);
          button.classList.toggle("text-yp-white", isActive);
          button.classList.toggle("border-yp-white/10", !isActive);
          button.classList.toggle("text-yp-white/60", !isActive);
        });

        sortButtons.forEach((button) => {
          const filterValue =
            button.getAttribute("data-sort-filter") || "relevance";
          const isActive = filterValue === activeSort;
          button.classList.toggle("bg-yp-yellow", isActive);
          button.classList.toggle("border-yp-yellow", isActive);
          button.classList.toggle("text-yp-black", isActive);
          button.classList.toggle("font-semibold", isActive);
          button.classList.toggle("border-yp-white/20", !isActive);
          button.classList.toggle("text-yp-white/75", !isActive);
        });
      };

      toggleButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const result = shortlist.toggle(productFromButton(button));
          if (!result.ok && result.error === "max_reached") {
            showWarning("Ai ajuns la limita de 12 produse in selectie.");
            return;
          }
          clearWarning();
          refreshButtons();
          refreshSummary();
        });
      });

      categoryButtons.forEach((button) => {
        button.addEventListener("click", () => {
          activeCategory = button.getAttribute("data-category-filter") || "all";
          refreshFilters();
        });
      });

      tagButtons.forEach((button) => {
        button.addEventListener("click", () => {
          activeTag = button.getAttribute("data-tag-filter") || "all";
          refreshFilters();
        });
      });

      sortButtons.forEach((button) => {
        button.addEventListener("click", () => {
          activeSort = button.getAttribute("data-sort-filter") || "relevance";
          refreshFilters();
        });
      });

      openModalBtn?.addEventListener("click", () =>
        openSamplesFlow("catalog_summary"),
      );
      mobileOpenModalBtn?.addEventListener("click", () =>
        openSamplesFlow("catalog_mobile_sticky_primary"),
      );

      openBookingBtn?.addEventListener("click", () => {
        clearWarning();
        shortlist.openLeadModal({
          intent: "book_call",
          source: "catalog_summary_secondary",
        });
      });
      mobileOpenBookingBtn?.addEventListener("click", () => {
        clearWarning();
        shortlist.openLeadModal({
          intent: "book_call",
          source: "catalog_mobile_sticky_secondary",
        });
      });

      clearBtn?.addEventListener("click", () => {
        shortlist.clear();
        clearWarning();
        refreshButtons();
        refreshSummary();
      });

      window.addEventListener("yp:shortlist-changed", () => {
        refreshButtons();
        refreshSummary();
      });

      refreshButtons();
      refreshSummary();
      refreshFilters();
      initialized = true;
      return true;
    };

    if (initShortlistBindings()) {
      return;
    }

    window.addEventListener("DOMContentLoaded", () => {
      initShortlistBindings();
    });
    window.addEventListener("yp:shortlist-ready", () => {
      initShortlistBindings();
    });
  })();
</script>
