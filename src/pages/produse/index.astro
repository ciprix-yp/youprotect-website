---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/products/ProductCard.astro";
import { getCatalogProducts } from "../../lib/catalog";
import { getDirectusProducts } from "../../lib/directus";

let products: any[] = [];
let mode = "live";
let warning: string | null = null;

try {
  let dbProducts: any[] = [];
  const dbResult = await getCatalogProducts();
  dbProducts = dbResult.products;
  mode = dbResult.mode;
  warning = dbResult.warning;

  const directusData = await getDirectusProducts();
  if (directusData && directusData.length > 0) {
    const directusMapped = directusData.map((dp: any) => ({
      id: dp.id,
      slug: dp.slug,
      name: dp.name,
      description: dp.description || "",
      shortDescription: dp.description || "",
      thumbnailUrl: dp.cover_image_url || null,
      topCategory: dp.category_name || "Generala",
      professionTags: [],
      featured: dp.is_featured || false,
      categoryName: dp.category_name || "Catalog general",
      industry: dp.industry || null,
      categorySlug: (dp.category_name || "general")
        .toLowerCase()
        .replace(/\s+/g, "-"),
      producatorName: "You Protect",
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString(),
      merchandisingTags: dp.is_featured ? ["Bestseller"] : [],
      supplierSku: dp.supplier_sku || null,
    }));
    products = [...directusMapped, ...dbProducts];
  } else {
    products = dbProducts;
  }
} catch (e) {
  const dbResult = await getCatalogProducts();
  products = dbResult.products;
  mode = dbResult.mode;
  warning = dbResult.warning;
}

const categoryCountMap = new Map<string, number>();
for (const product of products) {
  const currentCount = categoryCountMap.get(product.categoryName) ?? 0;
  categoryCountMap.set(product.categoryName, currentCount + 1);
}

const categorySummary = [...categoryCountMap.entries()]
  .map(([name, count]) => ({ name, count }))
  .sort((left, right) => left.name.localeCompare(right.name, "ro-RO"));

const industryCountMap = new Map<string, number>();
for (const product of products) {
  if (product.industry) {
    const currentCount = industryCountMap.get(product.industry) ?? 0;
    industryCountMap.set(product.industry, currentCount + 1);
  }
}

const industrySummary = [...industryCountMap.entries()]
  .map(([name, count]) => ({ name, count }))
  .sort((left, right) => left.name.localeCompare(right.name, "ro-RO"));

const hasExactTag = (product: (typeof products)[number], target: string) =>
  product.merchandisingTags.some((tag) => tag.trim().toLowerCase() === target);

const hasSeasonTag = (product: (typeof products)[number]) =>
  product.merchandisingTags.some((tag) =>
    tag.trim().toLowerCase().startsWith("sezon"),
  );

const bestsellerCount = products.filter((product) =>
  hasExactTag(product, "bestseller"),
).length;
const noveltyCount = products.filter((product) =>
  hasExactTag(product, "noutate"),
).length;
const seasonalCount = products.filter((product) =>
  hasSeasonTag(product),
).length;

const hasProducts = products.length > 0;
---

<BaseLayout
  title="Catalog"
  description="Catalog You Protect conectat la baza de date: produse premium, selectie rapida si flux de cerere oferta."
>
  <section
    class="relative pt-12 pb-16 md:pt-24 md:pb-24 border-b border-yp-white/10"
  >
    <div class="absolute inset-0 pointer-events-none">
      <div
        class="absolute top-0 right-0 w-[500px] h-[500px] rounded-full bg-yp-white/5 blur-[100px]"
      >
      </div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4">
      <p
        class="text-[11px] font-medium uppercase tracking-[0.2em] text-yp-white/50 mb-4"
        data-aos="fade-down"
      >
        Digital Lookbook
      </p>
      <h1
        class="text-5xl md:text-6xl lg:text-7xl font-light text-yp-white max-w-4xl leading-[1.1] tracking-tight"
        data-aos="fade-up"
      >
        Echipamente tehnice. <br /><span class="text-yp-white/50"
          >Curație pentru profesioniști.</span
        >
      </h1>
      <p
        class="mt-8 text-lg font-light text-yp-white/70 max-w-2xl leading-relaxed"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        Renunțăm la coșul de cumpărături clasi. Explorează selecția noastră,
        construiește un "moodboard" tehnic pentru echipa ta, iar noi trimitem
        mostre pentru testare gratuită.
      </p>

      <div
        class="mt-12 flex items-center gap-6 text-sm font-light text-yp-white/50 border-t border-yp-white/10 pt-6"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <span class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-yp-yellow animate-pulse"
          ></span>
          {products.length} concepte live
        </span>
        <span class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-yp-white/40"></span>
          Selecție B2B privată
        </span>
      </div>

      <div class="mt-10 flex flex-col sm:flex-row gap-4" data-aos="fade-up" data-aos-delay="300">
        <button
            class="bg-yp-yellow text-yp-black h-12 px-8 rounded-[4px] font-medium text-sm flex items-center justify-center gap-2 hover:bg-white transition-all duration-200 group border border-transparent w-fit"
            onclick="window.YouProtectShortlist?.openLeadModal({ intent: 'request_quote', source: 'catalog_hero' })"
        >
            Cere ofertă
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </button>
        <button
            class="border border-yp-white/20 text-yp-white h-12 px-8 rounded-[4px] font-medium text-sm flex items-center justify-center gap-2 hover:bg-yp-white/5 hover:border-yp-white/40 transition-all duration-200 w-fit"
            onclick="window.YouProtectShortlist?.openLeadModal({ intent: 'free_consultation', source: 'catalog_hero_consultation' })"
        >
            Programează o discuție
            <svg class="w-4 h-4 text-yp-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>

    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-8 md:py-16">
    {
      mode === "degraded" && (
        <div class="mb-8 rounded-lg border border-amber-400/30 bg-amber-400/10 px-4 py-3 text-sm text-amber-100">
          Catalogul nu a putut fi incarcat din DB in acest build. Motiv:{" "}
          {warning ?? "necunoscut"}
        </div>
      )
    }

    <div class="flex flex-col lg:flex-row gap-10">
      <!-- Sidebar Filters (Desktop) & Collapsible (Mobile) -->
      <aside class="w-full lg:w-64 shrink-0 lg:sticky lg:top-28 h-fit z-30">
        <div class="lg:hidden mb-4">
          <button
            id="mobile-filter-toggle"
            type="button"
            class="w-full bg-yp-black/80 border border-yp-white/20 text-yp-white py-3 px-4 flex justify-between items-center rounded-lg backdrop-blur-sm"
          >
            <span
              class="text-sm font-medium uppercase tracking-widest text-yp-yellow"
              >Filtrează Catalogul</span
            >
            <svg
              id="mobile-filter-icon"
              class="w-5 h-5 text-yp-white/50 transition-transform duration-300"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </button>
        </div>

        <div
          id="filter-wrapper"
          class="hidden lg:block bg-yp-black/40 border border-yp-white/10 rounded-2xl p-6 backdrop-blur-sm"
          data-aos="fade-right"
          data-aos-delay="200"
        >
          <div class="mb-6 pb-6 border-b border-yp-white/10">
            <h3 class="text-sm uppercase tracking-widest text-yp-white/50 mb-4">
              Căutare Rapidă
            </h3>
            <div class="relative">
              <input
                type="text"
                id="catalog-search"
                placeholder="Ex: Bocanci, vizibilitate..."
                class="w-full bg-yp-gray/50 border border-yp-white/20 rounded-lg py-2.5 px-4 text-sm text-yp-white placeholder:text-yp-white/30 focus:outline-none focus:border-yp-yellow transition-colors"
              />
              <svg
                class="absolute right-3 top-3 w-4 h-4 text-yp-white/40"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg
              >
            </div>
          </div>

          {
            hasProducts && categorySummary.length > 0 && (
              <div class="mb-6">
                <h3 class="text-sm uppercase tracking-widest text-yp-white/50 mb-4">
                  Categorie Produs
                </h3>
                <div class="flex flex-col gap-2" id="catalog-category-filters">
                  <button
                    type="button"
                    data-category-filter="all"
                    class="text-left text-sm font-medium text-yp-white py-1 transition-colors hover:text-yp-yellow flex items-center justify-between"
                  >
                    Toate Categoriile
                    <span class="text-xs text-yp-white/30">
                      {products.length}
                    </span>
                  </button>
                  {categorySummary.map((category) => (
                    <button
                      type="button"
                      data-category-filter={category.name}
                      class="text-left text-sm font-light text-yp-white/60 py-1 hover:text-yp-white transition-colors flex items-center justify-between"
                    >
                      {category.name}
                      <span class="text-xs text-yp-white/30">
                        {category.count}
                      </span>
                    </button>
                  ))}
                </div>
              </div>
            )
          }

          {
            hasProducts && industrySummary.length > 0 && (
              <div class="mb-6 pb-6 border-b border-yp-white/10">
                <h3 class="text-sm uppercase tracking-widest text-yp-white/50 mb-4">
                  Industrie / Utilizare
                </h3>
                <div class="flex flex-col gap-2" id="catalog-industry-filters">
                  <button
                    type="button"
                    data-industry-filter="all"
                    class="text-left text-sm font-medium text-yp-white py-1 transition-colors hover:text-yp-yellow flex items-center justify-between"
                  >
                    Toate Industriile
                  </button>
                  {industrySummary.map((industry) => (
                    <button
                      type="button"
                      data-industry-filter={industry.name}
                      class="text-left text-sm font-light text-yp-white/60 py-1 hover:text-yp-white transition-colors flex items-center justify-between"
                    >
                      {industry.name}
                      <span class="text-xs text-yp-white/30">
                        {industry.count}
                      </span>
                    </button>
                  ))}
                </div>
              </div>
            )
          }

          <div class="mb-6 pb-6 border-b border-yp-white/10">
            <h3 class="text-sm uppercase tracking-widest text-yp-white/50 mb-4">
              Curatoriat
            </h3>
            <div class="flex flex-col gap-2" id="catalog-tag-filters">
              <button
                type="button"
                data-tag-filter="all"
                class="text-left text-sm font-light text-yp-white/60 py-1 hover:text-yp-white"
              >
                Orice fel
              </button>
              <button
                type="button"
                data-tag-filter="bestseller"
                class="text-left text-sm font-light text-yp-white/60 py-1 hover:text-yp-white"
              >
                Bestsellers
              </button>
              <button
                type="button"
                data-tag-filter="new"
                class="text-left text-sm font-light text-yp-white/60 py-1 hover:text-yp-white"
              >
                Noutăți Tehnice
              </button>
              <button
                type="button"
                data-tag-filter="seasonal"
                class="text-left text-sm font-light text-yp-white/60 py-1 hover:text-yp-white"
              >
                Sezonalitate
              </button>
            </div>
          </div>

          <div>
            <h3 class="text-sm uppercase tracking-widest text-yp-white/50 mb-4">
              Sortare
            </h3>
            <div class="flex flex-col gap-2" id="catalog-sort-filters">
              <button
                type="button"
                data-sort-filter="relevance"
                class="text-left text-sm font-medium text-yp-yellow py-1"
              >
                Relevanță
              </button>
              <button
                type="button"
                data-sort-filter="new"
                class="text-left text-sm font-light text-yp-white/60 py-1 hover:text-yp-white transition-colors"
              >
                Noutăți
              </button>
              <button
                type="button"
                data-sort-filter="az"
                class="text-left text-sm font-light text-yp-white/60 py-1 hover:text-yp-white transition-colors"
              >
                Alfabetic (A-Z)
              </button>
            </div>
          </div>
        </div>
      </aside>

      <!-- Main Content Area -->
      <div class="flex-1">
        {
          !hasProducts ? (
            <div class="py-20 text-center">
              <h2 class="text-3xl font-light text-yp-white">
                Lookbook în pregătire.
              </h2>
              <p class="mt-4 text-yp-white/50 font-light max-w-xl mx-auto">
                Echipa actualizeză conceptele vizuale din Directus. Catalogul
                curent se va regenera curând.
              </p>
            </div>
          ) : (
            <div>
              <div
                id="catalog-grid"
                class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6"
              >
                {products.map((product, index) => (
                  <div
                    data-catalog-item
                    data-search-text={`${product.name} ${product.categoryName} ${product.industry || ""} ${product.shortDescription}`.toLowerCase()}
                    data-original-index={index}
                    data-category={product.categoryName}
                    data-industry={product.industry || ""}
                    data-is-bestseller={
                      hasExactTag(product, "bestseller") ? "1" : "0"
                    }
                    data-is-new={hasExactTag(product, "noutate") ? "1" : "0"}
                    data-is-seasonal={hasSeasonTag(product) ? "1" : "0"}
                    data-sort-name={product.name.toLocaleLowerCase("ro-RO")}
                    data-sort-created={product.createdAt}
                    data-sort-featured={product.featured ? "1" : "0"}
                    class=""
                    data-aos="fade-up"
                    data-aos-delay={String((index % 6) * 50)}
                  >
                    <ProductCard
                      id={product.id}
                      slug={product.slug}
                      name={product.name}
                      categoryName={product.categoryName}
                      industry={product.industry}
                      shortDescription={product.shortDescription}
                      producatorName={product.producatorName}
                      featured={product.featured}
                      merchandisingTags={product.merchandisingTags}
                      thumbnailUrl={product.thumbnailUrl}
                    />
                  </div>
                ))}
              </div>
              <div id="catalog-empty-filter" class="hidden mt-10 text-center text-yp-white/50 font-light py-20 border border-yp-white/10 rounded-sm">
                <p class="mb-6">Nu a fost găsit niciun echipament conform criteriilor selectate.</p>
                <div class="flex flex-col items-center justify-center">
                  <p class="text-sm text-yp-white mb-4">Nu ești sigur ce se potrivește echipei tale? Te ajutăm să alegi mai clar.</p>
                  <button
                    class="bg-yp-yellow text-yp-black h-10 px-6 rounded-[4px] font-medium text-sm inline-flex items-center justify-center gap-2 hover:bg-white transition-all duration-200"
                    onclick="window.YouProtectShortlist?.openLeadModal({ intent: 'free_consultation', source: 'catalog_empty_state' })"
                  >
                    Programează o discuție
                  </button>
                </div>
              </div>
            </div>
          )
        }
      </div>
      <!-- End Layout Flex -->
    </div>
  </section>

  <script is:inline>
    (() => {
      const categoryButtons = Array.from(
        document.querySelectorAll("[data-category-filter]"),
      );
      const industryButtons = Array.from(
        document.querySelectorAll("[data-industry-filter]"),
      );
      const tagButtons = Array.from(
        document.querySelectorAll("[data-tag-filter]"),
      );
      const sortButtons = Array.from(
        document.querySelectorAll("[data-sort-filter]"),
      );
      const catalogItems = Array.from(
        document.querySelectorAll("[data-catalog-item]"),
      );
      const catalogGridEl = document.getElementById("catalog-grid");
      const emptyFilterEl = document.getElementById("catalog-empty-filter");
      const searchInput = document.getElementById("catalog-search");

      const filterToggleBtn = document.getElementById("mobile-filter-toggle");
      const filterWrapper = document.getElementById("filter-wrapper");
      const filterIcon = document.getElementById("mobile-filter-icon");

      if (filterToggleBtn && filterWrapper && filterIcon) {
        filterToggleBtn.addEventListener("click", () => {
          filterWrapper.classList.toggle("hidden");
          filterIcon.classList.toggle("rotate-180");
        });
      }

      let activeCategory = "all";
      let activeIndustry = "all";
      let activeTag = "all";
      let activeSort = "relevance";
      let searchQuery = "";

      const matchesTag = (item) => {
        if (activeTag === "all") return true;
        if (activeTag === "bestseller")
          return item.getAttribute("data-is-bestseller") === "1";
        if (activeTag === "new")
          return item.getAttribute("data-is-new") === "1";
        if (activeTag === "seasonal")
          return item.getAttribute("data-is-seasonal") === "1";
        return true;
      };

      const parseDateValue = (value) => {
        const timestamp = Date.parse(value || "");
        return Number.isNaN(timestamp) ? 0 : timestamp;
      };

      const compareItems = (left, right) => {
        if (activeSort === "az") {
          const leftName = left.getAttribute("data-sort-name") || "";
          const rightName = right.getAttribute("data-sort-name") || "";
          return leftName.localeCompare(rightName, "ro-RO");
        }

        if (activeSort === "new") {
          const leftCreated = parseDateValue(
            left.getAttribute("data-sort-created"),
          );
          const rightCreated = parseDateValue(
            right.getAttribute("data-sort-created"),
          );
          if (rightCreated !== leftCreated) return rightCreated - leftCreated;
        }

        const leftFeatured =
          left.getAttribute("data-sort-featured") === "1" ? 1 : 0;
        const rightFeatured =
          right.getAttribute("data-sort-featured") === "1" ? 1 : 0;
        if (rightFeatured !== leftFeatured) return rightFeatured - leftFeatured;

        const leftBestseller =
          left.getAttribute("data-is-bestseller") === "1" ? 1 : 0;
        const rightBestseller =
          right.getAttribute("data-is-bestseller") === "1" ? 1 : 0;
        if (rightBestseller !== leftBestseller)
          return rightBestseller - leftBestseller;

        const leftNew = left.getAttribute("data-is-new") === "1" ? 1 : 0;
        const rightNew = right.getAttribute("data-is-new") === "1" ? 1 : 0;
        if (rightNew !== leftNew) return rightNew - leftNew;

        const leftIndex = Number(
          left.getAttribute("data-original-index") || "0",
        );
        const rightIndex = Number(
          right.getAttribute("data-original-index") || "0",
        );
        return leftIndex - rightIndex;
      };

      const refreshFilters = () => {
        let visibleCount = 0;

        catalogItems.forEach((item) => {
          const category = item.getAttribute("data-category") || "";
          const industry = item.getAttribute("data-industry") || "";

          const categoryMatch =
            activeCategory === "all" || category === activeCategory;

          const industryMatch =
            activeIndustry === "all" || industry === activeIndustry;

          const tagMatch = matchesTag(item);

          const textContent = item.getAttribute("data-search-text") || "";
          const searchMatch =
            !searchQuery || textContent.includes(searchQuery.toLowerCase());

          const isVisible =
            categoryMatch && industryMatch && tagMatch && searchMatch;

          item.classList.toggle("hidden", !isVisible);
          if (isVisible) {
            visibleCount += 1;
          }
        });

        if (emptyFilterEl) {
          emptyFilterEl.classList.toggle("hidden", visibleCount > 0);
        }

        if (catalogGridEl) {
          const ordered = [...catalogItems].sort(compareItems);
          ordered.forEach((item) => {
            catalogGridEl.appendChild(item);
          });
        }

        // Update button styles
        categoryButtons.forEach((button) => {
          const filterValue =
            button.getAttribute("data-category-filter") || "all";
          const isActive = filterValue === activeCategory;
          button.classList.toggle("text-yp-yellow", isActive);
          button.classList.toggle("font-medium", isActive);
          button.classList.toggle("text-yp-white/60", !isActive);
          button.classList.toggle("font-light", !isActive);
        });

        industryButtons.forEach((button) => {
          const filterValue =
            button.getAttribute("data-industry-filter") || "all";
          const isActive = filterValue === activeIndustry;
          button.classList.toggle("text-yp-yellow", isActive);
          button.classList.toggle("font-medium", isActive);
          button.classList.toggle("text-yp-white/60", !isActive);
          button.classList.toggle("font-light", !isActive);
        });

        tagButtons.forEach((button) => {
          const filterValue = button.getAttribute("data-tag-filter") || "all";
          const isActive = filterValue === activeTag;
          button.classList.toggle("text-yp-white", isActive);
          button.classList.toggle("font-medium", isActive);
          button.classList.toggle("text-yp-white/60", !isActive);
          button.classList.toggle("font-light", !isActive);
        });

        sortButtons.forEach((button) => {
          const filterValue =
            button.getAttribute("data-sort-filter") || "relevance";
          const isActive = filterValue === activeSort;
          button.classList.toggle("text-yp-yellow", isActive);
          button.classList.toggle("font-medium", isActive);
          button.classList.toggle("text-yp-white/60", !isActive);
          button.classList.toggle("font-light", !isActive);
        });
      };

      if (searchInput) {
        searchInput.addEventListener("input", (e) => {
          searchQuery = e.target.value;
          refreshFilters();
        });
      }

      categoryButtons.forEach((button) => {
        button.addEventListener("click", () => {
          activeCategory = button.getAttribute("data-category-filter") || "all";
          refreshFilters();
        });
      });

      industryButtons.forEach((button) => {
        button.addEventListener("click", () => {
          activeIndustry = button.getAttribute("data-industry-filter") || "all";
          refreshFilters();
        });
      });

      tagButtons.forEach((button) => {
        button.addEventListener("click", () => {
          activeTag = button.getAttribute("data-tag-filter") || "all";
          refreshFilters();
        });
      });

      sortButtons.forEach((button) => {
        button.addEventListener("click", () => {
          activeSort = button.getAttribute("data-sort-filter") || "relevance";
          refreshFilters();
        });
      });

      refreshFilters();

      // Mobile Scroll Highlight for Cards
      const observer = new IntersectionObserver(
        (entries) => {
          if (window.innerWidth >= 1024) return; // Only apply on mobile/tablet
          entries.forEach((entry) => {
            const card = entry.target.querySelector("article");
            if (!card) return;

            if (entry.isIntersecting) {
              card.classList.add(
                "border-yp-yellow",
                "bg-yp-black/60",
                "mobile-active",
              );
              card.classList.remove("border-yp-white/10", "bg-yp-black/20");
            } else {
              card.classList.remove(
                "border-yp-yellow",
                "bg-yp-black/60",
                "mobile-active",
              );
              card.classList.add("border-yp-white/10", "bg-yp-black/20");
            }
          });
        },
        {
          rootMargin: "-30% 0px -30% 0px", // Trigger when card is in the middle 40% of the screen
          threshold: 0,
        },
      );

      catalogItems.forEach((item) => observer.observe(item));
    })();
  </script>

  <!-- CTA Sticky Footer Block for Catalog -->
