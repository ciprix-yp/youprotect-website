---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCatalogProducts, getCatalogProductDetailBySlug } from '../../lib/catalog';

export async function getStaticPaths() {
  const { products } = await getCatalogProducts();

  return products.map((product) => ({
    params: { slug: product.slug },
  }));
}

const slug = Astro.params.slug ?? '';
const { product, mode, warning } = await getCatalogProductDetailBySlug(slug);

const productName = product?.name ?? 'Produs indisponibil';
const pageDescription =
  product?.shortDescription ||
  'Detalii produs You Protect: beneficii, conformitate si proces de testare fara risc.';

const updatedLabel = product
  ? new Date(product.updatedAt).toLocaleDateString('ro-RO', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
---

<BaseLayout title={productName} description={pageDescription}>
  <section class="max-w-7xl mx-auto px-4 py-10 md:py-14">
    {mode === 'degraded' && (
      <div class="mb-8 rounded-lg border border-amber-400/30 bg-amber-400/10 px-4 py-3 text-sm text-amber-100">
        Detaliul produsului nu a putut fi sincronizat din DB in acest build. Motiv: {warning ?? 'necunoscut'}
      </div>
    )}

    {!product ? (
      <div class="rounded-xl border border-yp-white/15 bg-yp-gray/30 p-8 text-center">
        <h1 class="text-3xl text-yp-white">Produs indisponibil</h1>
        <p class="mt-3 text-yp-white/70 max-w-xl mx-auto">
          Slug-ul cerut nu exista momentan in `vw_catalog_products`.
        </p>
        <a
          href="/produse"
          class="inline-flex mt-6 px-5 py-3 rounded-md bg-yp-yellow text-yp-black font-semibold hover:bg-yp-white transition-colors"
        >
          Inapoi la catalog
        </a>
      </div>
    ) : (
      <article class="space-y-8">
        <nav class="text-sm text-yp-white/60">
          <a href="/" class="hover:text-yp-white transition-colors">Acasa</a>
          <span class="mx-2">/</span>
          <a href="/produse" class="hover:text-yp-white transition-colors">Produse</a>
          <span class="mx-2">/</span>
          <span class="text-yp-white">{product.slug}</span>
        </nav>

        <header class="rounded-2xl border border-yp-white/15 bg-gradient-to-r from-yp-gray to-yp-black p-6 md:p-8">
          <p class="text-xs uppercase tracking-[0.2em] text-yp-yellow/80">{product.categoryName}</p>
          <h1 class="mt-2 text-4xl md:text-5xl text-yp-white leading-tight">{product.name}</h1>
          <p class="mt-3 text-yp-white/70">Producator: {product.producatorName}</p>

          {updatedLabel && (
            <p class="mt-3 text-xs text-yp-white/50">Actualizat in catalog la: {updatedLabel}</p>
          )}

          <p class="mt-6 text-yp-white/80 leading-relaxed max-w-3xl">
            {product.description || 'Descrierea completa este in curs de actualizare.'}
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <button
              type="button"
              id="product-open-test"
              data-product-id={product.id}
              data-product-name={product.name}
              data-product-slug={product.slug}
              data-product-category={product.categoryName}
              class="inline-flex items-center justify-center px-5 py-3 rounded-md bg-yp-yellow text-yp-black font-semibold hover:bg-yp-white transition-colors"
            >
              Vreau sa testez
            </button>
            <button
              type="button"
              id="product-toggle-shortlist"
              data-product-id={product.id}
              data-product-name={product.name}
              data-product-slug={product.slug}
              data-product-category={product.categoryName}
              class="inline-flex items-center justify-center px-5 py-3 rounded-md border border-yp-yellow/40 text-yp-yellow hover:border-yp-white/40 hover:text-yp-white transition-colors"
            >
              Adauga in selectie
            </button>
            <button
              type="button"
              id="product-open-booking"
              class="inline-flex items-center justify-center px-5 py-3 rounded-md border border-yp-white/25 text-yp-white hover:border-yp-yellow/40 hover:text-yp-yellow transition-colors"
            >
              Book a call
            </button>
          </div>

          <p id="product-shortlist-state" class="mt-4 text-sm text-yp-yellow"></p>
          <p id="product-shortlist-warning" class="mt-2 text-sm text-amber-200 hidden"></p>

          <p class="mt-4 text-sm text-yp-white/70 max-w-3xl leading-relaxed">
            Testare fara risc: echipam 3-5 membri ai echipei tale, cadem de acord pe produsele testate, platesti produsele, iar ai 90 de zile garantie money-back daca nu esti multumit.
          </p>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <section class="lg:col-span-2 rounded-xl border border-yp-white/10 bg-yp-gray/20 p-6">
            <h2 class="text-2xl text-yp-white">Beneficii</h2>
            {product.benefits.length > 0 ? (
              <ul class="mt-4 space-y-2 text-yp-white/80">
                {product.benefits.map((benefit) => (
                  <li class="flex gap-2">
                    <span class="text-yp-yellow">•</span>
                    <span>{benefit}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4 text-yp-white/70">
                Beneficiile detaliate urmeaza sa fie completate in baza de date pentru acest produs.
              </p>
            )}
          </section>

          <aside class="space-y-6">
            <section class="rounded-xl border border-yp-white/10 bg-yp-gray/20 p-6">
              <h2 class="text-xl text-yp-white">Garantie</h2>
              <p class="mt-3 text-yp-white/75 leading-relaxed">{product.guarantee}</p>
            </section>

            <section class="rounded-xl border border-yp-white/10 bg-yp-gray/20 p-6">
              <h2 class="text-xl text-yp-white">Conformitate</h2>
              {product.conformity.length > 0 ? (
                <ul class="mt-3 space-y-2 text-yp-white/80 text-sm">
                  {product.conformity.map((item) => (
                    <li class="flex gap-2">
                      <span class="text-yp-yellow">•</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="mt-3 text-yp-white/70 text-sm">
                  Informatiile de conformitate sunt in curs de sincronizare din tabelele tehnice.
                </p>
              )}
            </section>
          </aside>
        </div>
      </article>
    )}
  </section>

  {product && (
    <script is:inline>
      (() => {
        let initialized = false;

        const initProductBindings = () => {
          if (initialized) {
            return true;
          }

          const shortlist = window.YouProtectShortlist;
          if (!shortlist) {
            return false;
          }

          const openTestBtn = document.getElementById('product-open-test');
          const toggleBtn = document.getElementById('product-toggle-shortlist');
          const openBookingBtn = document.getElementById('product-open-booking');
          const stateEl = document.getElementById('product-shortlist-state');
          const warningEl = document.getElementById('product-shortlist-warning');

          if (!openTestBtn || !toggleBtn) {
            return false;
          }

          const getProduct = () => ({
            id: openTestBtn.getAttribute('data-product-id') || '',
            name: openTestBtn.getAttribute('data-product-name') || '',
            slug: openTestBtn.getAttribute('data-product-slug') || '',
            categoryName: openTestBtn.getAttribute('data-product-category') || '',
          });

          const showWarning = (message) => {
            if (!warningEl) return;
            warningEl.textContent = message;
            warningEl.classList.remove('hidden');
          };

          const clearWarning = () => {
            if (!warningEl) return;
            warningEl.textContent = '';
            warningEl.classList.add('hidden');
          };

          const refreshState = () => {
            const product = getProduct();
            const selected = shortlist.isSelected(product.id);
            const total = shortlist.count();

            toggleBtn.textContent = selected ? 'In selectie' : 'Adauga in selectie';
            toggleBtn.classList.toggle('border-yp-yellow/40', !selected);
            toggleBtn.classList.toggle('text-yp-yellow', !selected);
            toggleBtn.classList.toggle('border-yp-white/30', selected);
            toggleBtn.classList.toggle('text-yp-white', selected);

            if (stateEl) {
              if (selected) {
                const label = total === 1 ? 'produs' : 'produse';
                stateEl.textContent = `Produs in selectie (${total} ${label} total).`;
              } else {
                stateEl.textContent = 'Adauga produsul in selectie pentru a continua fluxul de testare.';
              }
            }
          };

          toggleBtn.addEventListener('click', () => {
            const result = shortlist.toggle(getProduct());
            if (!result.ok && result.error === 'max_reached') {
              showWarning('Ai ajuns la limita de 12 produse in selectie.');
              return;
            }
            clearWarning();
            refreshState();
          });

          openTestBtn.addEventListener('click', () => {
            const product = getProduct();
            if (!shortlist.isSelected(product.id)) {
              const result = shortlist.add(product);
              if (!result.ok && result.error === 'max_reached') {
                showWarning('Ai ajuns la limita de 12 produse in selectie.');
                return;
              }
            }
            clearWarning();
            refreshState();
            shortlist.openLeadModal({ intent: 'view_samples', source: 'product_detail', product });
          });

          openBookingBtn?.addEventListener('click', () => {
            clearWarning();
            shortlist.openLeadModal({ intent: 'book_call', source: 'product_detail' });
          });

          window.addEventListener('yp:shortlist-changed', refreshState);
          refreshState();
          initialized = true;
          return true;
        };

        if (initProductBindings()) {
          return;
        }

        window.addEventListener('DOMContentLoaded', () => {
          initProductBindings();
        });
        window.addEventListener('yp:shortlist-ready', () => {
          initProductBindings();
        });
      })();
    </script>
  )}
</BaseLayout>
