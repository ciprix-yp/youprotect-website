---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCatalogProducts, getCatalogProductDetailBySlug } from '../../lib/catalog';
import { getDirectusProducts, getDirectusProductBySlug } from '../../lib/directus';

export async function getStaticPaths() {
  const paths: any[] = [];
  try {
    const directusProducts = await getDirectusProducts();
    if (directusProducts && directusProducts.length > 0) {
      paths.push(...directusProducts.map((p: any) => ({
        params: { slug: p.slug }
      })));
    }
  } catch (e) {
    console.error("Directus paths error:", e);
  }
  
  try {
    const { products } = await getCatalogProducts();
    if (products && products.length > 0) {
      paths.push(...products.map((product) => ({
        params: { slug: product.slug },
      })));
    }
  } catch (e) {
    console.error("DB paths error:", e);
  }

  return paths;
}

const slug = Astro.params.slug ?? '';

let product: any = null;
let mode = 'live';
let warning: string | null = null;

try {
  const directusProduct = await getDirectusProductBySlug(slug);
  if (directusProduct) {
     product = {
        id: directusProduct.id,
        slug: directusProduct.slug,
        name: directusProduct.name,
        description: directusProduct.description || '',
        shortDescription: directusProduct.description || '',
        thumbnailUrl: directusProduct.cover_image_url || null,
        topCategory: directusProduct.category_name || 'Generala',
        professionTags: [],
        featured: directusProduct.is_featured || false,
        categoryName: directusProduct.category_name || 'Catalog general',
        categorySlug: (directusProduct.category_name || 'general').toLowerCase().replace(/\s+/g, '-'),
        producatorName: 'You Protect',
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString(),
        merchandisingTags: directusProduct.is_featured ? ['Bestseller'] : [],
        benefits: directusProduct.key_benefits || [],
        conformity: directusProduct.certifications || [],
        images: directusProduct.cover_image_url ? [{ url: directusProduct.cover_image_url, alt: directusProduct.name, type: 'primary' }] : [],
        sizeAvailabilityLabel: directusProduct.size_range ? (directusProduct.size_range.length > 2 ? `${directusProduct.size_range[0]} - ${directusProduct.size_range[directusProduct.size_range.length-1]}` : directusProduct.size_range.join(', ')) : 'La cerere',
        sizeValues: directusProduct.size_range || [],
        colorSwatches: directusProduct.color_options || [],
        countryOfOrigin: null,
        productCodes: directusProduct.supplier_sku ? [directusProduct.supplier_sku] : [],
        targetGenders: [],
        materialTags: directusProduct.materials || [],
        certificationTags: directusProduct.certifications || [],
        seasonality: directusProduct.seasonality || null,
        guarantee: '90 de zile garantie money-back pentru testare fara risc.'
      };
  } else {
      const dbResult = await getCatalogProductDetailBySlug(slug);
      product = dbResult.product;
      mode = dbResult.mode;
      warning = dbResult.warning;
  }
} catch (e) {
  const dbResult = await getCatalogProductDetailBySlug(slug);
  product = dbResult.product;
  mode = dbResult.mode;
  warning = dbResult.warning;
}

const productName = product?.name ?? 'Produs indisponibil';
const pageDescription =
  product?.shortDescription ||
  'Detalii produs You Protect: beneficii, conformitate si proces de testare fara risc.';

const updatedLabel = product
  ? new Date(product.updatedAt).toLocaleDateString('ro-RO', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

const galleryPrimaryImage = product?.images?.[0] ?? null;
const galleryExtraImages = product?.images?.slice(1, 10) ?? [];
const carouselImages = [galleryPrimaryImage, ...galleryExtraImages].filter(Boolean);

// --- Structured data (Product + BreadcrumbList) ---
const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const toAbs = (u: string | null | undefined): string | null => {
  if (!u) return null;
  try { return new URL(u, siteOrigin).href; } catch { return null; }
};
const productImages = carouselImages.map((i: any) => toAbs(i?.url)).filter(Boolean);

// Fără `offers`: prețurile nu sunt publice (model „cere ofertă") — evităm warning/spam.
const productSchema = product
  ? {
      "@context": "https://schema.org",
      "@type": "Product",
      name: product.name,
      description: pageDescription,
      ...(productImages.length ? { image: productImages } : {}),
      brand: { "@type": "Brand", name: product.producatorName || "You Protect" },
      ...(product.productCodes?.[0]
        ? { sku: product.productCodes[0], mpn: product.productCodes[0] }
        : {}),
      ...(product.categoryName ? { category: product.categoryName } : {}),
    }
  : null;

const breadcrumbSchema = product
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Acasă", item: siteOrigin.href },
        { "@type": "ListItem", position: 2, name: "Catalog", item: new URL("/produse", siteOrigin).href },
        { "@type": "ListItem", position: 3, name: product.name, item: Astro.url.href },
      ],
    }
  : null;
---

<BaseLayout title={productName} description={pageDescription} ogType="product" ogImage={galleryPrimaryImage?.url ?? undefined}>
  <section class="max-w-4xl mx-auto px-4 py-8 md:py-12">
    {mode === 'degraded' && (
      <div class="mb-8 rounded-lg border border-amber-400/30 bg-amber-400/10 px-4 py-3 text-sm text-amber-100">
        Detaliul produsului nu a putut fi sincronizat din DB in acest build. Motiv: {warning ?? 'necunoscut'}
      </div>
    )}

    {!product ? (
      <div class="rounded-xl border border-yp-white/15 bg-yp-gray/30 p-8 text-center">
        <h1 class="text-3xl text-yp-white">Produs indisponibil</h1>
        <p class="mt-3 text-yp-white/70 max-w-xl mx-auto">
          Slug-ul cerut nu exista momentan in `vw_catalog_products`.
        </p>
        <a
          href="/produse"
          class="inline-flex mt-6 px-5 py-3 rounded-md bg-yp-yellow text-yp-black font-semibold hover:bg-yp-white transition-colors"
        >
          Inapoi la catalog
        </a>
      </div>
    ) : (
      <article class="flex flex-col gap-8 md:gap-12">
        <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
        <nav class="text-[10px] uppercase tracking-widest text-yp-white/50">
          <a href="/" class="hover:text-yp-yellow transition-colors">Acasă</a>
          <span class="mx-2">/</span>
          <a href="/produse" class="hover:text-yp-yellow transition-colors">Catalog</a>
          <span class="mx-2">/</span>
          <span class="text-yp-white">{product.name}</span>
        </nav>

        <!-- 1. HEADER / TITLU -->
        <header>
          <p class="text-[10px] md:text-xs font-medium uppercase tracking-[0.2em] text-yp-yellow mb-3" data-aos="fade-down">{product.categoryName}</p>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-light text-yp-white leading-[1.1] tracking-tight mb-4" data-aos="fade-up">{product.name}</h1>
          <p class="text-sm font-light text-yp-white/60 leading-relaxed" data-aos="fade-up" data-aos-delay="100">
            {product.shortDescription || product.description || 'Echipament de protecție avansată din portofoliul You Protect.'}
          </p>
        </header>

        <!-- 2. GALERIE FOTO (CAROUSEL) -->
        {carouselImages.length > 0 ? (
          <div class="relative w-full -mx-4 px-4 sm:mx-0 sm:px-0" data-aos="fade-up" data-aos-delay="200">
            <div class="flex overflow-x-auto snap-x snap-mandatory gap-4 pb-4 hide-scrollbar">
              {carouselImages.map((img: any, i: number) => (
                <figure class="w-[85%] sm:w-[60%] md:w-full shrink-0 snap-center bg-yp-black/40 border border-yp-white/10 overflow-hidden">
                  <img
                    src={img.url}
                    alt={img.alt || product.name}
                    loading={i === 0 ? "eager" : "lazy"}
                    class="w-full aspect-[4/3] md:aspect-video h-auto max-h-[600px] object-contain p-4 md:p-8 mix-blend-luminosity hover:mix-blend-normal transition-all duration-500 bg-black/20"
                  />
                </figure>
              ))}
            </div>
            {carouselImages.length > 1 && (
              <div class="absolute bottom-6 right-8 sm:right-4 bg-yp-black/80 backdrop-blur px-3 py-1.5 text-[10px] uppercase tracking-widest text-yp-white/80 border border-yp-white/20">
                Glisează pt. mai multe vizualuri
              </div>
            )}
          </div>
        ) : (
          <div class="w-full aspect-video bg-yp-black/30 border border-yp-white/10 flex items-center justify-center" data-aos="fade-up" data-aos-delay="200">
             <p class="text-yp-white/30 text-sm font-light uppercase tracking-widest">Imagini în pregătire</p>
          </div>
        )}

        <!-- 3. CTA #1 -->
        <div class="pt-2" data-aos="zoom-in" data-aos-delay="300">
          <button
            type="button"
            onclick="window.location.href='/cere-oferta?ref=' + encodeURIComponent(window.location.pathname)"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-yp-yellow text-yp-black font-semibold text-sm uppercase tracking-widest hover:bg-yp-white transition-colors border border-transparent hover:border-yp-black"
          >
            Cere Ofertă
          </button>
        </div>

        <div class="w-full h-px bg-yp-white/10"></div>

        <!-- 4. VARIANTE (CULORI / MĂRIMI) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
          <div data-aos="fade-right">
            <h3 class="text-[11px] uppercase tracking-[0.16em] text-yp-white/40 mb-4">Nuanțe Disponibile</h3>
            {product.colorSwatches.length > 0 ? (
              <div class="flex flex-wrap gap-3">
                {product.colorSwatches.map((swatch: any) => (
                  <div class="flex items-center gap-2" title={swatch.name}>
                    <span
                      class="w-6 h-6 rounded-full shadow-inner border border-white/20"
                      style={swatch.hex ? `background-color: ${swatch.hex};` : 'background-color: transparent'}
                    ></span>
                  </div>
                ))}
              </div>
            ) : (
              <p class="text-sm font-light text-yp-white/40">Conform fișei tehnice.</p>
            )}
          </div>

          <div data-aos="fade-left">
            <h3 class="text-[11px] uppercase tracking-[0.16em] text-yp-white/40 mb-4">Plajă de Mărimi</h3>
            {product.sizeValues.length > 0 ? (
              <p class="text-lg text-yp-white font-light tracking-wide">
                {product.sizeAvailabilityLabel}
              </p>
            ) : (
              <p class="text-sm font-light text-yp-white/40">Fără mărimi discrete.</p>
            )}
          </div>
        </div>

        <div class="w-full h-px bg-yp-white/10"></div>

        <!-- 5. RECOMANDAT PENTRU -->
        {product.merchandisingTags.length > 0 && (
          <div data-aos="fade-up">
             <h3 class="text-[11px] uppercase tracking-[0.16em] text-yp-white/40 mb-4">Recomandat pentru Industriile</h3>
             <div class="flex flex-wrap gap-2">
               {product.merchandisingTags.map((tag: string) => (
                 <span class="inline-flex items-center px-4 py-2 border border-yp-white/20 bg-yp-black/40 text-xs text-yp-white/80 transition-colors cursor-default hover:border-yp-yellow/50">
                   {tag}
                 </span>
               ))}
               <span class="inline-flex items-center px-4 py-2 border border-yp-white/20 bg-yp-black/40 text-xs text-yp-white/80 transition-colors cursor-default hover:border-yp-yellow/50">
                 {product.categoryName}
               </span>
             </div>
          </div>
        )}

        <!-- 6. BENEFICII -->
        {product.benefits && product.benefits.length > 0 && (
          <div data-aos="fade-up">
            <h3 class="text-[11px] uppercase tracking-[0.16em] text-yp-white/40 mb-4">Avantaje Majore</h3>
            <ul class="space-y-4">
              {product.benefits.map((benefit: string) => (
                <li class="pl-4 border-l border-yp-yellow text-yp-white/90 font-light text-sm md:text-base leading-relaxed">
                  {benefit}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- 7. GARANȚIE -->
        <div class="p-6 bg-yp-black/40 border border-yp-white/10 flex flex-col gap-2 hover:border-yp-yellow/30 transition-colors" data-aos="fade-up">
           <div class="flex items-center gap-3 mb-2">
              <svg class="w-5 h-5 text-yp-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
              <h3 class="text-sm font-medium uppercase tracking-widest text-yp-white">Garanție Extinsă B2B</h3>
           </div>
           <p class="text-sm text-yp-white/60 font-light leading-relaxed">
             {product.guarantee} Echipăm echipe complet, iar selecția include testare pre-achiziție pentru a vă asigura de confortul sporit din teren.
           </p>
        </div>

        <!-- 8. CERTIFICĂRI -->
        {product.certificationTags?.length > 0 && (
          <div data-aos="fade-up">
             <h3 class="text-[11px] uppercase tracking-[0.16em] text-yp-white/40 mb-4">Standarde & Conformitate</h3>
             <div class="flex flex-wrap gap-4">
                {product.certificationTags.map((cert: string) => (
                  <div class="flex items-center gap-2">
                     <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                     <span class="text-sm font-light text-yp-white/80">{cert}</span>
                  </div>
                ))}
             </div>
          </div>
        )}

        <!-- 9. CTA #2 -->
        <div class="pt-8 pb-12" data-aos="zoom-in">
          <button
            type="button"
            onclick="window.location.href='/cere-oferta?ref=' + encodeURIComponent(window.location.pathname)"
            class="w-full sm:w-auto inline-flex items-center justify-center px-12 py-5 bg-yp-yellow text-yp-black font-bold text-sm uppercase tracking-[0.15em] hover:bg-white transition-colors shadow-lg"
          >
            Cere Ofertă
          </button>
        </div>

      </article>
    )}
  </section>


</BaseLayout>
