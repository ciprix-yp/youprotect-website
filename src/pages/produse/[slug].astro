---
// /produse/<slug>/: fișa unui produs publicat, pagina unei categorii (src/lib/catalog-categories.ts) sau a unei mărci
// (src/lib/catalog-brands.ts). Toate împart același prefix, ca adresele să fie cele căutate
// („/produse/incaltaminte-de-protectie/”, „/produse/mascot/”); build-ul se oprește dacă un slug e folosit de două ori.
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductDetail from '../../components/products/ProductDetail.astro';
import CategoryLanding from '../../components/products/CategoryLanding.astro';
import BrandLanding from '../../components/products/BrandLanding.astro';
import { activeCategoryPages, categoryDescription, type CategoryPage } from '../../lib/catalog-categories';
import { activeBrandPages, brandDescription, type BrandPage } from '../../lib/catalog-brands';
import { cardSrc } from '../../lib/catalog-images.js';

export async function getStaticPaths() {
  const products = await getCollection('products', ({ data }) => data.status === 'published');
  const categoryPages = activeCategoryPages(products.map((p) => p.data));
  const brandPages = activeBrandPages(products.map((p) => p.data));
  const taken = new Set(products.map((p) => p.id));
  for (const slug of [...categoryPages.map((c) => c.slug), ...brandPages.map((b) => b.slug)]) {
    if (taken.has(slug)) throw new Error(`Slug-ul „${slug}” e folosit de două ori în /produse/.`);
    taken.add(slug);
  }
  return [
    ...products.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'product' as const, entry } })),
    ...categoryPages.map((page) => ({
      params: { slug: page.slug },
      props: {
        kind: 'category' as const,
        page,
        entries: products.filter((p) => p.data.category === page.key),
        others: categoryPages.filter((o) => o.key !== page.key),
      },
    })),
    ...brandPages.map((page) => ({
      params: { slug: page.slug },
      props: {
        kind: 'brand' as const,
        page,
        entries: products.filter((p) => p.data.supplier.brand === page.brand),
        others: brandPages.filter((o) => o.slug !== page.slug),
        categoryPages,
      },
    })),
  ];
}

type Props =
  | { kind: 'product'; entry: CollectionEntry<'products'> }
  | { kind: 'category'; page: CategoryPage; entries: CollectionEntry<'products'>[]; others: CategoryPage[] }
  | {
      kind: 'brand';
      page: BrandPage;
      entries: CollectionEntry<'products'>[];
      others: BrandPage[];
      categoryPages: CategoryPage[];
    };

const props = Astro.props;
---

{props.kind === 'product' ? (
  <BaseLayout
    title={props.entry.data.seo.title}
    description={props.entry.data.seo.description}
    ogType="product"
    ogImage={props.entry.data.colours[0].images[0].src}
  >
    <ProductDetail entry={props.entry} />
  </BaseLayout>
) : props.kind === 'category' ? (
  <BaseLayout
    title={props.page.title}
    description={categoryDescription(
      props.page,
      props.entries.length,
      [...new Set(props.entries.map((e) => e.data.supplier.brand))].sort(),
    )}
    ogImage={cardSrc(props.entries[0].data.colours[0].images[0].src)}
  >
    <CategoryLanding page={props.page} entries={props.entries} others={props.others} />
  </BaseLayout>
) : (
  <BaseLayout
    title={props.page.title}
    description={brandDescription(props.page, props.entries.length)}
    ogImage={cardSrc(props.entries[0].data.colours[0].images[0].src)}
  >
    <BrandLanding page={props.page} entries={props.entries} others={props.others} categoryPages={props.categoryPages} />
  </BaseLayout>
)}
