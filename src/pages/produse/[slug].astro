---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCatalogProducts, getCatalogProductDetailBySlug } from '../../lib/catalog';

export async function getStaticPaths() {
  const { products } = await getCatalogProducts();

  return products.map((product) => ({
    params: { slug: product.slug },
  }));
}

const slug = Astro.params.slug ?? '';
const { product, mode, warning } = await getCatalogProductDetailBySlug(slug);

const productName = product?.name ?? 'Produs indisponibil';
const pageDescription =
  product?.shortDescription ||
  'Detalii produs You Protect: beneficii, conformitate si modalitate de selectie pentru mostre returnabile.';

const requestSamplesUrl = product
  ? `mailto:office@youprotect.ro?subject=${encodeURIComponent(`Vreau mostre returnabile - ${product.name}`)}`
  : 'mailto:office@youprotect.ro';

const updatedLabel = product
  ? new Date(product.updatedAt).toLocaleDateString('ro-RO', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
---

<BaseLayout title={productName} description={pageDescription}>
  <section class="max-w-7xl mx-auto px-4 py-10 md:py-14">
    {mode === 'degraded' && (
      <div class="mb-8 rounded-lg border border-amber-400/30 bg-amber-400/10 px-4 py-3 text-sm text-amber-100">
        Detaliul produsului nu a putut fi sincronizat din DB in acest build. Motiv: {warning ?? 'necunoscut'}
      </div>
    )}

    {!product ? (
      <div class="rounded-xl border border-yp-white/15 bg-yp-gray/30 p-8 text-center">
        <h1 class="text-3xl text-yp-white">Produs indisponibil</h1>
        <p class="mt-3 text-yp-white/70 max-w-xl mx-auto">
          Slug-ul cerut nu exista momentan in `vw_catalog_products`.
        </p>
        <a
          href="/produse"
          class="inline-flex mt-6 px-5 py-3 rounded-md bg-yp-yellow text-yp-black font-semibold hover:bg-yp-white transition-colors"
        >
          Inapoi la catalog
        </a>
      </div>
    ) : (
      <article class="space-y-8">
        <nav class="text-sm text-yp-white/60">
          <a href="/" class="hover:text-yp-white transition-colors">Acasa</a>
          <span class="mx-2">/</span>
          <a href="/produse" class="hover:text-yp-white transition-colors">Produse</a>
          <span class="mx-2">/</span>
          <span class="text-yp-white">{product.slug}</span>
        </nav>

        <header class="rounded-2xl border border-yp-white/15 bg-gradient-to-r from-yp-gray to-yp-black p-6 md:p-8">
          <p class="text-xs uppercase tracking-[0.2em] text-yp-yellow/80">{product.categoryName}</p>
          <h1 class="mt-2 text-4xl md:text-5xl text-yp-white leading-tight">{product.name}</h1>
          <p class="mt-3 text-yp-white/70">Producator: {product.producatorName}</p>

          {updatedLabel && (
            <p class="mt-3 text-xs text-yp-white/50">Actualizat in catalog la: {updatedLabel}</p>
          )}

          <p class="mt-6 text-yp-white/80 leading-relaxed max-w-3xl">
            {product.description || 'Descrierea completa este in curs de actualizare.'}
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={requestSamplesUrl}
              class="inline-flex items-center justify-center px-5 py-3 rounded-md bg-yp-yellow text-yp-black font-semibold hover:bg-yp-white transition-colors"
            >
              Vreau mostre returnabile
            </a>
            <a
              href="mailto:office@youprotect.ro?subject=Book%20a%20call%20You%20Protect"
              class="inline-flex items-center justify-center px-5 py-3 rounded-md border border-yp-white/25 text-yp-white hover:border-yp-yellow/40 hover:text-yp-yellow transition-colors"
            >
              Book a call
            </a>
          </div>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <section class="lg:col-span-2 rounded-xl border border-yp-white/10 bg-yp-gray/20 p-6">
            <h2 class="text-2xl text-yp-white">Beneficii</h2>
            {product.benefits.length > 0 ? (
              <ul class="mt-4 space-y-2 text-yp-white/80">
                {product.benefits.map((benefit) => (
                  <li class="flex gap-2">
                    <span class="text-yp-yellow">•</span>
                    <span>{benefit}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4 text-yp-white/70">
                Beneficiile detaliate urmeaza sa fie completate in baza de date pentru acest produs.
              </p>
            )}
          </section>

          <aside class="space-y-6">
            <section class="rounded-xl border border-yp-white/10 bg-yp-gray/20 p-6">
              <h2 class="text-xl text-yp-white">Garantie</h2>
              <p class="mt-3 text-yp-white/75 leading-relaxed">{product.guarantee}</p>
            </section>

            <section class="rounded-xl border border-yp-white/10 bg-yp-gray/20 p-6">
              <h2 class="text-xl text-yp-white">Conformitate</h2>
              {product.conformity.length > 0 ? (
                <ul class="mt-3 space-y-2 text-yp-white/80 text-sm">
                  {product.conformity.map((item) => (
                    <li class="flex gap-2">
                      <span class="text-yp-yellow">•</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="mt-3 text-yp-white/70 text-sm">
                  Informatiile de conformitate sunt in curs de sincronizare din tabelele tehnice.
                </p>
              )}
            </section>
          </aside>
        </div>
      </article>
    )}
  </section>
</BaseLayout>
