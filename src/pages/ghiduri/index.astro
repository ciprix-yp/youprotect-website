---
// /ghiduri/: lista ghidurilor din src/lib/guides.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GUIDES, GUIDES_HREF, formatGuideDate, guideHref } from '../../lib/guides';
import { jsonLd } from '../../lib/json-ld';

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Acasă', item: siteOrigin.href },
    { '@type': 'ListItem', position: 2, name: 'Ghiduri', item: new URL(GUIDES_HREF, siteOrigin).href },
  ],
};
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Ghiduri You Protect despre echipamentele de protecție',
  numberOfItems: GUIDES.length,
  itemListElement: GUIDES.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: g.heading,
    url: new URL(guideHref(g), siteOrigin).href,
  })),
};
---

<BaseLayout
  title="Ghiduri despre echipamentele de protecție"
  description="Ghiduri practice despre echipamentele de protecție pentru firme: clasele încălțămintei de protecție, clasele de vizibilitate și costul echipării pe muncitor."
>
  <script type="application/ld+json" set:html={jsonLd(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={jsonLd(itemListSchema)} />

  <section class="max-w-7xl mx-auto px-4 py-8 md:py-12">
    <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center text-sm text-yp-white/60">
      <a href="/" class="inline-block py-2 hover:text-yp-yellow transition-colors">Acasă</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-yp-white">Ghiduri</span>
    </nav>

    <header class="max-w-3xl">
      <h1 class="text-3xl md:text-4xl font-light text-yp-white leading-tight">Ghiduri despre echipamentele de protecție</h1>
      <p class="mt-4 text-base text-yp-white/80 leading-relaxed">
        Răspunsuri la întrebările pe care ni le pun clienții când aleg echipamentul pentru echipă. Fiecare ghid are sursele
        la final: standardele, legea și producătorii.
      </p>
    </header>

    <ul class="mt-10 grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {GUIDES.map((g) => (
        <li>
          <a href={guideHref(g)} class="flex flex-col h-full border border-yp-white/15 p-6 hover:border-yp-yellow transition-colors">
            <h2 class="text-lg text-yp-white font-medium leading-snug">{g.heading}</h2>
            <p class="mt-3 text-sm text-yp-white/70 leading-relaxed">{g.summary}</p>
            <p class="mt-auto pt-4 text-xs text-yp-white/50">
              Actualizat pe <time datetime={g.updated}>{formatGuideDate(g.updated)}</time>
            </p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
