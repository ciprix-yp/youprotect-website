---
// Ghid: cât costă echipamentul de protecție pentru un muncitor din construcții. Fără prețuri și fără cifre de cost
// (D-2026-11-19-03): explicăm din ce se compune costul și cum îl calculezi, iar calculatorul lucrează cu prețurile
// vizitatorului. Lista de echipamente urmează anexa 3 din HG nr. 1.048/2006, republicată.
import GuideLayout, { type GuideFaq } from '../../components/guides/GuideLayout.astro';
import RiskFreeTesting from '../../components/global/RiskFreeTesting.astro';
import { guideBySlug, guideHref } from '../../lib/guides';
import { RISK_FREE_TESTING, SITE } from '../../lib/site';
import { WORKING_DAYS_PER_YEAR } from '../../lib/tco.js';

const guide = guideBySlug('cost-echipament-protectie-muncitor');
const footwearGuide = guideHref(guideBySlug('s1p-sau-s3'));
const hiVisGuide = guideHref(guideBySlug('clase-vizibilitate-en-iso-20471'));
const CALCULATOR = '/calculator-cost-echipamente/';
const HG_1048 = 'https://legislatie.just.ro/Public/DetaliiDocument/249634';

const answer =
  'Nu există un preț unic. Costul depinde de echipamentul pe care îl cere evaluarea riscurilor, de produsele alese și de cât de des le înlocuiești. Îl calculezi pe an: pentru fiecare piesă, prețul înmulțit cu numărul de bucăți pe care le primește un om într-un an, plus timpul în care cineva comandă, primește și împarte echipamentul. Echipamentul individual de protecție îl plătește angajatorul: legea spune că se distribuie gratuit lucrătorilor.';

// Anexa 3 din HG nr. 1.048/2006: activitățile din construcții care pot cere fiecare echipament.
const equipment: { name: string; standard: string; when: string; guide?: string }[] = [
  {
    name: 'Cască de protecție',
    standard: 'EN 397',
    when: 'Lucrări pe, sub sau lângă schele și locuri de muncă la înălțime, lucrări de construcții și rutiere, montarea cofrajelor, demolări.',
  },
  {
    name: 'Încălțăminte de protecție',
    standard: 'EN ISO 20345',
    when: 'Lucrări de construcții și rutiere, montarea cofrajelor și a schelelor, demolări.',
    guide: footwearGuide,
  },
  {
    name: 'Îmbrăcăminte de avertizare',
    standard: 'EN ISO 20471',
    when: 'Lucrări în apropierea vehiculelor în mișcare, asfaltare și semnalizare rutieră.',
    guide: hiVisGuide,
  },
  {
    name: 'Echipament împotriva căderilor de la înălțime (ham)',
    standard: 'EN 361',
    when: 'Lucrări pe schele și pe suprafețe verticale sau înclinate.',
  },
  {
    name: 'Antifoane',
    standard: 'EN 352',
    when: 'Lucrul cu unelte electrice, baterea piloților.',
  },
  {
    name: 'Mănuși de protecție',
    standard: 'EN 388 (riscuri mecanice), EN ISO 10819 (vibrații)',
    when: 'Lucrul cu unelte manuale, care transmit vibrații.',
  },
  {
    name: 'Genunchiere',
    standard: 'EN 14404',
    when: 'Montarea de blocuri, plăci ceramice și pavaje.',
  },
];

const steps = [
  {
    title: 'Faci lista pe fiecare post',
    text: 'Pornești de la evaluarea riscurilor: ce piese primește un zidar, un fierar-betonist sau un operator de utilaj. Adaugă și hainele de lucru pe care le dai, chiar dacă nu sunt echipament de protecție.',
  },
  {
    title: 'Numeri bucățile pe an',
    text: 'Pentru fiecare piesă: câte primește un om într-un an. O piesă înlocuită la 6 luni înseamnă 2 bucăți pe an; una înlocuită la 4 luni, 3 bucăți.',
  },
  {
    title: 'Înmulțești cu prețul',
    text: 'Prețul pe bucată înmulțit cu bucățile pe an dă costul de achiziție pe an, pentru un om. Înmulțit cu numărul de oameni de pe post, dă costul postului.',
  },
  {
    title: 'Adaugi timpul de administrare',
    text: 'Comanda, recepția, împărțirea pe mărimi și evidența cer ore de lucru în fiecare lună. Orele pe lună, înmulțite cu costul unei ore și cu 12, intră și ele în costul pe an.',
  },
  {
    title: 'Împarți la zilele de lucru',
    text: `Costul pe an împărțit la zilele lucrătoare (calculatorul nostru folosește ${WORKING_DAYS_PER_YEAR}) îți dă costul pe zi de purtare. Așa compari corect produse cu prețuri și durate diferite.`,
  },
];

const faq: GuideFaq[] = [
  {
    q: 'Cât costă să echipezi un muncitor din construcții cu echipament de protecție?',
    a: 'Nu există un preț unic: depinde de echipamentul cerut de evaluarea riscurilor, de produsele alese și de cât de des le înlocuiești. Costul pe an pentru un muncitor este suma, pe fiecare piesă, a prețului înmulțit cu bucățile primite într-un an, la care se adaugă timpul de administrare. Calculatorul You Protect face socoteala cu prețurile tale.',
    link: { href: CALCULATOR, label: 'Deschide calculatorul de cost' },
  },
  {
    q: 'Cine plătește echipamentul de protecție al angajaților?',
    a: 'Angajatorul. Potrivit HG nr. 1.048/2006, art. 10, echipamentul individual de protecție se distribuie gratuit de angajator, care asigură și întreținerea, repararea și înlocuirea lui.',
  },
  {
    q: 'Ce echipament de protecție trebuie să primească un muncitor în construcții?',
    a: 'Cel stabilit prin evaluarea riscurilor de la locul de muncă (HG nr. 1.048/2006, art. 14). Anexa 3 a hotărârii dă, orientativ, pentru construcții: cască de protecție, încălțăminte de protecție, îmbrăcăminte de avertizare lângă vehicule în mișcare, echipament împotriva căderilor de la înălțime, antifoane, mănuși și genunchiere, în funcție de lucrare.',
  },
  {
    q: 'Cât de des se înlocuiește echipamentul de protecție?',
    a: 'Când nu mai protejează sau nu mai e igienic: angajatorul răspunde de întreținerea, repararea și înlocuirea lui (HG nr. 1.048/2006, art. 10). Cât durează fiecare piesă depinde de produs și de lucrare, așa că merită măsurat pe echipa ta, nu ghicit.',
  },
  {
    q: 'Un echipament mai scump poate ieși mai ieftin pe an?',
    a: 'Da, dacă durează destul de mult. Un produs de două ori mai scump care durează de două ori mai mult te costă la fel la cumpărare pe an și mai puțin la administrare, pentru că îl comanzi și îl împarți mai rar. Dacă durează și mai mult, iese mai ieftin. Cât durează în realitate afli doar testându-l în condițiile tale de lucru.',
    link: { href: RISK_FREE_TESTING.href, label: 'Cum funcționează testarea fără riscuri' },
  },
  {
    q: 'De unde cer ofertă pentru echipamentul de protecție al unei echipe din construcții?',
    a: `De la You Protect, din Vetiș, județul Satu Mare. Ceri ofertă de pe youprotect.ro sau la ${SITE.telephoneDisplay}, cu prețurile pentru cantitățile echipei tale, iar livrarea se face în toată România.`,
    link: { href: '/cere-oferta/', label: 'Cere ofertă' },
  },
];
---

<GuideLayout guide={guide} answer={answer} faq={faq} photo="S06">
  <section aria-labelledby="lista">
    <h2 id="lista">Ce echipament poate fi necesar pe un șantier</h2>
    <p>
      Ce primește fiecare om stabilește angajatorul, după evaluarea riscurilor
      (<a class="guide-link" href={HG_1048} rel="noopener">HG nr. 1.048/2006, art. 14</a>). Anexa 3 a hotărârii dă o listă
      orientativă de lucrări care pot cere echipament de protecție. Pentru construcții, ea arată așa:
    </p>
    <ul class="mt-6 divide-y divide-yp-white/10 border-y border-yp-white/10">
      {equipment.map((e) => (
        <li class="py-4">
          <p class="text-yp-white font-medium">
            {e.name} <span class="text-sm font-normal text-yp-white/60">· {e.standard}</span>
          </p>
          <p class="mt-1">{e.when}</p>
          {e.guide && <a class="guide-link inline-block py-1 text-sm" href={e.guide}>Ce clasă alegi</a>}
        </li>
      ))}
    </ul>
    <p class="mt-6">
      Lista nu e completă. Evaluarea ta de risc poate cere și alte echipamente, de exemplu ochelari de protecție, mănuși
      pentru substanțe chimice sau protecție respiratorie. Standardul de lângă fiecare piesă e cel după care se certifică de
      obicei; verifică-l pe eticheta și pe declarația de conformitate a produsului.
    </p>
  </section>

  <section aria-labelledby="cine-plateste">
    <h2 id="cine-plateste">Cine plătește</h2>
    <p>
      Angajatorul. HG nr. 1.048/2006 spune la art. 10 că echipamentul individual de protecție se distribuie gratuit de
      angajator, care asigură și buna lui funcționare și igiena, prin întreținere, reparații și înlocuiri. Așa că în costul
      pe an intră și înlocuirile, nu doar prima echipare.
    </p>
  </section>

  <section aria-labelledby="calcul">
    <h2 id="calcul">Cum calculezi costul pe an și pe zi de purtare</h2>
    <ol class="mt-6 space-y-4">
      {steps.map((s, i) => (
        <li class="flex gap-4">
          <span class="shrink-0 w-8 h-8 rounded-full border border-yp-yellow text-yp-yellow flex items-center justify-center font-heading font-semibold" aria-hidden="true">{i + 1}</span>
          <div>
            <p class="text-yp-white font-medium">{s.title}</p>
            <p class="mt-1">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="mt-6">
      <a class="guide-link" href={CALCULATOR}>Calculatorul de cost</a> face pașii 2–5 pentru tine: pui prețurile tale, cât
      de des înlocuiești și cât timp pierzi cu administrarea, iar rezultatul îl vezi imediat, fără date de contact.
    </p>
  </section>

  <section aria-labelledby="pret">
    <h2 id="pret">De ce prețul pe bucată nu spune tot</h2>
    <p>
      O piesă ieftină care se rupe repede o cumperi, o comanzi și o împarți de mai multe ori pe an. Un produs de două ori
      mai scump care durează de două ori mai mult te costă la fel la cumpărare și mai puțin la administrare; dacă durează și
      mai mult, iese mai ieftin. Cât durează un produs pe echipa ta nu scrie pe factură: îl afli testându-l.
    </p>
    <RiskFreeTesting variant="box" class="mt-6" />
  </section>
</GuideLayout>
