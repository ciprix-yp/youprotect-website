---
import InnerPageLayout from "../layouts/InnerPageLayout.astro";

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Acasă", item: siteOrigin.href },
    { "@type": "ListItem", position: 2, name: "Echipamente de protecție Satu Mare", item: Astro.url.href },
  ],
};
---

<InnerPageLayout
  title="Echipamente de protecție Satu Mare — furnizor B2B pentru firme"
  description="Furnizor de echipamente de protecție (SSM) și haine de lucru personalizate pentru companii din Satu Mare și nord-vestul României. Consultanță locală, ofertă personalizată și livrare în toată țara."
  heroTitle="Echipamente de protecție în Satu Mare"
  heroSubtitle="Suntem partenerul local pentru companiile din Satu Mare și din nord-vestul României care vor să își echipeze oamenii corect — cu echipamente de protecție, haine de lucru și articole personalizate alese în funcție de activitate, nu generic."
  breadcrumb="Satu Mare"
  heroImage="/hero-youprotect-highvis.jpg"
  ctaHeading="Discutăm despre echipa ta din Satu Mare?"
  ctaSubheading="Consultanță gratuită, ofertă personalizată și produse potrivite activității tale."
  ctaButtonText="Programează o discuție"
  ctaSecondaryButtonText="Vezi catalogul"
  ctaSecondaryButtonLink="/produse"
  ctaMicrocopy="Fără obligații. Discutăm despre activitatea, riscurile și nevoile reale ale echipei tale."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="py-24 lg:py-32 bg-[#0a0a0a] border-y border-white/5">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col md:flex-row gap-16 md:gap-24">
        <div class="md:w-1/3 shrink-0">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-light text-white leading-tight sticky top-32" data-aos="fade-up">
            Partener local, <br /><span class="font-semibold text-yp-yellow">standard național.</span>
          </h2>
        </div>
        <div class="md:w-2/3 space-y-8 text-lg md:text-xl text-neutral-300 font-light leading-relaxed">
          <p data-aos="fade-up" data-aos-delay="100">
            You Protect are baza în Vetiș, județul Satu Mare, și lucrează cu firme din întreaga regiune de nord-vest — construcții, producție, logistică, energie și servicii tehnice. Faptul că suntem aproape înseamnă recomandări rapide, comunicare directă și o înțelegere reală a felului în care lucrează echipele de pe teren.
          </p>
          <p data-aos="fade-up" data-aos-delay="150">
            Nu vindem doar produse dintr-un raft. Pornim de la activitatea ta, de la riscurile concrete și de la imaginea pe care vrei să o transmită echipa, apoi recomandăm echipamentele de protecție și hainele de lucru potrivite — cu personalizare și planificarea comenzilor recurente atunci când e nevoie.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-[#050505]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="w-12 h-1 bg-yp-yellow mb-8" data-aos="fade-up"></div>
      <h2 class="text-3xl md:text-4xl font-light text-white mb-12" data-aos="fade-up">
        Ce livrăm firmelor din <span class="font-semibold text-yp-yellow">Satu Mare și nord-vest</span>
      </h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="border border-white/10 rounded-[4px] p-8 bg-white/5" data-aos="fade-up" data-aos-delay="100">
          <h3 class="text-xl font-medium text-white mb-3">Echipamente de protecție (EPI)</h3>
          <p class="text-neutral-400 font-light">Încălțăminte de protecție, mănuși, protecția capului, ochilor și auzului — conforme și potrivite mediului real de lucru.</p>
        </div>
        <div class="border border-white/10 rounded-[4px] p-8 bg-white/5" data-aos="fade-up" data-aos-delay="200">
          <h3 class="text-xl font-medium text-white mb-3">Haine de lucru personalizate</h3>
          <p class="text-neutral-400 font-light">Salopete, jachete și uniforme rezistente, personalizate cu identitatea companiei tale, pentru o imagine profesională în teren.</p>
        </div>
        <div class="border border-white/10 rounded-[4px] p-8 bg-white/5" data-aos="fade-up" data-aos-delay="300">
          <h3 class="text-xl font-medium text-white mb-3">Consultanță + ofertă</h3>
          <p class="text-neutral-400 font-light">Te ajutăm să clarifici ce se potrivește echipei tale înainte de decizie, cu ofertă personalizată și comenzi recurente planificate.</p>
        </div>
      </div>
      <div class="mt-12" data-aos="fade-up">
        <a href="/produse" class="inline-flex items-center gap-2 text-yp-yellow hover:text-white transition-colors font-medium">
          Vezi catalogul complet →
        </a>
      </div>
    </div>
  </section>
</InnerPageLayout>
