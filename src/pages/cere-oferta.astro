---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import MultiStepForm from "../components/forms/MultiStepForm";
import RiskFreeTesting from "../components/global/RiskFreeTesting.astro";

// Produsele publicate, pentru /cere-oferta/?produs=<slug> (link-ul „Cere ofertă” de pe fișa de produs).
const products = Object.fromEntries(
  (await getCollection("products", ({ data }) => data.status === "published")).map((p) => [p.id, p.data.name]),
);
---

<BaseLayout
  title="Cere ofertă pentru echipa ta"
  description="Răspunde la câteva întrebări și primești în cel mult 48 de ore o ofertă de echipamente de protecție potrivită echipei tale."
>
  <div class="h-24 md:h-32"></div>

  <section class="pt-4 pb-12 md:py-20 relative overflow-hidden">
    <!-- Backgound Elements -->
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-yp-yellow/10 rounded-full blur-[100px] -z-10 mix-blend-screen pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-white/5 rounded-full blur-[100px] -z-10 mix-blend-screen pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-12" data-aos="fade-up">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-semibold text-white mb-6">
          Cere o <span class="text-yp-yellow">ofertă</span>
        </h1>
        <p class="text-lg md:text-xl text-neutral-400">
          Durează cam 2 minute. Din răspunsurile tale pregătim o ofertă potrivită echipei, fără zeci de mesaje de clarificare.
        </p>
        <RiskFreeTesting variant="inline" class="mt-6 max-w-xl mx-auto text-left" />
      </div>

      <div data-aos="fade-up" data-aos-delay="100">
        <MultiStepForm intent="quote" products={products} client:load />
      </div>
    </div>
  </section>
</BaseLayout>
