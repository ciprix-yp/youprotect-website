---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import MultiStepForm from "../components/forms/MultiStepForm";
import RiskFreeTesting from "../components/global/RiskFreeTesting.astro";
import { whatsappHref } from "../lib/whatsapp";
import { RESPONSE_TIME } from "../lib/site";

// Produsele publicate, pentru /cere-oferta/?produs=<slug> (link-ul „Cere ofertă” de pe fișa de produs).
const products = Object.fromEntries(
  (await getCollection("products", ({ data }) => data.status === "published")).map((p) => [p.id, p.data.name]),
);
---

<BaseLayout
  title="Cere ofertă pentru echipa ta"
  description={`Răspunde la câteva întrebări și primești ${RESPONSE_TIME} o ofertă de echipamente de protecție potrivită echipei tale.`}
>
  <section class="pt-8 pb-12 md:pt-12 md:pb-20">

    <div class="max-w-7xl mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h1 class="font-heading text-3xl font-light leading-tight text-yp-white md:text-4xl mb-4">
          Cere o ofertă
        </h1>
        <p class="text-lg md:text-xl text-neutral-400">
          Durează cam 2 minute. Din răspunsurile tale pregătim o ofertă potrivită echipei, fără zeci de mesaje de clarificare.
        </p>
        <p class="mt-3 text-sm text-neutral-400">
          Preferi să ne scrii direct?
          <a href={whatsappHref(undefined, "Bună! Aș vrea o ofertă pentru echipamente de protecție.")} target="_blank" rel="noopener noreferrer" data-track-location="formular-whatsapp" class="inline-flex min-h-11 items-center font-medium text-yp-yellow underline underline-offset-4 hover:text-white">Scrie-ne pe WhatsApp, la 0742 226 127</a>
        </p>
        <RiskFreeTesting variant="inline" class="mt-6 max-w-xl mx-auto text-left" />
      </div>

      <div>
        <MultiStepForm intent="quote" products={products} client:load />
      </div>
    </div>
  </section>
</BaseLayout>
