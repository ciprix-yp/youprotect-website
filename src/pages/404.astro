---
// Pagina 404. Fără ea, Cloudflare Pages răspunde 200 cu homepage-ul la orice URL inexistent (soft 404).
import BaseLayout from "../layouts/BaseLayout.astro";
import { btnPrimary, btnSecondary, pageIntro, pageTitle } from "../lib/ui";
---

<BaseLayout title="Pagina nu a fost găsită" description="Pagina căutată nu există sau a fost mutată." noindex>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-24 text-center md:pt-24">
    <p class="mb-4 text-sm font-medium text-yp-yellow">Eroare 404</p>
    <h1 class={pageTitle}>Pagina nu a fost găsită</h1>
    <p class={pageIntro}>
      Adresa nu mai există sau a fost mutată. Poți căuta în catalog sau ne poți spune direct de ce are nevoie echipa ta.
    </p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/produse/" class={btnPrimary}>Vezi catalogul</a>
      <a href="/cere-oferta/" class={btnSecondary}>Cere ofertă</a>
    </div>
  </section>
</BaseLayout>
