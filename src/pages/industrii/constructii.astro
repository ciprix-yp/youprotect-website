---
import InnerPageLayout from "../../layouts/InnerPageLayout.astro";

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Acasă", item: siteOrigin.href },
    { "@type": "ListItem", position: 2, name: "Industrii", item: new URL("/industrii", siteOrigin).href },
    { "@type": "ListItem", position: 3, name: "Construcții", item: Astro.url.href },
  ],
};
---

<InnerPageLayout
  title="Echipamente de protecție pentru construcții"
  description="Echipamente de protecție și haine de lucru pentru construcții: bocanci S3, căști, mănuși, vestă hi-vis. You Protect recomandă seturi potrivite șantierului, cu livrare în toată România."
  heroTitle="Echipare pentru construcții"
  heroSubtitle="Pe șantier, echipamentul nu e o formalitate — e diferența dintre o zi de muncă sigură și un accident. Selectăm echipamente de protecție rezistente, conforme și confortabile pentru întreaga echipă."
  breadcrumb="Construcții"
  heroImage="/hero-youprotect-highvis.jpg"
  ctaHeading="Echipezi o echipă de șantier?"
  ctaSubheading="Îți recomandăm setul complet, conform riscurilor reale din teren."
  ctaButtonText="Programează o discuție"
  ctaSecondaryButtonText="Vezi catalogul"
  ctaSecondaryButtonLink="/produse"
  ctaMicrocopy="Consultanță gratuită, fără obligații."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="py-24 lg:py-32 bg-[#0a0a0a] border-y border-white/5">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col md:flex-row gap-16 md:gap-24">
        <div class="md:w-1/3 shrink-0">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-light text-white leading-tight sticky top-32" data-aos="fade-up">
            Protecție reală <br /><span class="font-semibold text-yp-yellow">pe șantier.</span>
          </h2>
        </div>
        <div class="md:w-2/3 space-y-8 text-lg md:text-xl text-neutral-300 font-light leading-relaxed">
          <p data-aos="fade-up" data-aos-delay="100">
            Construcțiile expun oamenii la riscuri multiple: căderi de obiecte, suprafețe alunecoase, umezeală, tăieturi și praf. De aceea echipamentul trebuie ales pe categorii clare de protecție, nu pe cel mai mic preț.
          </p>
          <ul class="space-y-3 text-neutral-300" data-aos="fade-up" data-aos-delay="150">
            <li>• Bocanci de protecție S3 (rezistență la apă, talpă și bombeu conforme)</li>
            <li>• Căști de protecție și protecția auzului</li>
            <li>• Mănuși pentru manipulare și impact</li>
            <li>• Îmbrăcăminte hi-vis pentru vizibilitate</li>
            <li>• Salopete și jachete rezistente, personalizabile</li>
          </ul>
        </div>
      </div>
      <div class="mt-12" data-aos="fade-up">
        <a href="/produse" class="inline-flex items-center gap-2 text-yp-yellow hover:text-white transition-colors font-medium">
          Vezi catalogul complet →
        </a>
      </div>
    </div>
  </section>
</InnerPageLayout>
