---
import InnerPageLayout from "../../layouts/InnerPageLayout.astro";
import EquipmentList from '../../components/industries/EquipmentList.astro';

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Acasă", item: siteOrigin.href },
    { "@type": "ListItem", position: 2, name: "Industrii", item: new URL("/industrii", siteOrigin).href },
    { "@type": "ListItem", position: 3, name: "Construcții", item: Astro.url.href },
  ],
};
---

<InnerPageLayout
  title="Echipamente de protecție pentru construcții"
  description="Echipamente de protecție pentru construcții: încălțăminte S3 și S7, geci reflectorizante, haine de lucru personalizate cu logo. Livrare în toată România."
  heroTitle="Echipare pentru construcții"
  heroSubtitle="Pe șantier, echipamentul nu e o formalitate — e diferența dintre o zi de muncă sigură și un accident. Selectăm echipamente de protecție rezistente, conforme și confortabile pentru întreaga echipă."
  breadcrumb="Construcții"
  heroImage="/hero-youprotect-highvis.webp"
  ctaHeading="Echipezi o echipă de șantier?"
  ctaSubheading="Îți recomandăm setul complet, conform riscurilor reale din teren."
  ctaButtonText="Programează o discuție"
  ctaSecondaryButtonText="Vezi catalogul"
  ctaSecondaryButtonLink="/produse/"
  ctaMicrocopy="Consultanță gratuită, fără obligații."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="py-24 lg:py-32 bg-[#0a0a0a] border-y border-white/5">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex flex-col md:flex-row gap-16 md:gap-24">
        <div class="md:w-1/3 shrink-0">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-light text-white leading-tight sticky top-32">
            Protecție reală <br />pe șantier.
          </h2>
        </div>
        <div class="md:w-2/3 space-y-8 text-lg md:text-xl text-neutral-300 leading-relaxed">
          <p>
            Construcțiile expun oamenii la riscuri multiple: căderi de obiecte, suprafețe alunecoase, umezeală, tăieturi și praf. De aceea echipamentul trebuie ales pe categorii clare de protecție, nu pe cel mai mic preț.
          </p>
          <EquipmentList
            items={[
              { text: 'Bocanci de protecție S3 (rezistență la apă, talpă și bombeu conforme)', category: 'incaltaminte' },
              { text: 'Căști de protecție', category: 'casti-protectie' },
              { text: 'Protecția auzului (antifoane)', category: 'antifoane' },
              { text: 'Mănuși pentru manipulare și impact', category: 'manusi' },
              { text: 'Hamuri și lonje pentru lucrul la înălțime', category: 'protectie-cadere' },
              { text: 'Măști de protecție pentru praf', category: 'protectia-respiratorie' },
              { text: 'Îmbrăcăminte hi-vis pentru vizibilitate', category: 'reflectorizante' },
              { text: 'Salopete și pantaloni de lucru, personalizabili cu logo', category: 'pantaloni' },
              { text: 'Geci și jachete de lucru', category: 'geci-jachete' },
            ]}
          />
          <p class="text-base text-neutral-400">
            Ce e pe listă și nu găsești încă în catalog putem aduce la cerere:
            <a href="/cere-oferta/" class="text-yp-yellow underline underline-offset-4 hover:text-white">scrie-ne în cererea de ofertă</a>
            ce îți trebuie.
          </p>
        </div>
      </div>
      <div class="mt-12">
        <a href="/produse/" class="inline-flex items-center gap-2 text-yp-yellow hover:text-white transition-colors font-medium">
          Vezi catalogul complet
        </a>
      </div>
    </div>
  </section>
</InnerPageLayout>
