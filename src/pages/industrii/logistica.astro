---
import InnerPageLayout from "../../layouts/InnerPageLayout.astro";

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Acasă", item: siteOrigin.href },
    { "@type": "ListItem", position: 2, name: "Industrii", item: new URL("/industrii", siteOrigin).href },
    { "@type": "ListItem", position: 3, name: "Logistică", item: Astro.url.href },
  ],
};
---

<InnerPageLayout
  title="Echipamente de protecție pentru logistică și depozite"
  description="Echipamente de protecție și haine de lucru pentru logistică și depozite: încălțăminte confortabilă pentru ture lungi, hi-vis pentru trafic intern, mănuși de manipulare. Livrare în toată România."
  heroTitle="Echipare pentru logistică"
  heroSubtitle="În depozite și logistică, oamenii sunt pe picioare ore întregi, în trafic intern de stivuitoare și manipulare continuă. Echipamentul potrivit înseamnă confort, vizibilitate și siguranță pe tot parcursul turei."
  breadcrumb="Logistică"
  heroImage="/hero-youprotect-highvis.jpg"
  ctaHeading="Echipezi o echipă de depozit?"
  ctaSubheading="Recomandăm seturi gândite pentru ture lungi și trafic intern."
  ctaButtonText="Programează o discuție"
  ctaSecondaryButtonText="Vezi catalogul"
  ctaSecondaryButtonLink="/produse"
  ctaMicrocopy="Consultanță gratuită, fără obligații."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="py-24 lg:py-32 bg-[#0a0a0a] border-y border-white/5">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col md:flex-row gap-16 md:gap-24">
        <div class="md:w-1/3 shrink-0">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-light text-white leading-tight sticky top-32" data-aos="fade-up">
            Confort și <br /><span class="font-semibold text-yp-yellow">vizibilitate.</span>
          </h2>
        </div>
        <div class="md:w-2/3 space-y-8 text-lg md:text-xl text-neutral-300 font-light leading-relaxed">
          <p data-aos="fade-up" data-aos-delay="100">
            Productivitatea în depozit depinde de oameni care se mișcă ușor și sigur. Un echipament prost ales obosește echipa și crește riscul de accidente în zonele cu trafic de stivuitoare.
          </p>
          <ul class="space-y-3 text-neutral-300" data-aos="fade-up" data-aos-delay="150">
            <li>• Încălțăminte de protecție ușoară, confortabilă pentru ture lungi</li>
            <li>• Vestă și îmbrăcăminte hi-vis pentru trafic intern</li>
            <li>• Mănuși de manipulare cu grip și protecție</li>
            <li>• Haine de lucru lejere, personalizabile cu logo</li>
          </ul>
        </div>
      </div>
      <div class="mt-12" data-aos="fade-up">
        <a href="/produse" class="inline-flex items-center gap-2 text-yp-yellow hover:text-white transition-colors font-medium">
          Vezi catalogul complet →
        </a>
      </div>
    </div>
  </section>
</InnerPageLayout>
