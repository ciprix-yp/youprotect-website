---
import BaseLayout from "../layouts/BaseLayout.astro";
import TCOCalculator from "../components/calculator/TCOCalculator.tsx";
---

<BaseLayout
  title="Calculator de cost pentru echipamente de protecție"
  description="Calculează cât te costă pe an echipamentele de protecție și hainele de lucru, cu înlocuiri și timp de administrare. Gratuit, fără date de contact."
>
  <section class="pt-8 pb-12 md:pt-12 md:pb-20">

    <div class="max-w-7xl mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h1 class="font-heading text-3xl font-light leading-tight text-yp-white md:text-4xl mb-4">
          Cât te costă de fapt echipamentele de protecție
        </h1>
        <p class="text-lg md:text-xl text-neutral-400">
          Prețul de pe factură e doar o parte. Pune prețurile tale, cât de des le înlocuiești și cât timp pierzi cu ele, apoi compară cu produse care durează mai mult. Rezultatul îl vezi imediat, fără date de contact.
        </p>
      </div>

      <TCOCalculator client:load />

      <p class="max-w-3xl mx-auto mt-12 text-center text-neutral-400">
        Nu știi ce echipament să pui în calcul?
        <a href="/ghiduri/cost-echipament-protectie-muncitor/" class="inline-flex min-h-11 items-center text-yp-yellow underline underline-offset-4 hover:text-white">Citește ghidul despre costul echipamentului pe muncitor</a>
      </p>
    </div>
  </section>
</BaseLayout>
