---
import BaseLayout from "../layouts/BaseLayout.astro";
import MultiStepForm from "../components/forms/MultiStepForm";
import RiskFreeTesting from "../components/global/RiskFreeTesting.astro";
import { whatsappHref } from "../lib/whatsapp";
import { CTA_DISCUSS } from "../lib/site";
---

<BaseLayout
  title={CTA_DISCUSS}
  description="Răspunde la câteva întrebări, apoi alegi ora unei discuții cu You Protect despre echipamentele potrivite echipei tale."
>
  <section class="pt-8 pb-12 md:pt-12 md:pb-20">

    <div class="max-w-7xl mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h1 class="font-heading text-3xl font-light leading-tight text-yp-white md:text-4xl md:leading-10 mb-4">
          {CTA_DISCUSS}
        </h1>
        <p class="text-lg md:text-xl text-neutral-400">
          Răspunde la câteva întrebări, ca să venim la discuție cu recomandări pentru echipa ta. La final alegi ora din calendar.
        </p>
        <p class="mt-3 text-sm text-neutral-400">
          Preferi să ne scrii direct?
          <a href={whatsappHref(undefined, "Bună! Aș vrea să discutăm despre echiparea echipei mele.")} target="_blank" rel="noopener noreferrer" data-track-location="formular-whatsapp" class="inline-flex min-h-11 items-center font-medium text-yp-yellow underline underline-offset-4 hover:text-white">Scrie-ne pe WhatsApp, la 0742 226 127</a>
        </p>
        <RiskFreeTesting variant="inline" class="mt-6 max-w-xl mx-auto text-left" />
      </div>

      <div>
        <MultiStepForm intent="consultation" client:load />
      </div>
    </div>
  </section>
</BaseLayout>
