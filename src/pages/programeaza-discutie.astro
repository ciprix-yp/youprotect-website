---
import BaseLayout from "../layouts/BaseLayout.astro";
import MultiStepForm from "../components/forms/MultiStepForm";
---

<BaseLayout 
  title="Programează o Discuție" 
  description="Contactează echipa You Protect pentru a găsi cele mai bune soluții de echipamente pentru compania ta."
>
  <div class="h-24 md:h-32"></div>
  
  <section class="py-12 md:py-20 relative overflow-hidden">
    <!-- Backgound Elements -->
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-yp-yellow/10 rounded-full blur-[100px] -z-10 mix-blend-screen pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-white/5 rounded-full blur-[100px] -z-10 mix-blend-screen pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-12" data-aos="fade-up">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-semibold text-white mb-6">
          Programează o <span class="text-yp-yellow">Discuție</span>
        </h1>
        <p class="text-lg md:text-xl text-neutral-400">
          Răspunde la câteva întrebări pentru a ne ajuta să pregătim recomandări personalizate înainte de a discuta.
        </p>
      </div>

      <div data-aos="fade-up" data-aos-delay="100">
        <MultiStepForm intent="consultation" client:load />
      </div>
    </div>
  </section>
</BaseLayout>
