---
import BaseLayout from "../layouts/BaseLayout.astro";
import { RESPONSE_TIME } from "../lib/site";
// Pagina e statică; mesajul și calendarul depind de ?intent= și se aleg în browser.
// Datele pentru calendar vin din sessionStorage (cheia BOOKING_PREFILL_KEY din MultiStepForm), nu din URL:
// nume, email și telefon nu ajung în istoricul browserului sau în loguri.
---

<BaseLayout
  title="Cererea a fost trimisă"
  description="Îți mulțumim! Echipa You Protect revine în cel mai scurt timp."
  noindex
>
  <section class="pt-8 pb-12 md:pt-12 md:pb-20 min-h-[60vh] flex flex-col justify-center">

    <div class="max-w-4xl mx-auto px-4 w-full text-center">
      <div>
        <div class="w-20 h-20 bg-yp-yellow/10 text-yp-yellow rounded-full flex items-center justify-center mx-auto mb-8 border border-yp-yellow/20">
          <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>

        <h1 class="font-heading text-3xl font-light leading-tight text-yp-white md:text-4xl md:leading-10 mb-4">
          Cererea a fost trimisă
        </h1>

        <p id="msg-default" class="text-lg text-neutral-300 max-w-2xl mx-auto mb-12">
          Mulțumim! Revenim în curând cu informațiile cerute.
        </p>
        <p id="msg-quote" class="hidden text-lg text-neutral-300 max-w-2xl mx-auto mb-12">
          Pregătim oferta pentru echipa ta și ți-o trimitem {RESPONSE_TIME}. Dacă avem nevoie de o clarificare, te
          sunăm scurt înainte.
        </p>
        <div id="msg-consultation" class="hidden text-lg text-neutral-300 max-w-2xl mx-auto mb-12">
          <p>Revenim {RESPONSE_TIME} cu o propunere pentru discuție și câteva recomandări pentru echipa ta.</p>
          <p class="mt-6 font-semibold text-white">Dacă vrei, alege direct o oră liberă din calendarul de mai jos.</p>
        </div>
      </div>

      <div id="booking-section" class="hidden mt-12 w-full">
        <h2 class="text-2xl text-white font-medium mb-6">Alege ziua și ora discuției</h2>
        <div class="w-full bg-yp-black border border-white/5 rounded-xl overflow-hidden shadow-2xl">
          <div style="width:100%;height:100%;overflow:scroll" id="my-cal-inline"></div>
        </div>
      </div>

      <div class="mt-12 flex flex-col sm:flex-row justify-center gap-4">
        <a href="/produse/" class="px-8 py-3 min-h-[44px] bg-yp-yellow text-yp-black rounded-sm font-medium hover:bg-white transition-colors">
          Vezi catalogul
        </a>
        <a href="/" class="px-8 py-3 min-h-[44px] bg-white/5 border border-white/10 text-white rounded-sm font-medium hover:bg-white/10 transition-colors">
          Înapoi acasă
        </a>
      </div>
    </div>
  </section>

  <script>
    import { BOOKING_PREFILL_KEY as PREFILL_KEY } from "../lib/session-keys.js";
    const intent = new URLSearchParams(window.location.search).get("intent");

    function show(id: string) {
      document.getElementById(id)?.classList.remove("hidden");
    }

    function readPrefill(): { name?: string; email?: string; phone?: string; company?: string } {
      try {
        const raw = sessionStorage.getItem(PREFILL_KEY);
        sessionStorage.removeItem(PREFILL_KEY);
        const data = raw ? JSON.parse(raw) : {};
        return typeof data === "object" && data !== null ? data : {};
      } catch {
        return {};
      }
    }

    // Embed-ul oficial Cal.com, încărcat doar pentru programări (nu la cererile de ofertă).
    function loadCalendar() {
      const prefill = readPrefill();
      const str = (v: unknown) => (typeof v === "string" ? v.slice(0, 200) : "");
      const w = window as any;
      (function (C: any, A: string, L: string) {
        const p = function (a: any, ar: any) { a.q.push(ar); };
        const d = C.document;
        C.Cal = C.Cal || function () {
          const cal = C.Cal;
          const ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement("script")).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api: any = function () { p(api, arguments); };
            const namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === "string") {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ["initNamespace", namespace]);
            } else p(cal, ar);
            return;
          }
          p(cal, ar);
        };
      })(window, "https://app.cal.com/embed/embed.js", "init");

      w.Cal("init", "30min", { origin: "https://cal.eu" });
      w.Cal.ns["30min"]("inline", {
        elementOrSelector: "#my-cal-inline",
        config: { layout: "month_view", theme: "dark" },
        calLink: "you-protect-wwd6jy/30min",
        prefill: {
          name: str(prefill.name),
          email: str(prefill.email),
          notes: `Companie: ${str(prefill.company)}\nTelefon: ${str(prefill.phone)}`,
        },
      });
      w.Cal.ns["30min"]("ui", { theme: "dark", hideEventTypeDetails: false, layout: "month_view" });
    }

    if (intent === "consultation") {
      document.getElementById("msg-default")?.classList.add("hidden");
      show("msg-consultation");
      show("booking-section");
      loadCalendar();
    } else if (intent === "quote") {
      document.getElementById("msg-default")?.classList.add("hidden");
      show("msg-quote");
    }
  </script>
</BaseLayout>
