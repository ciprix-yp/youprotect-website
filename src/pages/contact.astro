---
// Pagina de Contact (CONV-004, aprobată de owner pe 20.11.2026): canalele directe (telefon, WhatsApp, email), showroom-ul
// cu indicații, drumul spre cele două formulare și datele firmei pentru furnizori. Datele vin toate din SITE
// (src/lib/site.ts), ca footer-ul, schema și pagina să spună același lucru. Fără formular nou: cererile intră tot prin
// /cere-oferta/ și /programeaza-discutie/, deci în CRM au același format.
// Fără hartă încorporată: un iframe Google Maps ar pune cookie-uri fără acord și ar cere excepții în CSP (_headers).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/global/PageHeader.astro';
import ContactIcon from '../components/global/ContactIcon.astro';
import { SITE, LEGAL_EUID, CTA_DISCUSS } from '../lib/site';
import { whatsappHref } from '../lib/whatsapp';
import { jsonLd } from '../lib/json-ld';
import { btnPrimary, btnSecondary, pageContainer, sectionTitle } from '../lib/ui';

const hours = 'Luni–vineri, 09:00–17:00';
const address = `${SITE.address.streetAddress}, ${SITE.address.postalCode} ${SITE.address.addressLocality}, județul ${SITE.address.addressRegion}`;

const channels = [
  {
    icon: 'phone',
    label: 'Telefon',
    value: SITE.telephoneDisplay,
    href: `tel:${SITE.telephone}`,
    hint: hours,
    external: false,
  },
  {
    icon: 'whatsapp',
    label: 'WhatsApp',
    value: SITE.telephoneDisplay,
    href: whatsappHref(),
    hint: 'Poți trimite poze cu ce poartă echipa ta acum sau o listă de produse.',
    external: true,
  },
  {
    icon: 'email',
    label: 'Email',
    value: SITE.email,
    href: `mailto:${SITE.email}`,
    hint: 'Pentru liste lungi, caiete de sarcini sau alte documente.',
    external: false,
  },
] as const;

const company = [
  { term: 'Denumire', value: SITE.legal.name },
  { term: 'CUI', value: SITE.legal.cui },
  { term: 'Nr. Reg. Com.', value: SITE.legal.regCom },
  { term: 'EUID', value: LEGAL_EUID },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      url: Astro.url.href,
      name: 'Contact You Protect',
      mainEntity: { '@id': `${SITE.url}/#localbusiness` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Acasă', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Contact', item: Astro.url.href },
      ],
    },
  ],
};

const link = 'underline decoration-yp-yellow/60 underline-offset-4 transition-colors hover:text-yp-yellow';
---

<BaseLayout
  title="Contact: telefon, WhatsApp, showroom în Satu Mare"
  description="Sună-ne la 0742 226 127, scrie-ne pe WhatsApp sau pe email ori vino în showroom-ul cu cabină de probă din Vetiș, Satu Mare. Luni–vineri, 09:00–17:00."
>
  <script type="application/ld+json" set:html={jsonLd(schema)} />

  <PageHeader
    title="Contact You Protect"
    intro="Sună-ne, scrie-ne pe WhatsApp sau pe email ori treci prin showroom-ul din Vetiș, Satu Mare. Programul e de luni până vineri, între 09:00 și 17:00."
    crumbs={[{ label: 'Contact' }]}
  />

  <section class="border-b border-yp-white/10" aria-label="Canale de contact și showroom">
    <div class:list={[pageContainer, 'grid gap-12 py-10 md:py-14 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-16']}>
      <!-- Canalele directe: tot rândul e link, ca pe telefon să ajungă un singur tap. -->
      <div>
        <h2 class={sectionTitle}>Vorbește direct cu noi</h2>
        <ul class="divide-y divide-yp-white/10 border-y border-yp-white/10">
          {channels.map((c) => (
            <li>
              <a
                href={c.href}
                data-track-location="pagina-contact"
                {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                class="group flex items-start gap-4 py-5 transition-colors"
              >
                <span class="mt-1 grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-yp-white/15 text-yp-yellow transition-colors group-hover:border-yp-yellow/60">
                  <ContactIcon name={c.icon} class="h-5 w-5" />
                </span>
                <span class="min-w-0">
                  <span class="block text-sm text-yp-white/60">{c.label}</span>
                  <span class="block break-words font-heading text-2xl font-light tracking-[0.01em] text-yp-white transition-colors group-hover:text-yp-yellow md:text-3xl">
                    {c.value}
                  </span>
                  <span class="mt-1 block text-sm leading-relaxed text-yp-white/70">{c.hint}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Showroom-ul: adresa, programul și indicațiile. -->
      <div>
        <h2 class={sectionTitle}>Showroom cu cabină de probă, în Vetiș</h2>
        <p class="text-base leading-relaxed text-yp-white/75">
          Poți veni să vezi produsele și să le probezi înainte de comandă. Așa alegi mărimea și modelul pentru echipă, nu
          doar din poze.
        </p>
        <dl class="mt-6 divide-y divide-yp-white/10 border-y border-yp-white/10 text-base">
          <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-4 py-4">
            <dt class="text-yp-white/60">Adresa</dt>
            <dd class="text-yp-white">{address}</dd>
          </div>
          <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-4 py-4">
            <dt class="text-yp-white/60">Program</dt>
            <dd class="text-yp-white">
              {hours}<br />
              <span class="text-yp-white/70">Sâmbătă și duminică: închis</span>
            </dd>
          </div>
        </dl>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href={SITE.mapsUrl} target="_blank" rel="noopener noreferrer" class:list={[btnSecondary, 'gap-2']}>
            <ContactIcon name="pin" class="h-4 w-4" />
            Deschide în Google Maps
          </a>
          <a href={SITE.wazeUrl} target="_blank" rel="noopener noreferrer" class={btnSecondary}>Deschide în Waze</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Drumul spre formulare: aceleași nume ca butoanele de pe restul site-ului. -->
  <section class="border-b border-yp-white/10" aria-labelledby="ce-cauti">
    <div class:list={[pageContainer, 'py-10 md:py-14']}>
      <h2 id="ce-cauti" class={sectionTitle}>Ai nevoie de o ofertă sau de o recomandare?</h2>
      <div class="grid gap-10 md:grid-cols-2 md:gap-16">
        <div class="border-t border-yp-white/10 pt-6">
          <h3 class="font-heading text-lg font-light text-yp-white">Știi ce produse vrei</h3>
          <p class="mt-3 max-w-prose text-base leading-relaxed text-yp-white/75">
            Spune-ne ce produse și câte bucăți îți trebuie. Poți strânge mai multe produse din
            <a href="/produse/" class={link}>catalog</a> în lista de ofertă și ceri prețul pentru toate odată.
          </p>
          <a href="/cere-oferta/" data-track-location="pagina-contact" class:list={[btnPrimary, 'mt-6']}>Cere ofertă</a>
        </div>
        <div class="border-t border-yp-white/10 pt-6">
          <h3 class="font-heading text-lg font-light text-yp-white">Vrei să alegem împreună</h3>
          <p class="mt-3 max-w-prose text-base leading-relaxed text-yp-white/75">
            Răspunzi la câteva întrebări despre echipă și activitate, apoi alegi ora discuției din calendar. Venim la
            discuție cu recomandări pentru oamenii tăi.
          </p>
          <a href="/programeaza-discutie/" data-track-location="pagina-contact" class:list={[btnSecondary, 'mt-6']}>{CTA_DISCUSS}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Datele firmei, pentru înregistrarea ca furnizor. Adresa de sediu din Registrul Comerțului nu e aici: e în curs de
       actualizare (vezi comentariul din SITE.legal). -->
  <section aria-labelledby="date-firma">
    <div class:list={[pageContainer, 'py-10 md:py-14']}>
      <h2 id="date-firma" class={sectionTitle}>Datele firmei</h2>
      <dl class="grid gap-x-8 gap-y-4 border-t border-yp-white/10 pt-6 text-base sm:grid-cols-2 lg:grid-cols-4">
        {company.map((row) => (
          <div>
            <dt class="text-sm text-yp-white/60">{row.term}</dt>
            <dd class="mt-1 text-yp-white">{row.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>
