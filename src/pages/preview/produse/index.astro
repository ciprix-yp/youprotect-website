---
// Lista fișelor din pilotul de catalog. Pagina nu se indexează și nu apare în sitemap.
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CATEGORIES } from '../../../lib/catalog-taxonomy';

const roCollator = new Intl.Collator('ro', { sensitivity: 'base' });
const products = (await getCollection('products')).sort((a, b) => roCollator.compare(a.data.name, b.data.name));
---

<BaseLayout title="Catalog – previzualizare" description="Previzualizare internă a fișelor de produs." noindex>
  <section class="max-w-6xl mx-auto px-4 py-8 md:py-12">
    <p class="text-xs uppercase tracking-[0.2em] text-yp-yellow mb-3">Previzualizare, nepublicat</p>
    <h1 class="text-3xl md:text-4xl font-light text-yp-white">Pilot catalog: {products.length} produse</h1>
    <p class="mt-3 text-yp-white/70 max-w-2xl">
      Fișe generate din datele furnizorului și din textele în română. Deschide fiecare produs, verifică textele și
      notează ce trebuie corectat.
    </p>

    <ul class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {products.map(({ id, data }) => (
        <li class="min-w-0">
          <a href={`/preview/produse/${id}/`} class="group block border border-yp-white/10 hover:border-yp-yellow/60 transition-colors h-full">
            <div class="bg-white aspect-square">
              <img src={data.colours[0].images[0].src} alt={data.name} width="600" height="600" loading="lazy" class="w-full h-full object-contain p-6" />
            </div>
            <div class="p-5">
              <p class="text-xs uppercase tracking-[0.16em] text-yp-yellow">{CATEGORIES[data.category]}</p>
              <h2 class="mt-2 text-lg text-yp-white group-hover:text-yp-yellow transition-colors">{data.name}</h2>
              <p class="mt-2 text-sm text-yp-white/60 line-clamp-3">{data.summary}</p>
              <p class="mt-4 text-xs text-yp-white/60">
                {data.supplier.name} {data.supplier.model} · status: {data.status}
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
