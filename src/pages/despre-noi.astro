---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Despre Noi - You Protect">
  <!-- Hero Section -->
  <section class="py-20 bg-yp-black">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <h1 class="text-5xl md:text-6xl font-heading mb-8">
        Cine Suntem
      </h1>
      <div class="max-w-4xl mx-auto">
        <div class="bg-yp-gray/30 aspect-video rounded-xl flex items-center justify-center mb-8">
          <span class="text-yp-white/50">[Imagine Echipă You Protect]</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Story Section -->
  <section class="py-20 bg-yp-gray">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-4xl font-heading mb-8 text-center">Povestea You Protect</h2>
      <div class="prose prose-invert prose-lg max-w-none space-y-6">
        <p class="text-yp-white/90 text-lg leading-relaxed">
          [COMPLETEAZĂ: Paragraf 1 - Cum a început You Protect? Care a fost motivația inițială?]
        </p>
        <p class="text-yp-white/90 text-lg leading-relaxed">
          [COMPLETEAZĂ: Paragraf 2 - Ce problemă rezolvați? De ce sunteți diferiți?]
        </p>
        <p class="text-yp-white/90 text-lg leading-relaxed">
          [COMPLETEAZĂ: Paragraf 3 - Unde sunteți acum? Care e viziunea de viitor?]
        </p>
      </div>
    </div>
  </section>

  <!-- Mission & Values -->
  <section class="py-20 bg-yp-black">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-4xl font-heading mb-16 text-center">
        Misiune, Viziune, Valori
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Misiune -->
        <div class="bg-yp-gray p-8 rounded-xl">
          <div class="text-5xl mb-4">🎯</div>
          <h3 class="text-2xl font-heading mb-4 text-yp-yellow">Misiunea Noastră</h3>
          <p class="text-yp-white/80">
            [COMPLETEAZĂ: Care este misiunea You Protect? Ce vreți să realizați pentru clienți?]
          </p>
        </div>
        
        <!-- Viziune -->
        <div class="bg-yp-gray p-8 rounded-xl">
          <div class="text-5xl mb-4">🔭</div>
          <h3 class="text-2xl font-heading mb-4 text-yp-yellow">Viziunea Noastră</h3>
          <p class="text-yp-white/80">
            [COMPLETEAZĂ: Unde vă vedeți în viitor? Ce impact vreți să aveți în industrie?]
          </p>
        </div>
        
        <!-- Valori -->
        <div class="bg-yp-gray p-8 rounded-xl">
          <div class="text-5xl mb-4">⭐</div>
          <h3 class="text-2xl font-heading mb-4 text-yp-yellow">Valorile Noastre</h3>
          <ul class="text-yp-white/80 space-y-2">
            <li>• [COMPLETEAZĂ: Valoare 1]</li>
            <li>• [COMPLETEAZĂ: Valoare 2]</li>
            <li>• [COMPLETEAZĂ: Valoare 3]</li>
            <li>• [COMPLETEAZĂ: Valoare 4]</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section (Optional) -->
  <section class="py-20 bg-yp-gray">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-4xl font-heading mb-16 text-center">
        Echipa Noastră
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Team Member 1 -->
        <div class="text-center">
          <div class="bg-yp-black/30 aspect-square rounded-xl flex items-center justify-center mb-4 max-w-xs mx-auto">
            <span class="text-yp-white/50">[Poză Membru 1]</span>
          </div>
          <h3 class="text-xl font-heading">[COMPLETEAZĂ: Nume]</h3>
          <p class="text-yp-yellow">[COMPLETEAZĂ: Rol/Funcție]</p>
        </div>
        
        <!-- Team Member 2 -->
        <div class="text-center">
          <div class="bg-yp-black/30 aspect-square rounded-xl flex items-center justify-center mb-4 max-w-xs mx-auto">
            <span class="text-yp-white/50">[Poză Membru 2]</span>
          </div>
          <h3 class="text-xl font-heading">[COMPLETEAZĂ: Nume]</h3>
          <p class="text-yp-yellow">[COMPLETEAZĂ: Rol/Funcție]</p>
        </div>
        
        <!-- Team Member 3 -->
        <div class="text-center">
          <div class="bg-yp-black/30 aspect-square rounded-xl flex items-center justify-center mb-4 max-w-xs mx-auto">
            <span class="text-yp-white/50">[Poză Membru 3]</span>
          </div>
          <h3 class="text-xl font-heading">[COMPLETEAZĂ: Nume]</h3>
          <p class="text-yp-yellow">[COMPLETEAZĂ: Rol/Funcție]</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-yp-yellow">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-4xl md:text-5xl font-heading text-yp-black mb-6">
        Hai Să Colaborăm
      </h2>
      <p class="text-xl text-yp-black/80 mb-8">
        [COMPLETEAZĂ: Call to action - de ce să vă contacteze?]
      </p>
      <button class="bg-yp-black text-yp-yellow font-heading font-bold px-8 py-4 rounded-lg text-lg hover:bg-yp-black/90 transition-all">
        Cere Ofertă Personalizată
      </button>
    </div>
  </section>
</BaseLayout>
