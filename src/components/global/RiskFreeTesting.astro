---
// Oferta „Testezi fără riscuri”. Textul are o singură sursă: RISK_FREE_TESTING din src/lib/site.ts.
//   variant="box"    caseta completă, pe fișa de produs, lângă butoanele de ofertă;
//   variant="inline" un rând scurt, sub butoanele principale (homepage, catalog, formulare).
import { RISK_FREE_TESTING } from "../../lib/site";

interface Props {
  variant?: "box" | "inline";
  class?: string;
}

const { variant = "box", class: className = "" } = Astro.props;
const shield =
  "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z";
---

{
  variant === "box" ? (
    <div class:list={["border border-yp-white/15 p-4 flex gap-3", className]}>
      <svg class="w-5 h-5 shrink-0 text-yp-yellow mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={shield} />
      </svg>
      <div>
        <p class="text-sm font-medium text-yp-white">{RISK_FREE_TESTING.title}</p>
        <p class="mt-1 text-sm text-yp-white/70 leading-relaxed">{RISK_FREE_TESTING.text}</p>
        <a href={RISK_FREE_TESTING.href} class="inline-block py-2 text-sm text-yp-yellow underline underline-offset-4 hover:text-yp-white">
          {RISK_FREE_TESTING.linkLabel}
        </a>
      </div>
    </div>
  ) : (
    <p class:list={["flex items-start gap-2 text-sm text-neutral-300 leading-relaxed", className]}>
      <svg class="w-5 h-5 shrink-0 text-yp-yellow mt-px" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={shield} />
      </svg>
      <span>
        <strong class="font-medium text-white">{RISK_FREE_TESTING.title}.</strong> {RISK_FREE_TESTING.short}{" "}
        <a href={RISK_FREE_TESTING.href} class="text-yp-yellow underline underline-offset-4 hover:text-white whitespace-nowrap">
          {RISK_FREE_TESTING.linkLabel}
        </a>
      </span>
    </p>
  )
}
