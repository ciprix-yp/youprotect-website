---
export interface Props {
    title: string;
    subtitle?: string;
    breadcrumb?: string;
    imagePath?: string;
    ctaButtonText?: string;
    ctaSecondaryButtonText?: string;
    ctaSecondaryButtonLink?: string;
    ctaMicrocopy?: string;
}

const {
    title,
    subtitle,
    breadcrumb = "Pagina curentă",
    imagePath = "/hero-youprotect-highvis.jpg",
    ctaButtonText,
    ctaSecondaryButtonText,
    ctaSecondaryButtonLink,
    ctaMicrocopy,
} = Astro.props;
---

<section
    class="relative pt-32 pb-16 md:pt-40 md:pb-24 overflow-hidden bg-yp-black border-b border-white/5"
>
    <div class="absolute inset-0 z-0">
        <!-- Subdued, elegant background image specific to inner pages -->
        <img
            src={imagePath}
            alt={title}
            class="w-full h-full object-cover object-[center_35%] opacity-55"
            loading="eager"
        />
        <div
            class="absolute inset-0 bg-gradient-to-t from-yp-black via-yp-black/60 to-yp-black/20"
        >
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div
            class="flex flex-col items-center md:items-start text-center md:text-left max-w-3xl"
        >
            <!-- Breadcrumb / Kicker -->
            <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-[4px] border border-white/10 bg-white/5 backdrop-blur-sm mb-6"
                data-aos="fade-up"
            >
                <span
                    class="text-[10px] md:text-xs font-mono tracking-widest text-yp-yellow uppercase"
                >
                    {breadcrumb}
                </span>
            </div>

            <!-- Main Title (Calmed down from 8xl/7xl to 4xl/5xl) -->
            <h1
                class="text-4xl md:text-5xl font-light tracking-tight leading-tight text-white mb-6"
                data-aos="fade-up"
                data-aos-delay="100"
            >
                {title}
            </h1>

            <div
                class="w-12 h-1 bg-yp-yellow mb-6 mx-auto md:mx-0"
                data-aos="fade-right"
                data-aos-delay="200"
            >
            </div>

            <!-- Subtitle (Optional) -->
            {
                subtitle && (
                    <p
                        class="text-base md:text-lg text-neutral-400 font-light leading-relaxed max-w-2xl mb-8"
                        data-aos="fade-up"
                        data-aos-delay="300"
                    >
                        {subtitle}
                    </p>
                )
            }

            <!-- CTA Buttons (Optional) -->
            {
                (ctaButtonText || ctaSecondaryButtonText) && (
                    <div
                        class="flex flex-col sm:flex-row gap-4 w-full md:w-auto mt-4"
                        data-aos="fade-up"
                        data-aos-delay="400"
                    >
                        {ctaButtonText && (
                            <button
                                class="bg-yp-yellow text-yp-black h-12 px-8 rounded-[4px] font-medium text-sm flex items-center justify-center gap-2 hover:bg-white transition-all duration-200 group border border-transparent"
                                onclick="window.YouProtectShortlist?.openLeadModal({ intent: 'view_samples', source: 'inner_hero' })"
                            >
                                {ctaButtonText}
                                <svg
                                    class="w-4 h-4 group-hover:translate-x-0.5 transition-transform"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                                </svg>
                            </button>
                        )}

                        {ctaSecondaryButtonText && (
                            <a
                                href={ctaSecondaryButtonLink || "/produse"}
                                class="border border-white/15 text-white h-12 px-8 rounded-[4px] font-medium text-sm flex items-center justify-center gap-2 hover:bg-white/5 hover:border-white/30 transition-all duration-200"
                            >
                                {ctaSecondaryButtonText}
                                <svg
                                    class="w-4 h-4 text-neutral-500"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M9 5l7 7-7 7"></path>
                                </svg>
                            </a>
                        )}
                    </div>
                )
            }
            
            {
                ctaMicrocopy && (
                    <p class="text-xs md:text-sm text-neutral-500 font-light max-w-lg mt-4" data-aos="fade-up" data-aos-delay="500">
                        {ctaMicrocopy}
                    </p>
                )
            }
        </div>
    </div>
</section>
