---
// Antetul paginilor de prezentare (Despre noi, Cum lucrăm, industrii, personalizare, Satu Mare), prin PageHeader: același
// breadcrumb, titlu și butoane ca în catalog, cu fotografia paginii în dreapta. Proprietățile au rămas cele vechi, ca
// paginile să nu se schimbe.
import PageHeader, { type Crumb } from './PageHeader.astro';
import PortraitHero from './PortraitHero.astro';

export interface Props {
  title: string;
  subtitle?: string;
  breadcrumb?: string;
  imagePath?: string;
  /** Id de poză de acțiune pentru erou; înlocuiește `imagePath`. */
  heroPhoto?: string;
  /** Doar /despre-noi/: antet cu portretul fondatoarei (PortraitHero) în loc de PageHeader. Opțional; fără el nimic nu se schimbă. */
  portrait?: boolean;
  ctaButtonText?: string;
  ctaSecondaryButtonText?: string;
  ctaSecondaryButtonLink?: string;
  ctaMicrocopy?: string;
}

const {
  title,
  subtitle,
  breadcrumb = title,
  imagePath,
  heroPhoto,
  portrait = false,
  ctaButtonText,
  ctaSecondaryButtonText,
  ctaSecondaryButtonLink,
  ctaMicrocopy,
} = Astro.props;

// Paginile de sub /industrii/ au și nivelul „Industrii” în breadcrumb.
const PARENTS: Record<string, Crumb> = { industrii: { label: 'Industrii', href: '/industrii/' } };
const segments = Astro.url.pathname.split('/').filter(Boolean);
const parent = segments.length > 1 ? PARENTS[segments[0]] : undefined;
const crumbs: Crumb[] = [...(parent ? [parent] : []), { label: breadcrumb }];
---

{portrait ? (
  <PortraitHero
    title={title}
    intro={subtitle}
    crumbs={crumbs}
    primary={ctaButtonText ? { label: ctaButtonText, href: '/programeaza-discutie/' } : undefined}
    secondary={ctaSecondaryButtonText ? { label: ctaSecondaryButtonText, href: ctaSecondaryButtonLink || '/produse/' } : undefined}
    microcopy={ctaMicrocopy}
  />
) : (
  <PageHeader
    title={title}
    intro={subtitle}
    crumbs={crumbs}
    image={heroPhoto ? undefined : imagePath}
    heroPhoto={heroPhoto}
    primary={ctaButtonText ? { label: ctaButtonText, href: '/programeaza-discutie/' } : undefined}
    secondary={ctaSecondaryButtonText ? { label: ctaSecondaryButtonText, href: ctaSecondaryButtonLink || '/produse/' } : undefined}
    microcopy={ctaMicrocopy}
  />
)}
