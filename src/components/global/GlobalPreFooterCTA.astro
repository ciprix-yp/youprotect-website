---
export interface Props {
    heading?: string;
    subheading?: string;
    buttonText?: string;
    buttonLink?: string;
    secondaryButtonText?: string;
    secondaryButtonLink?: string;
}

const {
    heading = "Ești gata să discuți aplicat despre echipa ta?",
    subheading = "Lasă-ne datele mai jos sau programează o scurtă discuție. Trecem direct la subiect, fără promisiuni goale.",
    buttonText = "Programează o discuție",
    buttonLink = "",
    secondaryButtonText = "",
    secondaryButtonLink = "",
} = Astro.props;
---

<section class="py-24 bg-yp-yellow relative overflow-hidden">
    <!-- Decorative background element -->
    <div
        class="absolute inset-0 bg-[url('/grain.png')] opacity-10 pointer-events-none mix-blend-overlay"
    >
    </div>
    <div
        class="absolute -top-40 -right-40 w-96 h-96 bg-white/20 rounded-full blur-[80px] pointer-events-none"
    >
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10 text-center">
        <div class="max-w-3xl mx-auto flex flex-col items-center">
            <h2
                class="text-3xl md:text-4xl font-medium text-yp-black mb-6 tracking-tight leading-tight"
                data-aos="fade-up"
            >
                {heading}
            </h2>

            <p
                class="text-yp-black/80 text-lg font-light mb-10 leading-relaxed max-w-2xl"
                data-aos="fade-up"
                data-aos-delay="100"
            >
                {subheading}
            </p>

            <div
                class="flex flex-col sm:flex-row gap-4 items-center justify-center"
                data-aos="fade-up"
                data-aos-delay="200"
            >
                <button
                    class="bg-yp-black text-white h-14 px-10 rounded-[4px] font-medium text-base inline-flex items-center justify-center gap-2 hover:bg-neutral-800 transition-all duration-200 group border border-transparent"
                    onclick={buttonLink ? `window.location.href='${buttonLink}'` : "window.location.href='/programeaza-discutie'"}
                >
                    {buttonText}
                    <svg
                        class="w-5 h-5 group-hover:translate-x-1 transition-transform"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                </button>

                {secondaryButtonText && (
                    <a
                        href={secondaryButtonLink || "/produse"}
                        class="border border-yp-black text-yp-black h-14 px-10 rounded-[4px] font-medium text-base inline-flex items-center justify-center gap-2 hover:bg-black/5 hover:border-yp-black/80 transition-all duration-200"
                    >
                        {secondaryButtonText}
                        <svg
                          class="w-4 h-4 text-yp-black/70"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 5l7 7-7 7"></path>
                        </svg>
                    </a>
                )}
            </div>
        </div>
    </div>
</section>
