---
// Banda galbenă de dinaintea footer-ului, pe paginile interioare. Butoanele au aceeași mărime ca în restul site-ului
// (ui.ts), în varianta pentru fond galben.
import { pageContainer } from '../../lib/ui';
import { CTA_DISCUSS, RESPONSE_TIME } from '../../lib/site';

export interface Props {
  heading?: string;
  subheading?: string;
  buttonText?: string;
  buttonLink?: string;
  secondaryButtonText?: string;
  secondaryButtonLink?: string;
}

const {
  heading = 'Ești gata să discuți aplicat despre echipa ta?',
  subheading = `Răspunzi la câteva întrebări, apoi îți alegi ziua și ora din calendar. Dacă nu alegi, revenim noi ${RESPONSE_TIME}.`,
  buttonText = CTA_DISCUSS,
  buttonLink = '',
  secondaryButtonText = '',
  secondaryButtonLink = '',
} = Astro.props;

const onYellowPrimary =
  'inline-flex h-12 items-center justify-center rounded-lg bg-yp-black px-6 text-sm font-medium text-white transition-colors hover:bg-yp-gray';
const onYellowSecondary =
  'inline-flex h-12 items-center justify-center rounded-lg border border-yp-black/40 px-6 text-sm font-medium text-yp-black transition-colors hover:border-yp-black';
---

<section class="sd-expand bg-yp-yellow">
  <div class:list={[pageContainer, 'py-16 text-center md:py-20']}>
    <div class="mx-auto flex max-w-3xl flex-col items-center">
      <h2 class="font-heading text-3xl font-medium leading-tight text-yp-black md:text-4xl">{heading}</h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-yp-black/80">{subheading}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={buttonLink || '/programeaza-discutie/'} class={onYellowPrimary}>{buttonText}</a>
        {secondaryButtonText && (
          <a href={secondaryButtonLink || '/produse/'} class={onYellowSecondary}>{secondaryButtonText}</a>
        )}
      </div>
    </div>
  </div>
</section>
