---
// Antetul unei pagini interioare, în stilul catalogului: breadcrumb, H1, intro, butoane, iar opțional o fotografie în
// dreapta (pe telefon, sub text). Toate paginile interioare îl folosesc, ca titlurile, butoanele și marginile să fie la
// fel peste tot.
import ActionPhoto from '../media/ActionPhoto.astro';
import { breadcrumbNav, btnPrimary, btnSecondary, pageContainer, pageIntro, pageTitle } from '../../lib/ui';

export interface Crumb {
  label: string;
  href?: string;
}
export interface Props {
  title: string;
  intro?: string;
  /** Fără „Acasă”: se adaugă singur. Ultimul element e pagina curentă. */
  crumbs: Crumb[];
  image?: string;
  /** Id de poză reală cu oameni în acțiune (src/data/poze-actiune.json): eroul paginii, LCP. Are prioritate față de `image`. */
  heroPhoto?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  microcopy?: string;
}

const { title, intro, crumbs, image, heroPhoto, primary, secondary, microcopy } = Astro.props;
const trail: Crumb[] = [{ label: 'Acasă', href: '/' }, ...crumbs];
---

<section class="border-b border-yp-white/10">
  <div class:list={[pageContainer, 'py-8 md:py-12']}>
    <nav aria-label="Breadcrumb" class={breadcrumbNav}>
      {trail.map((c, i) => (
        <>
          {i > 0 && <span class="mx-2" aria-hidden="true">/</span>}
          {c.href && i < trail.length - 1 ? (
            <a href={c.href} class="inline-flex min-h-11 items-center transition-colors hover:text-yp-yellow">{c.label}</a>
          ) : (
            <span class="text-yp-white" aria-current="page">{c.label}</span>
          )}
        </>
      ))}
    </nav>
    <div class:list={['grid gap-8', (image || heroPhoto) && 'lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:items-center']}>
      <div class="max-w-3xl">
        <h1 class={pageTitle}>{title}</h1>
        {intro && <p class={pageIntro}>{intro}</p>}
        <slot />
        {(primary || secondary) && (
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            {primary && <a href={primary.href} class={btnPrimary}>{primary.label}</a>}
            {secondary && <a href={secondary.href} class={btnSecondary}>{secondary.label}</a>}
          </div>
        )}
        {microcopy && <p class="mt-3 text-sm text-yp-white/60">{microcopy}</p>}
      </div>
      {/* `sizes` sub 768 px declară 40vw, mai puțin decât lățimea reală (poza ocupă toată coloana, ~358 px pe iPhone 390):
          așa browserul alege cea mai mică variantă care acoperă 40vw x DPR. Eroii au variantele 768/960/1440/1920, deci pe telefon
          (390-430 px, DPR 2 sau 3: 40vw x DPR = 312-516 px) iese mereu 768 px (39-57 KB), adică ~2,1x pe iPhone, nu 640 px (1,79x,
          muchii moi). Cu 65vw ar ieși 960 px (+0,3-1 s LCP pe 4G throttled, măsurat). Între 768 și 1023 px: 60vw (iPad, 960 px la
          DPR 2); de la 1024 px: coloana reală (47vw, apoi 576 px). */}
      {heroPhoto ? (
        <div class="relative aspect-[16/10] overflow-clip rounded-xl border border-yp-white/10 bg-yp-gray">
          <ActionPhoto
            id={heroPhoto}
            sizes="(min-width: 1280px) 576px, (min-width: 1024px) 47vw, (min-width: 768px) 60vw, 40vw"
            priority
            class="sd-hero-photo absolute inset-0"
          />
        </div>
      ) : image && (
        <div class="relative aspect-[16/10] overflow-clip border border-yp-white/10 bg-yp-gray">
          <img src={image} alt="" width="1200" height="750" loading="eager" class="sd-hero-photo absolute inset-0 h-full w-full object-cover" />
        </div>
      )}
    </div>
  </div>
</section>
