---
import { SITE, LEGAL_EUID } from "../../lib/site";
const currentYear = new Date().getFullYear();
// Pe paginile cu formular, butonul WhatsApp acoperea opțiunile de răspuns (un tap pe el deschidea WhatsApp în loc
// să bifeze). Acolo formularul are deja telefonul ca alternativă, așa că butonul nu apare.
const showWhatsApp = !["/cere-oferta", "/programeaza-discutie"].some((p) => Astro.url.pathname.startsWith(p));
---

<footer class="bg-yp-black border-t border-yp-gray/50">
  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      <!-- Company Info -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-6">
          <img
            src="/images/logo-yp-clean.webp"
            alt="You Protect Logo"
            class="w-14 h-14 scale-[1.15] object-contain"
            loading="lazy"
          />
          <div>
            <div class="text-yp-white font-heading text-lg leading-tight">
              You Protect
            </div>
            <div class="text-yp-yellow/70 text-xs">
              Echipamente de protecție
            </div>
          </div>
        </div>
        <p class="text-yp-white/70 mb-6 max-w-md">
          Echipamente de protecție și haine de lucru pentru firme, alese după
          costul real. Showroom cu cabină de probă în Vetiș, Satu Mare, și
          livrare în toată România.
        </p>

        <!-- Contact Info -->
        <div class="space-y-3 text-yp-white/70">
          <div class="flex items-center gap-3">
            <svg class="h-4 w-4 shrink-0 text-yp-yellow" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
            <a
              href="tel:+40742226127"
              class="inline-block py-1.5 hover:text-yp-yellow transition-colors"
            >
              0742 226 127
            </a>
          </div>
          <div class="flex items-center gap-3">
            <svg class="h-4 w-4 shrink-0 text-yp-yellow" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" /></svg>
            <a
              href="mailto:office@youprotect.ro"
              class="inline-block py-1.5 hover:text-yp-yellow transition-colors"
            >
              office@youprotect.ro
            </a>
          </div>
          <div class="flex items-center gap-3">
            <svg class="h-4 w-4 shrink-0 text-yp-yellow" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
            <a
              href="https://maps.app.goo.gl/mTwMZfUZ5ZrVyAQP7"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block py-1.5 hover:text-yp-yellow transition-colors"
            >
              Strada Careiului nr. 45, Parc Industrial Areli, Vetiș, Satu Mare
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-yp-white font-heading text-lg mb-4">Navigare rapidă</h3>
        <ul class="space-y-1 text-yp-white/70">
          <li>
            <a href="/" class="inline-block py-1.5 hover:text-yp-yellow transition-colors">Acasă</a>
          </li>
          <li>
            <a href="/despre-noi/" class="inline-block py-1.5 hover:text-yp-yellow transition-colors"
              >Despre noi</a
            >
          </li>
          <li>
            <a href="/cum-lucram/" class="inline-block py-1.5 hover:text-yp-yellow transition-colors"
              >Cum lucrăm</a
            >
          </li>
          <li>
            <a href="/produse/" class="inline-block py-1.5 hover:text-yp-yellow transition-colors"
              >Produse</a
            >
          </li>
          <li>
            <a href="/industrii/" class="inline-block py-1.5 hover:text-yp-yellow transition-colors"
              >Industrii</a
            >
          </li>
          <li>
            <a href="/echipamente-protectie-satu-mare/" class="inline-block py-1.5 hover:text-yp-yellow transition-colors"
              >Echipamente protecție Satu Mare</a
            >
          </li>
          <li>
            <a href="/calculator-cost-echipamente/" class="inline-block py-1.5 hover:text-yp-yellow transition-colors"
              >Calculator de cost</a
            >
          </li>
          <li>
            <a href="/testare-fara-riscuri/" class="inline-block py-1.5 hover:text-yp-yellow transition-colors"
              >Testare fără riscuri</a
            >
          </li>
          <li>
            <a href="/haine-de-lucru-personalizate/" class="inline-block py-1.5 hover:text-yp-yellow transition-colors"
              >Haine personalizate cu logo</a
            >
          </li>
          <li>
            <a href="/ghiduri/" class="inline-block py-1.5 hover:text-yp-yellow transition-colors">Ghiduri</a>
          </li>
        </ul>
      </div>

      <!-- Legal & Resources -->
      <div>
        <h3 class="text-yp-white font-heading text-lg mb-4">
          Informații legale
        </h3>
        <ul class="space-y-1 text-yp-white/70">
          <li>
            <a
              href="/politica-confidentialitate/"
              class="inline-block py-1.5 hover:text-yp-yellow transition-colors"
            >
              Politica de confidențialitate
            </a>
          </li>
          <li>
            <a
              href="/termeni-conditii/"
              class="inline-block py-1.5 hover:text-yp-yellow transition-colors"
            >
              Termeni și condiții
            </a>
          </li>
          <li>
            <a
              href="/politica-cookies/"
              class="inline-block py-1.5 hover:text-yp-yellow transition-colors"
            >
              Politica de cookies
            </a>
          </li>
          {/* Apare doar când Google Analytics e configurat (îl afișează scriptul din Analytics.astro). Fără clasă de
              display pe elementele cu `hidden`: utilitarele Tailwind (block, flex) ar suprascrie atributul. */}
          <li hidden data-consent-item>
            <button type="button" data-consent-open class="py-1.5 text-left hover:text-yp-yellow transition-colors">
              Setări cookie-uri
            </button>
          </li>
        </ul>

        <!-- Program -->
        <div class="mt-6">
          <h4 class="text-yp-white/70 text-sm font-heading mb-2">Program</h4>
          <p class="text-yp-white/50 text-sm">
            Luni - Vineri: 09:00 - 17:00<br />
            Sâmbătă - Duminică: Închis
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar (Copyright) -->
  <div class="border-t border-yp-gray/50">
    <div class="max-w-7xl mx-auto px-4 py-6">
      <div
        class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-yp-white/50"
      >
        <p>
          © {currentYear} {SITE.legal.name}. Toate drepturile rezervate.
        </p>
        <div
          class="flex flex-wrap items-center justify-center md:justify-end gap-2 md:gap-4 mt-4 md:mt-0"
        >
          <span>CUI {SITE.legal.cui}</span>
          <span class="hidden md:inline">•</span>
          <span>{SITE.legal.regCom}</span>
          <span class="hidden md:inline">•</span>
          <span>EUID: {LEGAL_EUID}</span>
        </div>
      </div>
    </div>
  </div>
</footer>

<!-- Buton WhatsApp fix (doar pe mobil). 48px, lipit de colț și peste zona sigură de jos (iPhone), ca să acopere cât
     mai puțin din conținut. Spațiul de sub footer (mai jos) îl ține departe de ultimul rând al paginii. -->
{showWhatsApp && <div class="h-16 md:hidden bg-yp-black" aria-hidden="true"></div>}
{showWhatsApp && (
<a
  href="https://wa.me/40742226127"
  target="_blank"
  rel="noopener noreferrer"
  class="fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-50 bg-[#25D366] text-white w-12 h-12 rounded-full flex items-center justify-center shadow-lg hover:scale-110 transition-transform md:hidden"
  aria-label="Scrie-ne pe WhatsApp"
>
  <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path
      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
    ></path>
  </svg>
</a>
)}
