---
const currentYear = new Date().getFullYear();
---

<footer class="bg-yp-black border-t border-yp-gray/50">
  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      <!-- Company Info -->
      <div class="md:col-span-2" data-aos="fade-up">
        <div class="flex items-center gap-3 mb-6">
          <img
            src="/images/logo-yp.jpg"
            alt="You Protect Logo"
            class="w-12 h-12 object-contain mix-blend-screen"
          />
          <div>
            <div class="text-yp-white font-heading text-lg leading-tight">
              You Protect
            </div>
            <div class="text-yp-yellow/70 text-xs">
              Echipamente Profesionale
            </div>
          </div>
        </div>
        <p class="text-yp-white/70 mb-6 max-w-md">
          Furnizor de echipamente de protecție premium și haine de lucru,
          dedicat companiilor tehnice din România. Transformăm siguranța
          angajaților tăi într-o investiție de imagine.
        </p>

        <!-- Contact Info -->
        <div class="space-y-3 text-yp-white/70">
          <div class="flex items-center gap-3">
            <span class="text-yp-yellow">📞</span>
            <a
              href="tel:+40742226127"
              class="hover:text-yp-yellow transition-colors"
            >
              0742 226 127
            </a>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-yp-yellow">✉️</span>
            <a
              href="mailto:office@youprotect.ro"
              class="hover:text-yp-yellow transition-colors"
            >
              office@youprotect.ro
            </a>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-yp-yellow">📍</span>
            <a
              href="https://goo.gl/maps/placeholder"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-yp-yellow transition-colors"
            >
              Strada Careiului nr 11, Vetiș, Satu Mare
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Links -->
      <div data-aos="fade-up" data-aos-delay="100">
        <h3 class="text-yp-white font-heading text-lg mb-4">Navigare Rapidă</h3>
        <ul class="space-y-3 text-yp-white/70">
          <li>
            <a href="/" class="hover:text-yp-yellow transition-colors">Acasă</a>
          </li>
          <li>
            <a href="/despre-noi" class="hover:text-yp-yellow transition-colors"
              >Despre Noi</a
            >
          </li>
          <li>
            <a href="/cum-lucram" class="hover:text-yp-yellow transition-colors"
              >Cum Lucrăm</a
            >
          </li>
          <li>
            <a href="/produse" class="hover:text-yp-yellow transition-colors"
              >Produse</a
            >
          </li>
        </ul>
      </div>

      <!-- Legal & Resources -->
      <div data-aos="fade-up" data-aos-delay="200">
        <h3 class="text-yp-white font-heading text-lg mb-4">
          Informații Legale
        </h3>
        <ul class="space-y-3 text-yp-white/70">
          <li>
            <a
              href="/politica-confidentialitate"
              class="hover:text-yp-yellow transition-colors"
            >
              Politică Confidențialitate
            </a>
          </li>
          <li>
            <a
              href="/termeni-conditii"
              class="hover:text-yp-yellow transition-colors"
            >
              Termeni și Condiții
            </a>
          </li>
          <li>
            <a
              href="/politica-cookies"
              class="hover:text-yp-yellow transition-colors"
            >
              Politică Cookies
            </a>
          </li>
        </ul>

        <!-- Program -->
        <div class="mt-6">
          <h4 class="text-yp-white/70 text-sm font-heading mb-2">Program</h4>
          <p class="text-yp-white/50 text-sm">
            Luni - Vineri: 09:00 - 17:00<br />
            Sâmbătă - Duminică: Închis
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar (Copyright) -->
  <div class="border-t border-yp-gray/50">
    <div class="max-w-7xl mx-auto px-4 py-6">
      <div
        class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-yp-white/50"
      >
        <p>
          © {currentYear} You Protect SRL. Toate drepturile rezervate.
        </p>
        <div
          class="flex flex-wrap items-center justify-center md:justify-end gap-2 md:gap-4 mt-4 md:mt-0"
        >
          <span>RO 46387843</span>
          <span class="hidden md:inline">•</span>
          <span>J30/624/2022</span>
          <span class="hidden md:inline">•</span>
          <span>EUID: ROONRC.J30/624/2022</span>
        </div>
      </div>
    </div>
  </div>
</footer>

<!-- WhatsApp Sticky Button (Mobile) -->
<a
  href="https://wa.me/40742226127"
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-6 right-6 z-50 bg-[#25D366] text-white w-14 h-14 rounded-full flex items-center justify-center shadow-lg hover:scale-110 transition-transform md:hidden"
  aria-label="WhatsApp"
>
  <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
