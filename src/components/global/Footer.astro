---
import { SITE, LEGAL_EUID } from "../../lib/site";
import { whatsappHref } from "../../lib/whatsapp";
import ContactIcon from "./ContactIcon.astro";
const currentYear = new Date().getFullYear();
// Butonul WhatsApp e pe fiecare pagină (owner, 20.11.2026), cu adresa paginii în mesajul precompletat. Excepție: pe
// telefon, pe paginile cu formular, butonul fix acoperea variantele de răspuns (un tap deschidea WhatsApp în loc să
// bifeze); acolo, pe telefon, linkul WhatsApp e sub titlul paginii, iar butonul fix apare doar de la tabletă în sus.
// Calculatorul e tot o pagină cu formular (26.11.2026): pe telefon, butonul fix acoperea „Următorul pas” și „Vezi
// rezultatul”; linkul WhatsApp e în primul pas („Ai o echipă de 1–4 persoane?”).
const onFormPage = ["/cere-oferta", "/programeaza-discutie", "/calculator-cost-echipamente"].some((p) =>
  Astro.url.pathname.startsWith(p),
);
const waHref = whatsappHref(Astro.url.pathname);
---

<footer class="bg-yp-black border-t border-yp-gray/50">
  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 py-16">
    <!-- Pe telefon: firma și contactul pe toată lățimea, linkurile pe două coloane (pagina mai scurtă). -->
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4 md:gap-12">
      <!-- Company Info -->
      <div class="col-span-2">
        <div class="flex items-center gap-3 mb-6">
          <img
            src="/images/logo-yp-clean.webp"
            alt="You Protect Logo"
            class="w-14 h-14 scale-[1.15] object-contain"
            loading="lazy"
          />
          <div>
            <div class="text-yp-white font-heading text-lg leading-tight">
              You Protect
            </div>
            <div class="text-yp-yellow/70 text-xs">
              Echipamente de protecție
            </div>
          </div>
        </div>
        <p class="text-yp-white/70 mb-6 max-w-md">
          Echipamente de protecție și haine de lucru pentru firme, alese după
          costul real. Showroom cu cabină de probă în Vetiș, Satu Mare, și
          livrare în toată România.
        </p>

        <!-- Contact Info -->
        <div class="space-y-3 text-yp-white/70">
          <div class="flex items-center gap-3">
            <ContactIcon name="phone" class="h-4 w-4 text-yp-yellow" />
            <a
              href={`tel:${SITE.telephone}`}
              class="inline-flex min-h-11 items-center md:min-h-0 md:py-1.5 hover:text-yp-yellow transition-colors"
            >
              0742 226 127
            </a>
          </div>
          <div class="flex items-center gap-3">
            <ContactIcon name="whatsapp" class="h-4 w-4 text-yp-yellow" />
            <a
              href={waHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center md:min-h-0 md:py-1.5 hover:text-yp-yellow transition-colors"
            >
              WhatsApp: 0742 226 127
            </a>
          </div>
          <div class="flex items-center gap-3">
            <ContactIcon name="email" class="h-4 w-4 text-yp-yellow" />
            <a
              href={`mailto:${SITE.email}`}
              class="inline-flex min-h-11 items-center md:min-h-0 md:py-1.5 hover:text-yp-yellow transition-colors"
            >
              office@youprotect.ro
            </a>
          </div>
          <div class="flex items-center gap-3">
            <ContactIcon name="pin" class="h-4 w-4 text-yp-yellow" />
            <a
              href={SITE.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center md:min-h-0 md:py-1.5 hover:text-yp-yellow transition-colors"
            >
              Strada Careiului nr. 45, Parc Industrial Areli, Vetiș, Satu Mare
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-yp-white font-heading text-lg mb-4">Navigare rapidă</h3>
        <ul class="space-y-1 text-yp-white/70">
          <li>
            <a href="/" class="inline-flex min-h-11 items-center md:min-h-0 md:py-1.5 hover:text-yp-yellow transition-colors">Acasă</a>
          </li>
          <li>
            <a href="/despre-noi/" class="inline-flex min-h-11 items-center md:min-h-0 md:py-1.5 hover:text-yp-yellow transition-colors"
              >Despre noi</a
            >
          </li>
          <li>
            <a href="/cum-lucram/" class="inline-flex min-h-11 items-center md:min-h-0 md:py-1.5 hover:text-yp-yellow transition-colors"
              >Cum lucrăm</a
            >
          </li>
          <li>
            <a href="/produse/" class="inline-flex min-h-11 items-center md:min-h-0 md:py-1.5 hover:text-yp-yellow transition-colors"
              >Produse</a
            >
          </li>
          <li>
            <a href="/industrii/" class="inline-flex min-h-11 items-center md:min-h-0 md:py-1.5 hover:text-yp-yellow transition-colors"
              >Industrii</a
            >
          </li>
          <li>
            <a href="/echipamente-protectie-satu-mare/" class="inline-flex min-h-11 items-center md:min-h-0 md:py-1.5 hover:text-yp-yellow transition-colors"
              >Echipamente protecție Satu Mare</a
            >
          </li>
          <li>
            <a href="/calculator-cost-echipamente/" class="inline-flex min-h-11 items-center md:min-h-0 md:py-1.5 hover:text-yp-yellow transition-colors"
              >Calculator de cost</a
            >
          </li>
          <li>
            <a href="/testare-fara-riscuri/" class="inline-flex min-h-11 items-center md:min-h-0 md:py-1.5 hover:text-yp-yellow transition-colors"
              >Testare fără riscuri</a
            >
          </li>
          <li>
            <a href="/haine-de-lucru-personalizate/" class="inline-flex min-h-11 items-center md:min-h-0 md:py-1.5 hover:text-yp-yellow transition-colors"
              >Haine personalizate cu logo</a
            >
          </li>
          <li>
            <a href="/ghiduri/" class="inline-flex min-h-11 items-center md:min-h-0 md:py-1.5 hover:text-yp-yellow transition-colors">Ghiduri</a>
          </li>
          <li>
            <a href="/contact/" class="inline-flex min-h-11 items-center md:min-h-0 md:py-1.5 hover:text-yp-yellow transition-colors">Contact</a>
          </li>
        </ul>
      </div>

      <!-- Legal & Resources -->
      <div>
        <h3 class="text-yp-white font-heading text-lg mb-4">
          Informații legale
        </h3>
        <ul class="space-y-1 text-yp-white/70">
          <li>
            <a
              href="/politica-confidentialitate/"
              class="inline-flex min-h-11 items-center md:min-h-0 md:py-1.5 hover:text-yp-yellow transition-colors"
            >
              Politica de confidențialitate
            </a>
          </li>
          <li>
            <a
              href="/termeni-conditii/"
              class="inline-flex min-h-11 items-center md:min-h-0 md:py-1.5 hover:text-yp-yellow transition-colors"
            >
              Termeni și condiții
            </a>
          </li>
          <li>
            <a
              href="/politica-cookies/"
              class="inline-flex min-h-11 items-center md:min-h-0 md:py-1.5 hover:text-yp-yellow transition-colors"
            >
              Politica de cookies
            </a>
          </li>
          {/* Apare doar când Google Analytics e configurat (îl afișează scriptul din Analytics.astro). Fără clasă de
              display pe elementele cu `hidden`: utilitarele Tailwind (block, flex) ar suprascrie atributul. */}
          <li hidden data-consent-item>
            <button type="button" data-consent-open class="inline-flex min-h-11 items-center text-left hover:text-yp-yellow transition-colors md:min-h-0 md:py-1.5">
              Setări cookie-uri
            </button>
          </li>
        </ul>

        <!-- Program -->
        <div class="mt-6">
          <h4 class="text-yp-white/70 text-sm font-heading mb-2">Program</h4>
          <p class="text-yp-white/50 text-sm">
            Luni–vineri, 09:00–17:00<br />
            Sâmbătă și duminică: închis
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar (Copyright) -->
  <div class="border-t border-yp-gray/50">
    <div class="max-w-7xl mx-auto px-4 py-6">
      <div
        class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-yp-white/50"
      >
        <p>
          © {currentYear} {SITE.legal.name}. Toate drepturile rezervate.
        </p>
        <div
          class="flex flex-col md:flex-row md:flex-wrap items-center justify-center md:justify-end gap-1 md:gap-4 mt-4 md:mt-0"
        >
          <span>CUI {SITE.legal.cui}</span>
          <span class="hidden md:inline">•</span>
          <span>{SITE.legal.regCom}</span>
          <span class="hidden md:inline">•</span>
          <span>EUID: {LEGAL_EUID}</span>
        </div>
      </div>
    </div>
  </div>
</footer>

<!-- Buton WhatsApp fix, pe fiecare pagină: 48 px pe telefon (lipit de colț, peste zona sigură de jos a iPhone-ului),
     56 px de la tabletă în sus. Spațiul de sub footer îl ține departe de ultimul rând al paginii, pe telefon. -->
{!onFormPage && <div class="h-16 md:hidden bg-yp-black" aria-hidden="true"></div>}
<a
  href={waHref}
  target="_blank"
  rel="noopener noreferrer"
  data-track-location="buton-whatsapp"
  class:list={[
    "fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-50 h-12 w-12 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition-transform hover:scale-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white md:right-6 md:bottom-6 md:h-14 md:w-14",
    onFormPage ? "hidden md:flex" : "flex",
  ]}
  aria-label="Scrie-ne pe WhatsApp"
  title="Scrie-ne pe WhatsApp: 0742 226 127"
>
  <svg class="h-7 w-7 md:h-8 md:w-8" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path
      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
    ></path>
  </svg>
</a>
