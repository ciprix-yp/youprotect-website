---
const currentYear = new Date().getFullYear();
---

<footer class="bg-yp-black border-t border-yp-gray/50">
  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      <!-- Company Info -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-12 h-12 bg-yp-yellow rounded-lg flex items-center justify-center">
            <span class="text-yp-black font-heading font-bold text-xl">YP</span>
          </div>
          <div>
            <div class="text-yp-white font-heading text-lg leading-tight">You Protect</div>
            <div class="text-yp-yellow/70 text-xs">Echipamente Profesionale</div>
          </div>
        </div>
        <p class="text-yp-white/70 mb-6 max-w-md">
          [COMPLETEAZĂ: Scurtă descriere - ex: Furnizor de echipamente de protecție și uniforme personalizate pentru companii din România.]
        </p>
        
        <!-- Contact Info -->
        <div class="space-y-3 text-yp-white/70">
          <div class="flex items-center gap-3">
            <span class="text-yp-yellow">📞</span>
            <a href="tel:+40742226127" class="hover:text-yp-yellow transition-colors">
              0742 226 127
            </a>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-yp-yellow">✉️</span>
            <a href="mailto:office@youprotect.ro" class="hover:text-yp-yellow transition-colors">
              office@youprotect.ro
            </a>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-yp-yellow">📍</span>
            <span>Strada Careiului nr 11, Vetis, Satu Mare</span>
          </div>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-yp-white font-heading text-lg mb-4">Navigare Rapidă</h3>
        <ul class="space-y-3 text-yp-white/70">
          <li>
            <a href="/" class="hover:text-yp-yellow transition-colors">Acasă</a>
          </li>
          <li>
            <a href="/despre-noi" class="hover:text-yp-yellow transition-colors">Despre Noi</a>
          </li>
          <li>
            <a href="/cum-lucram" class="hover:text-yp-yellow transition-colors">Cum Lucrăm</a>
          </li>
          <li>
            <a href="/produse" class="hover:text-yp-yellow transition-colors">Produse</a>
          </li>
        </ul>
      </div>

      <!-- Legal & Resources -->
      <div>
        <h3 class="text-yp-white font-heading text-lg mb-4">Informații Legale</h3>
        <ul class="space-y-3 text-yp-white/70">
          <li>
            <a href="/politica-confidentialitate" class="hover:text-yp-yellow transition-colors">
              Politică Confidențialitate
            </a>
          </li>
          <li>
            <a href="/termeni-conditii" class="hover:text-yp-yellow transition-colors">
              Termeni și Condiții
            </a>
          </li>
          <li>
            <a href="/politica-cookies" class="hover:text-yp-yellow transition-colors">
              Politică Cookies
            </a>
          </li>
        </ul>

        <!-- Program -->
        <div class="mt-6">
          <h4 class="text-yp-white/70 text-sm font-heading mb-2">Program</h4>
          <p class="text-yp-white/50 text-sm">
            Luni - Vineri: 09:00 - 17:00<br/>
            Sâmbătă - Duminică: Închis
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar (Copyright) -->
  <div class="border-t border-yp-gray/50">
    <div class="max-w-7xl mx-auto px-4 py-6">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-yp-white/50">
        <p>
          © {currentYear} You Protect SRL. Toate drepturile rezervate.
        </p>
        <div class="flex items-center gap-4">
          <span>CUI: [COMPLETEAZĂ: CUI Companie]</span>
          <span>•</span>
          <span>J30/[COMPLETEAZĂ: Nr Reg Com]</span>
        </div>
      </div>
    </div>
  </div>
</footer>

<!-- WhatsApp Sticky Button (Mobile) -->
