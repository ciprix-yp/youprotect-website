---
// Linkul activ din meniu: adresele au „/” la final (/despre-noi/), deci comparăm fără el. Înainte, „Despre noi” și
// „Cum lucrăm” nu apăreau niciodată active. aria-current spune și cititoarelor de ecran unde ești.
// Meniul întreg apare de la 1024 px (lg). Pe tabletă (768 px), logo-ul, linkurile și butonul nu încăpeau pe un rând și
// treceau pe două (21.11.2026, odată cu „Contact”), așa că tableta are meniul de pe telefon.
import { CTA_DISCUSS } from '../../lib/site';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const NAV = [
  { href: '/', label: 'Acasă', page: path === '/', section: false },
  { href: '/despre-noi/', label: 'Despre noi', page: path === '/despre-noi', section: false },
  { href: '/cum-lucram/', label: 'Cum lucrăm', page: path === '/cum-lucram', section: false },
  { href: '/produse/', label: 'Catalog', page: path === '/produse', section: path.startsWith('/produse/') },
  { href: '/contact/', label: 'Contact', page: path === '/contact', section: false },
];
const current = (item: (typeof NAV)[number]) => (item.page ? 'page' : item.section ? 'true' : undefined);
const tone = (item: (typeof NAV)[number]) => (item.page || item.section ? 'text-yp-yellow' : 'text-yp-white hover:text-yp-yellow');
---

<header
  class="site-header fixed top-0 left-0 right-0 z-40 bg-yp-black/80 backdrop-blur-xl backdrop-saturate-150 border-b border-white/[0.06]"
>
  <div class="max-w-7xl mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <img
          src="/images/logo-yp-clean.webp"
          alt="You Protect Logo"
          class="w-14 h-14 scale-[1.15] object-contain"
        />
        <div>
          <div class="text-yp-white font-heading text-lg leading-tight">
            You Protect
          </div>
          <div class="text-yp-yellow/70 text-xs">Echipamente de protecție</div>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-8" aria-label="Meniu principal">
        {NAV.map((item) => (
          <a href={item.href} aria-current={current(item)} class={`${tone(item)} transition-colors`}>
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-1 lg:gap-4">
        <!-- Lista de ofertă (src/scripts/quote-list.ts): apare doar când vizitatorul a adăugat produse. Atributul hidden
             e pe învelitoare, fără clasă de display, ca utilitarele Tailwind să nu-l anuleze. -->
        <div data-quote-link hidden>
          <a
            href="/cere-oferta/"
            class="relative inline-flex h-11 items-center gap-2 rounded-lg px-2.5 text-yp-white transition-colors hover:text-yp-yellow lg:border lg:border-white/15 lg:px-3 lg:hover:border-yp-yellow/60"
          >
            <svg class="h-6 w-6 lg:h-5 lg:w-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" /></svg>
            <span class="hidden text-sm lg:inline">Lista de ofertă</span>
            <span
              data-quote-count
              class="absolute right-0 top-0.5 grid h-5 min-w-5 place-items-center rounded-full bg-yp-yellow px-1.5 text-xs font-semibold text-yp-black lg:static"
            >0</span>
          </a>
        </div>

        <!-- CTA Button (Desktop) -->
        <a
          href="/programeaza-discutie/"
          class="hidden lg:block bg-yp-yellow text-yp-black text-center font-heading font-semibold px-6 py-2.5 rounded-lg hover:bg-white transition active:scale-[0.98]"
        >
          {CTA_DISCUSS}
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-button"
          type="button"
          class="lg:hidden text-yp-white p-2.5"
          aria-label="Meniu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu (Hidden by default) -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden bg-yp-black border-t border-yp-gray/50"
  >
    <nav class="px-4 py-6 space-y-2" aria-label="Meniu principal">
      {NAV.map((item) => (
        <a href={item.href} aria-current={current(item)} class={`flex min-h-11 items-center ${tone(item)} transition-colors`}>
          {item.label}
        </a>
      ))}
      <a
        href="/programeaza-discutie/"
        class="block w-full text-center bg-yp-yellow text-yp-black font-heading font-semibold px-6 py-3 rounded-lg hover:bg-white transition active:scale-[0.98]"
      >
        {CTA_DISCUSS}
      </a>
    </nav>
  </div>
</header>

<!-- Spacer (prevents content from hiding under fixed header) -->
<div class="h-20"></div>

<!-- Confirmarea de la „Adaugă la ofertă” (src/scripts/quote-list.ts). Regiunea există mereu, ca cititoarele de ecran
     să anunțe textul nou; se vede doar cu data-open, sub antet (global.css, .quote-toast). -->
<div id="quote-toast" role="status" class="quote-toast">
  <p data-quote-toast-text></p>
  <a href="/cere-oferta/" data-quote-toast-link hidden>Vezi lista</a>
</div>

<script>
  // Mobile menu toggle
  const menuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");

  const setOpen = (open: boolean) => {
    mobileMenu?.classList.toggle("hidden", !open);
    menuButton?.setAttribute("aria-expanded", String(open));
  };

  menuButton?.addEventListener("click", () => {
    setOpen(mobileMenu?.classList.contains("hidden") ?? false);
  });

  // Închide meniul la click în afara lui sau la Escape.
  document.addEventListener("click", (e) => {
    const target = e.target as Node;
    if (!menuButton?.contains(target) && !mobileMenu?.contains(target)) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
</script>
