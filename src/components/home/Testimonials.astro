---
import type { Testimonial } from '../../lib/testimonials';

interface Props {
  testimonials: Testimonial[];
}

const { testimonials } = Astro.props;

function getInitials(name: string): string {
  return name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2);
}

function formatDate(dateStr: string | null): string {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return d.toLocaleDateString('ro-RO', { month: 'long', year: 'numeric', timeZone: 'Europe/Bucharest' });
}
---

{/* Rând orizontal cu scroll-snap, fără derulare automată (ii5, review design 26.11.2026). Lățimile cardurilor vin din CSS
    (1 / 2 / 3 pe rând), deci pagina nu se mișcă la încărcare. Vizitatorul derulează cu degetul, cu săgețile sau de la tastatură. */}
<div class="testimonials-carousel">
  <div
    class="carousel-track flex snap-x snap-mandatory gap-6 overflow-x-auto py-1 lg:gap-8 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-yp-yellow"
    tabindex="0"
    role="region"
    aria-roledescription="carusel"
    aria-label="Recenzii Google: derulează orizontal sau folosește săgețile stânga și dreapta"
  >
    {testimonials.map((t) => (
      <article class="carousel-card flex w-full flex-none snap-start flex-col gap-6 rounded-lg border border-white/10 bg-yp-black p-8 transition-colors group hover:border-yp-yellow/30 md:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-4rem)/3)]">
        <!-- Stars -->
        <div class="flex gap-1" role="img" aria-label={`${t.rating} stele din 5`}>
          {Array.from({ length: t.rating }).map(() => (
            <svg class="w-5 h-5 text-yp-yellow fill-current" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>

        <!-- Review text -->
        <blockquote class="flex-1 text-neutral-300 text-sm leading-relaxed group-hover:text-white transition-colors">
          <span class="text-yp-yellow text-3xl font-serif leading-none select-none mr-1" aria-hidden="true">"</span>
          {t.review_text}
        </blockquote>

        <!-- Author -->
        <div class="flex items-center gap-4 pt-6 border-t border-white/5">
          <!-- Avatar: initials as base, photo overlaid on top -->
          <div class="relative w-12 h-12 flex-shrink-0">
            <div class="w-12 h-12 rounded-lg bg-yp-yellow/10 border border-yp-yellow/20 flex items-center justify-center">
              <span class="text-yp-yellow text-sm font-medium tracking-wide">{getInitials(t.author_name)}</span>
            </div>
            {t.author_photo_url && (
              <img
                src={t.author_photo_url}
                alt={t.author_name}
                class="absolute inset-0 w-12 h-12 rounded-lg object-cover border border-white/10"
                loading="lazy"
                referrerpolicy="no-referrer"
                onerror="this.remove()"
              />
            )}
          </div>

          <div class="flex-1 min-w-0">
            <p class="text-white font-medium text-sm truncate">{t.author_name}</p>
            {t.date_posted && (
              <p class="text-neutral-400 text-xs mt-0.5">{formatDate(t.date_posted)}</p>
            )}
          </div>

          <!-- Google badge -->
          <div class="flex-shrink-0 opacity-60 group-hover:opacity-100 transition-opacity" title="Recenzie Google">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-label="Google">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
          </div>
        </div>
      </article>
    ))}
  </div>

  {/* Săgeți: butoane de 44×44 px, la toate lățimile. La capete devin aria-disabled (rămân în ordinea de tab, ca focusul să nu se piardă).
      Rândul pornește `invisible` (rezervă locul, deci fără CLS la prima randare, și nu are săgeți moarte fără JS: invisible scoate
      butoanele din arborele de accesibilitate și din ordinea de tab). JS-ul îl arată când rândul de recenzii chiar derulează și îl
      ascunde (`hidden`) când toate recenziile încap (scrollWidth <= clientWidth). */}
  <div class="carousel-arrows invisible mt-8 flex items-center justify-center gap-3">
    <button
      type="button"
      class="carousel-prev flex min-h-11 min-w-11 items-center justify-center rounded-lg border border-white/20 bg-yp-black text-white transition-colors hover:border-yp-yellow hover:text-yp-yellow focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yp-yellow aria-disabled:cursor-default aria-disabled:opacity-40 aria-disabled:hover:border-white/20 aria-disabled:hover:text-white"
      aria-label="Recenzia anterioară"
      aria-disabled="true"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
    </button>
    <button
      type="button"
      class="carousel-next flex min-h-11 min-w-11 items-center justify-center rounded-lg border border-white/20 bg-yp-black text-white transition-colors hover:border-yp-yellow hover:text-yp-yellow focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yp-yellow aria-disabled:cursor-default aria-disabled:opacity-40 aria-disabled:hover:border-white/20 aria-disabled:hover:text-white"
      aria-label="Recenzia următoare"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
    </button>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.testimonials-carousel');
  const track = root?.querySelector<HTMLElement>('.carousel-track');
  const prev = root?.querySelector<HTMLButtonElement>('.carousel-prev');
  const next = root?.querySelector<HTMLButtonElement>('.carousel-next');
  const arrows = root?.querySelector<HTMLElement>('.carousel-arrows');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (root && track && prev && next) {
    // Un card = lățimea lui + spațiul dintre carduri.
    const step = () => {
      const first = track.firstElementChild as HTMLElement | null;
      return first ? first.offsetWidth + (parseFloat(getComputedStyle(track).columnGap) || 0) : track.clientWidth;
    };
    const move = (dir: 1 | -1) => track.scrollBy({ left: dir * step(), behavior: reduce.matches ? 'auto' : 'smooth' });

    const sync = () => {
      const max = track.scrollWidth - track.clientWidth;
      const scrolls = max > 1;
      arrows?.classList.remove('invisible');
      arrows?.classList.toggle('flex', scrolls);
      arrows?.classList.toggle('hidden', !scrolls);
      prev.setAttribute('aria-disabled', String(track.scrollLeft <= 1));
      next.setAttribute('aria-disabled', String(track.scrollLeft >= max - 1));
    };

    prev.addEventListener('click', () => { if (prev.getAttribute('aria-disabled') !== 'true') move(-1); });
    next.addEventListener('click', () => { if (next.getAttribute('aria-disabled') !== 'true') move(1); });
    track.addEventListener('keydown', (e) => {
      if (e.target !== track || (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft')) return;
      e.preventDefault();
      move(e.key === 'ArrowRight' ? 1 : -1);
    });
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  }
</script>
