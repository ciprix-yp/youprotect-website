---
// Șablon comun pentru paginile legale: titlu, data actualizării și text lizibil pe fond închis.
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  updated: string; // ex. „16 noiembrie 2026”
}

const { title, description, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="h-24 md:h-32"></div>
  <article
    class="max-w-3xl mx-auto px-4 pb-24 text-neutral-300 leading-relaxed
      [&_h2]:text-2xl [&_h2]:font-heading [&_h2]:font-semibold [&_h2]:text-white [&_h2]:mt-12 [&_h2]:mb-4
      [&_h3]:text-lg [&_h3]:font-heading [&_h3]:text-white [&_h3]:mt-8 [&_h3]:mb-2
      [&_p]:mb-4 [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-6 [&_li]:mb-2
      [&_a]:text-yp-yellow [&_a]:underline [&_a:hover]:text-white [&_strong]:text-white"
  >
    <h1 class="text-4xl md:text-5xl font-heading font-semibold text-white mb-4">{title}</h1>
    <p class="text-sm text-neutral-400 mb-10">Actualizat la {updated}</p>
    <slot />
  </article>
</BaseLayout>
