---
// Șablon comun pentru paginile legale (și „Testare fără riscuri”): breadcrumb și titlu ca în restul site-ului, data
// actualizării și o coloană de text de cel mult ~70 de caractere pe rând.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { breadcrumbNav, pageContainer, pageTitle, readingColumn } from "../../lib/ui";

interface Props {
  title: string;
  description: string;
  updated: string; // ex. „16 noiembrie 2026”
}

const { title, description, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class:list={[pageContainer, "pt-8 pb-24 md:pt-12"]}>
    <nav aria-label="Breadcrumb" class={breadcrumbNav}>
      <a href="/" class="inline-flex min-h-11 items-center transition-colors hover:text-yp-yellow">Acasă</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-yp-white" aria-current="page">{title}</span>
    </nav>
    <article
      class:list={[readingColumn, `text-yp-white/80 leading-relaxed
        [&_h2]:text-xl [&_h2]:font-heading [&_h2]:font-medium [&_h2]:text-white [&_h2]:mt-12 [&_h2]:mb-4
        [&_h3]:text-lg [&_h3]:font-heading [&_h3]:font-medium [&_h3]:text-white [&_h3]:mt-8 [&_h3]:mb-2
        [&_p]:mb-4 [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:mb-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_li]:mb-2
        [&_a]:text-yp-yellow [&_a]:underline [&_a:hover]:text-white [&_strong]:text-white`]}
    >
      <h1 class={pageTitle}>{title}</h1>
      <p class="mt-3 mb-10 text-sm text-yp-white/60">Actualizat la {updated}</p>
      <slot />
    </article>
  </div>
</BaseLayout>
