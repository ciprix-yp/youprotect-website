---
// Dalele de categorie (catalog, homepage): generate din produsele publicate, în ordinea din taxonomie, cu poza
// primului model. Categoria cu pagină duce la pagina ei; cea fără pagină (un singur model) la catalog, filtrat
// (/produse/?categorie=<cheie>). Pe telefon sunt o bandă derulabilă, de la tabletă în sus o grilă.
import { getCollection } from 'astro:content';
import { CATEGORIES, type CategoryKey } from '../../lib/catalog-taxonomy';
import { activeCategoryPages, modelsLabel } from '../../lib/catalog-categories';
import { toCardProps } from '../../lib/product-card';

const roCollator = new Intl.Collator('ro', { sensitivity: 'base' });
const entries = (await getCollection('products', ({ data }) => data.status === 'published')).sort((a, b) =>
  roCollator.compare(a.data.name, b.data.name),
);
const pages = activeCategoryPages(entries.map((e) => e.data));
const tiles = (Object.keys(CATEGORIES) as CategoryKey[])
  .map((key) => {
    const items = entries.filter((e) => e.data.category === key);
    if (items.length === 0) return null;
    const page = pages.find((c) => c.key === key);
    return {
      label: CATEGORIES[key],
      count: items.length,
      image: toCardProps(items[0]).image,
      href: page ? `/produse/${page.slug}/` : `/produse/?categorie=${key}#modele`,
    };
  })
  .filter((t): t is NonNullable<typeof t> => t !== null);

// Pe desktop, rânduri pline: numărul de coloane (5–8) care lasă ultimul rând cel mai plin (15 dale → 3 × 5, nu 7 + 7 + 1).
// Clasele sunt scrise întregi, ca Tailwind să le găsească.
const LG_COLS = { 8: 'lg:grid-cols-8', 7: 'lg:grid-cols-7', 6: 'lg:grid-cols-6', 5: 'lg:grid-cols-5' } as const;
const fill = (cols: number) => (tiles.length % cols === 0 ? 1 : (tiles.length % cols) / cols);
const lgCols = ([8, 7, 6, 5] as const).reduce((best, cols) => (fill(cols) > fill(best) ? cols : best));
---

<div class="-mx-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:overflow-visible sm:px-0 sm:pb-0" tabindex="0" role="region" aria-label="Categorii: derulează orizontal pe telefon">
  <ul class:list={['flex snap-x snap-mandatory scroll-px-4 gap-3 py-1 sm:grid sm:grid-cols-4 sm:py-0', LG_COLS[lgCols]]}>
    {tiles.map((t) => (
      <li class="w-40 shrink-0 snap-start sm:w-auto">
        <a
          href={t.href}
          data-tilt="8"
          class="card-3d group relative flex h-full flex-col rounded-xl border border-white/[0.08] bg-yp-surface shadow-card hover:border-yp-yellow/40 hover:shadow-card-hover focus-visible:border-yp-yellow focus-visible:outline-none"
        >
          <span class="tilt-pop img-well relative block aspect-[4/3] overflow-hidden rounded-t-xl">
            <img src={t.image} alt="" width="600" height="600" loading="lazy" class="absolute inset-0 h-full w-full object-contain p-3 transition-transform duration-500 ease-out group-hover:scale-[1.05]" />
          </span>
          <span class="flex flex-1 flex-col p-3">
            <span class="min-h-[2lh] text-sm font-medium leading-snug text-yp-white transition-colors group-hover:text-yp-yellow">{t.label}</span>
            <span class="mt-1 text-xs text-yp-white/55">{modelsLabel(t.count)}</span>
          </span>
          <span class="tilt-sheen" aria-hidden="true"></span>
        </a>
      </li>
    ))}
  </ul>
</div>
