---
// Pagina de marcă din catalog (/produse/<slug>/). Cine e producătorul vine din src/lib/catalog-brands.ts, cu sursa
// oficială; modelele, categoriile, certificările și zonele de logo se generează din fișele de produs.
import type { CollectionEntry } from 'astro:content';
import ProductCard from './ProductCard.astro';
import { toCardProps } from '../../lib/product-card';
import CertificationsTable from './CertificationsTable.astro';
import RiskFreeTesting from '../global/RiskFreeTesting.astro';
import { CATEGORIES, type CategoryKey } from '../../lib/catalog-taxonomy';
import { joinRo, modelsLabel, type CategoryPage } from '../../lib/catalog-categories';
import { riskFreeExclusions } from '../../lib/risk-free-scope';
import type { BrandPage } from '../../lib/catalog-brands';
import { PERSONALIZATION_PAGE, productsWithLogoZones } from '../../lib/personalization';
import { jsonLd } from '../../lib/json-ld';
import { RISK_FREE_TESTING, SITE } from '../../lib/site';
import { btnPrimary, btnSecondary, breadcrumbNav, sectionTitle } from '../../lib/ui';

interface Props {
  page: BrandPage;
  entries: CollectionEntry<'products'>[];
  /** Celelalte pagini de marcă, pentru legăturile de la final. */
  others: BrandPage[];
  /** Paginile de categorie publicate, ca titlurile grupurilor să ducă la ele. */
  categoryPages: CategoryPage[];
}

const { page, entries, others, categoryPages } = Astro.props;
const roCollator = new Intl.Collator('ro', { sensitivity: 'base' });
const products = [...entries].sort((a, b) => roCollator.compare(a.data.name, b.data.name));
// Ce produse ale mărcii nu intră în „Testare fără riscuri” (căști, ochelari, mănuși electroizolante…).
const notTestable = riskFreeExclusions(products.map((e) => e.data));
const count = products.length;
const href = `/produse/${page.slug}/`;
const siteOrigin = Astro.site ?? new URL(Astro.url.origin);

// Grupate pe categorii, în ordinea din taxonomie.
const groups = (Object.keys(CATEGORIES) as CategoryKey[])
  .map((key) => ({
    key,
    label: CATEGORIES[key],
    items: products.filter((e) => e.data.category === key),
  }))
  .filter((g) => g.items.length > 0);

const withLogoZones = productsWithLogoZones(products);
const categorySummary = groups.map((g) => `${g.label.toLowerCase()} (${g.items.length})`).join(', ');
const logoAnswer =
  withLogoZones.length > 0
    ? `Da. Pentru ${modelsLabel(withLogoZones.length)} ${page.name}, producătorul dă zonele de logo și dimensiunile maxime; le vezi pe fișa fiecărui produs. Personalizarea o facem prin parteneri, prin broderie, serigrafie sau transfer termic.`
    : `Da. Personalizarea o facem prin parteneri, prin broderie, serigrafie sau transfer termic. Locul și mărimea logo-ului pe hainele ${page.name} le stabilim împreună la ofertă.`;

const faq = [
  {
    q: `Cine vinde ${page.name} în România?`,
    a: `You Protect, din Vetiș, județul Satu Mare, vinde produse ${page.name} firmelor și livrează în toată România. Ceri ofertă de pe youprotect.ro sau la ${SITE.telephoneDisplay}.`,
  },
  {
    q: `Ce produse ${page.name} găsesc la You Protect?`,
    a: `În catalog sunt ${modelsLabel(count)}: ${categorySummary}. Dacă cauți alt model ${page.name}, întreabă-ne și verificăm dacă îl putem aduce.`,
  },
  {
    q: `Pot testa produsele ${page.name} înainte să echipez toată firma?`,
    a: notTestable.length
      ? `${RISK_FREE_TESTING.text} Nu intră în testare: ${joinRo(notTestable)}.`
      : RISK_FREE_TESTING.text,
    link: { href: RISK_FREE_TESTING.href, label: 'Condițiile testării' },
  },
  {
    q: `Pot pune logo-ul firmei pe hainele ${page.name}?`,
    a: logoAnswer,
    link: { href: PERSONALIZATION_PAGE.href, label: PERSONALIZATION_PAGE.linkLabel },
  },
  {
    q: `De unde e ${page.name}?`,
    a: page.about,
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Acasă', item: siteOrigin.href },
    { '@type': 'ListItem', position: 2, name: 'Catalog', item: new URL('/produse/', siteOrigin).href },
    { '@type': 'ListItem', position: 3, name: page.name, item: new URL(href, siteOrigin).href },
  ],
};
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Produse ${page.name} la You Protect`,
  numberOfItems: count,
  itemListElement: products.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: e.data.name,
    url: new URL(`/produse/${e.id}/`, siteOrigin).href,
  })),
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};

---

<script type="application/ld+json" set:html={jsonLd(breadcrumbSchema)} />
<script type="application/ld+json" set:html={jsonLd(itemListSchema)} />
<script type="application/ld+json" set:html={jsonLd(faqSchema)} />

<section class="mx-auto max-w-7xl px-4 py-8 md:py-12">
  <nav aria-label="Breadcrumb" class={breadcrumbNav}>
    <a href="/" class="inline-block py-2 hover:text-yp-yellow transition-colors">Acasă</a>
    <span class="mx-2" aria-hidden="true">/</span>
    <a href="/produse/" class="inline-block py-2 hover:text-yp-yellow transition-colors">Catalog</a>
    <span class="mx-2" aria-hidden="true">/</span>
    <span class="text-yp-white">{page.name}</span>
  </nav>

  <header class="max-w-3xl">
    <h1 class="text-3xl md:text-4xl font-light text-yp-white leading-tight">{page.heading}</h1>
    <p class="mt-4 text-base text-yp-white/80 leading-relaxed">
      You Protect vinde produse {page.name} firmelor și livrează în toată România. Primești ofertă pentru cantitățile echipei tale,
      poți testa produsele înainte de comanda mare{notTestable.length > 0 && ', în condițiile programului'}, iar hainele le poți
      personaliza cu logo-ul firmei.
    </p>
    <p class="mt-3 text-sm text-yp-white/60 leading-relaxed">
      {page.about} Sursa: <a href={page.source.url} rel="noopener" class="underline underline-offset-4 hover:text-yp-yellow">{page.source.label}</a>.
    </p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a
        href="/cere-oferta/"
        class={btnPrimary}
      >
        Cere ofertă
      </a>
      <a
        href="/programeaza-discutie/"
        class={btnSecondary}
      >
        Discută cu un consultant
      </a>
    </div>
    <RiskFreeTesting variant="inline" class="mt-6" />
  </header>

  <!-- O singură grilă, în ordinea categoriilor: categoria e pe fiecare card, fără rânduri pe jumătate goale. -->
  <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4" aria-label={`Modele ${page.name}`}>
    {groups.flatMap((g) => g.items).map((e) => (
      <li>
        <ProductCard {...toCardProps(e)} />
      </li>
    ))}
  </ul>

  <p class="mt-10 max-w-3xl text-sm text-yp-white/70 leading-relaxed">
    Catalogul de pe site e o selecție. Dacă cauți alt model {page.name},
    <a href="/cere-oferta/" class="text-yp-yellow underline underline-offset-4 hover:text-yp-white">scrie-ne în cererea de ofertă</a>
    și verificăm dacă îl putem aduce.
  </p>

  <CertificationsTable products={products} headingClass={sectionTitle} />

  <section class="mt-14 max-w-3xl" aria-labelledby="intrebari">
    <h2 id="intrebari" class={sectionTitle}>Întrebări frecvente</h2>
    <dl class="space-y-6">
      {faq.map((item) => (
        <div>
          <dt class="text-yp-white font-medium">{item.q}</dt>
          <dd class="mt-2 text-yp-white/75 leading-relaxed">
            {item.a}
            {item.link && (
              <a href={item.link.href} class="block w-fit py-2 text-yp-yellow underline underline-offset-4 hover:text-yp-white">{item.link.label}</a>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <nav class="mt-14 pt-8 border-t border-yp-white/10" aria-label="Alte mărci">
    <h2 class={sectionTitle}>Alte mărci și categorii</h2>
    <ul class="flex flex-wrap gap-2">
      {others.map((o) => (
        <li>
          <a href={`/produse/${o.slug}/`} class="inline-block px-3 py-2 border border-yp-white/20 text-sm text-yp-white/80 hover:border-yp-yellow hover:text-yp-yellow transition-colors">
            {o.name}
          </a>
        </li>
      ))}
      {categoryPages.map((c) => (
        <li>
          <a href={`/produse/${c.slug}/`} class="inline-block px-3 py-2 border border-yp-white/20 text-sm text-yp-white/80 hover:border-yp-yellow hover:text-yp-yellow transition-colors">
            {CATEGORIES[c.key]}
          </a>
        </li>
      ))}
      <li>
        <a href="/produse/" class="inline-block px-3 py-2 border border-yp-white/20 text-sm text-yp-white/80 hover:border-yp-yellow hover:text-yp-yellow transition-colors">Tot catalogul</a>
      </li>
    </ul>
  </nav>
</section>
