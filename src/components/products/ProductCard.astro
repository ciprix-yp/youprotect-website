---
interface Props {
  id: string;
  name: string;
  slug: string;
  categoryName: string;
  shortDescription: string;
  producatorName?: string;
  featured?: boolean;
  merchandisingTags?: string[];
  thumbnailUrl?: string | null;
}

const {
  id,
  name,
  slug,
  categoryName,
  shortDescription,
  producatorName = "You Protect",
  featured = false,
  merchandisingTags = [],
  thumbnailUrl = null,
} = Astro.props;

const imageUrl = thumbnailUrl || "/hero-youprotect-highvis.jpg";
const imageAlt = `${name} - ${categoryName}`;
const normalizedTags = merchandisingTags
  .filter((tag) => !(featured && tag.toLowerCase() === "bestseller"))
  .slice(0, 2);
const primaryTag = featured ? "Bestseller" : (normalizedTags[0] ?? null);
---

<article
  class="group relative flex flex-col w-full h-full border border-yp-white/10 bg-yp-black/20 hover:bg-yp-black/60 hover:border-yp-yellow/50 transition-all duration-500 overflow-hidden"
>
  <!-- Wireframe corner accents -->
  <div
    class="absolute top-0 left-0 w-2 h-2 border-t border-l border-yp-white/20 group-hover:border-yp-yellow/50 transition-colors z-20"
  >
  </div>
  <div
    class="absolute top-0 right-0 w-2 h-2 border-t border-r border-yp-white/20 group-hover:border-yp-yellow/50 transition-colors z-20"
  >
  </div>

  <div
    class="relative w-full overflow-hidden bg-yp-black/60 border-b border-yp-white/10 aspect-[4/5] object-cover"
  >
    <a href={`/produse/${slug}`} class="block w-full h-full">
      <img
        src={imageUrl}
        alt={imageAlt}
        loading="lazy"
        class="w-full h-full object-cover mix-blend-luminosity hover:mix-blend-normal transition-all duration-700 ease-out group-hover:scale-105 opacity-80 group-hover:opacity-100"
      />
    </a>

    <div class="absolute top-4 left-4 z-10 flex flex-col gap-2">
      {
        primaryTag && (
          <span class="inline-flex items-center px-2 py-1 text-[9px] uppercase tracking-[0.2em] bg-yp-black border border-yp-white/20 text-yp-white font-medium shadow-sm group-hover:border-yp-yellow group-hover:text-yp-yellow transition-colors">
            {primaryTag}
          </span>
        )
      }
    </div>

    <!-- Hover quick actions overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-yp-black/90 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none flex items-end p-6"
    >
      <a
        href={`/produse/${slug}`}
        title="Vezi Detalii Tehnice"
        class="pointer-events-auto ml-auto flex items-center justify-center w-10 h-10 border border-yp-yellow text-yp-yellow hover:bg-yp-yellow hover:text-yp-black rounded-sm shadow-lg transition-all duration-300"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>
  </div>

  <div class="flex flex-col flex-1 p-5">
    <div class="flex justify-between items-start gap-4 mb-3">
      <p
        class="text-[9px] font-medium uppercase tracking-[0.2em] text-yp-white/60 group-hover:text-yp-white transition-colors"
      >
        {categoryName}
      </p>
      <p
        class="text-[9px] font-medium uppercase tracking-[0.2em] text-yp-white/30"
      >
        {producatorName}
      </p>
    </div>

    <h3
      class="text-lg md:text-xl font-light text-yp-white leading-snug tracking-wide mb-3 group-hover:text-yp-yellow transition-colors duration-300"
    >
      <a href={`/produse/${slug}`}>
        <span class="absolute inset-0 z-0"></span>
        {name}
      </a>
    </h3>

    <p
      class="text-xs text-yp-white/50 font-light leading-relaxed line-clamp-2 mt-auto"
    >
      {shortDescription || "Echipament tehnic din portofoliul You Protect."}
    </p>

    <div
      class="mt-4 pt-4 border-t border-yp-white/5 flex items-center justify-between opacity-50 group-hover:opacity-100 transition-opacity"
    >
      <span class="text-[10px] uppercase tracking-widest text-yp-white/60"
        >Specificații</span
      >
      <svg
        class="w-3 h-3 text-yp-white/40 group-hover:text-yp-yellow"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
      >
    </div>
  </div>
</article>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
