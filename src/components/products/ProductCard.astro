---
interface Props {
  id: string;
  name: string;
  slug: string;
  categoryName: string;
  shortDescription: string;
  producatorName?: string;
  featured?: boolean;
  merchandisingTags?: string[];
  thumbnailUrl?: string | null;
}

const {
  id,
  name,
  slug,
  categoryName,
  shortDescription,
  producatorName = "You Protect",
  featured = false,
  merchandisingTags = [],
  thumbnailUrl = null,
} = Astro.props;

const imageUrl = thumbnailUrl || "/hero-youprotect-highvis.jpg";
const imageAlt = `${name} - ${categoryName}`;
const normalizedTags = merchandisingTags
  .filter((tag) => !(featured && tag.toLowerCase() === "bestseller"))
  .slice(0, 2);
const primaryTag = featured ? "Bestseller" : (normalizedTags[0] ?? null);
---

<article
  class="group relative flex flex-col w-full h-full overflow-hidden transition-all duration-500 hover:-translate-y-2"
>
  <div
    class="relative w-full overflow-hidden bg-yp-black/40 mb-4 aspect-[4/5] md:aspect-[3/4]"
  >
    <a href={`/produse/${slug}`} class="block w-full h-full">
      <img
        src={imageUrl}
        alt={imageAlt}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 opacity-90 group-hover:opacity-100"
      />
    </a>

    <div class="absolute top-4 left-4 z-10 flex flex-col gap-2">
      {
        primaryTag && (
          <span class="inline-flex items-center px-2 py-1 text-[10px] uppercase tracking-widest bg-yp-white text-yp-black font-semibold shadow-sm">
            {primaryTag}
          </span>
        )
      }
    </div>

    <!-- Hover quick actions overlay -->
    <div
      class="absolute inset-0 bg-yp-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none flex items-end p-6"
    >
      <button
        type="button"
        title="Adaugă în Selecție"
        data-shortlist-toggle
        data-product-id={id}
        data-product-name={name}
        data-product-slug={slug}
        data-product-category={categoryName}
        class="pointer-events-auto ml-auto flex items-center justify-center w-12 h-12 bg-yp-yellow text-yp-black rounded-full shadow-lg hover:scale-110 transition-transform duration-300"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 4v16m8-8H4"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="flex flex-col flex-1 px-1">
    <div class="flex justify-between items-start gap-4 mb-1">
      <p
        class="text-[10px] font-medium uppercase tracking-[0.2em] text-yp-white/40"
      >
        {categoryName}
      </p>
      <p
        class="text-[10px] font-light uppercase tracking-widest text-yp-white/30"
      >
        {producatorName}
      </p>
    </div>

    <h3
      class="text-xl md:text-2xl font-light text-yp-white leading-tight mb-2 group-hover:text-yp-yellow transition-colors duration-300"
    >
      <a href={`/produse/${slug}`}>{name}</a>
    </h3>

    <p
      class="text-sm text-yp-white/60 font-light leading-relaxed line-clamp-2 mt-auto"
    >
      {shortDescription || "Echipament tehnic din portofoliul You Protect."}
    </p>
  </div>
</article>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
