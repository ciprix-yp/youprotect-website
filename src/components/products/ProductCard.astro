---
interface Props {
  id: string;
  name: string;
  slug: string;
  categoryName: string;
  shortDescription: string;
  producatorName?: string;
  featured?: boolean;
  merchandisingTags?: string[];
  thumbnailUrl?: string | null;
}

const {
  id,
  name,
  slug,
  categoryName,
  shortDescription,
  producatorName = 'You Protect',
  featured = false,
  merchandisingTags = [],
  thumbnailUrl = null,
} = Astro.props;

const imageUrl = thumbnailUrl || '/hero-youprotect-highvis.jpg';
const imageAlt = `${name} - ${categoryName}`;
const normalizedTags = merchandisingTags
  .filter((tag) => !(featured && tag.toLowerCase() === 'bestseller'))
  .slice(0, 2);
const primaryTag = featured ? 'Bestseller' : normalizedTags[0] ?? null;
---

<article class="group h-full flex flex-col bg-gradient-to-b from-yp-gray to-yp-black rounded-xl overflow-hidden border border-yp-white/10 transition-all duration-300 hover:-translate-y-1 hover:border-yp-yellow/30">
  <a href={`/produse/${slug}`} class="block relative overflow-hidden border-b border-yp-white/10">
    <img
      src={imageUrl}
      alt={imageAlt}
      loading="lazy"
      class="w-full aspect-[4/3] object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-yp-black/90 via-yp-black/45 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 p-5">
      <p class="text-xs uppercase tracking-wide text-yp-yellow/85">{categoryName}</p>
      <h3 class="text-2xl text-yp-white mt-2 leading-tight">{name}</h3>
      <p class="text-sm text-yp-white/70 mt-1">{producatorName}</p>

      {primaryTag && (
        <div class="mt-3">
          <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs rounded-full border border-yp-white/25 text-yp-white/85 bg-yp-black/35">
            {primaryTag}
          </span>
        </div>
      )}
    </div>
  </a>

  <div class="p-5 flex flex-col flex-1">
    <p class="text-sm text-yp-white/75 leading-relaxed flex-1 line-clamp-3">
      {shortDescription || 'Descriere in curs de completare.'}
    </p>
    <p class="mt-3 text-[11px] uppercase tracking-[0.14em] text-yp-white/45">
      Protectie validata. Utilizare intensiva.
    </p>

    <div class="mt-5 flex items-center justify-end">
      <button
        type="button"
        data-shortlist-toggle
        data-product-id={id}
        data-product-name={name}
        data-product-slug={slug}
        data-product-category={categoryName}
        class="inline-flex items-center justify-center rounded-md bg-yp-yellow text-yp-black text-sm font-semibold px-3 py-2 hover:bg-yp-white transition-colors"
      >
        Selecteaza produs
      </button>
    </div>
  </div>
</article>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
