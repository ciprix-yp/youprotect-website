---
// Cardul de produs: aceeași structură și aceeași înălțime pe fiecare rând (poza 4:5, numele pe 3 rânduri — 4 pe
// telefon, unde cardul e îngust —, standardul pe 2 rânduri), ca grila să rămână aliniată oricât de lung e numele.
// Design premium (20.11.2026): card 3D (data-tilt, src/scripts/tilt.ts), poza pe fond cald (.img-well). Marca e jos,
// lângă „Adaugă la ofertă”: în nume apare deja, iar sus ar fura un rând numelui pe telefon.
// „Adaugă la ofertă” (lista de ofertă, 20.11.2026) a luat locul linkului „Cere ofertă”: din catalog, clientul strânge
// mai multe produse și cere o singură ofertă (linkul din antet). „Cere ofertă” pentru un singur produs e pe fișă.
// data-vt-photo: poza trece din card în fișa produsului la click (scripts/fluid.ts).
import type { CardProps } from '../../lib/product-card';
import QuoteListButton from './QuoteListButton.astro';

type Props = CardProps;
const { slug, name, brand, spec, image, imageKind, imageAlt, imageFocus } = Astro.props;
// Scena (poză în context): decupaj cover pe punctul de focus; focus-ul vine din schemă (regex „X% Y%”), deci e sigur în style.
const isScene = imageKind === 'scena';
const href = `/produse/${slug}/`;
---

<article
  data-tilt="7"
  class="card-3d group relative flex h-full flex-col rounded-xl border border-white/[0.08] bg-yp-surface shadow-card hover:border-yp-yellow/40 hover:shadow-card-hover focus-within:border-yp-yellow"
>
  <div class:list={['tilt-pop img-well relative aspect-[4/5] overflow-hidden rounded-t-xl', isScene && 'img-well--scene']} data-vt-photo={slug}>
    <img
      src={image}
      alt={imageAlt ?? name}
      width="600"
      height="750"
      loading="lazy"
      style={isScene && imageFocus ? `object-position: ${imageFocus}` : undefined}
      class:list={[
        'absolute inset-0 h-full w-full',
        isScene ? 'object-cover' : 'object-contain',
        // Zoom doar pe packshot: pe cardurile cu om, poza stă pe loc (marginea e deja în pixeli, în varianta de 600 px).
        imageKind === 'packshot' && 'transition-transform duration-300 ease-out-strong group-hover:scale-[1.04]',
      ]}
    />
  </div>
  <div class="flex flex-1 flex-col px-3 pb-1 pt-3 sm:px-4 sm:pt-4">
    <h3 class="min-h-[4lh] text-[0.9375rem] font-medium leading-snug text-yp-white line-clamp-4 sm:min-h-[3lh] sm:text-base sm:line-clamp-3">
      <a href={href} class="after:absolute after:inset-0 after:rounded-xl after:content-[''] focus-visible:outline-none">{name}</a>
    </h3>
    <p class="mt-2 min-h-[2lh] text-xs leading-snug text-yp-white/65 line-clamp-2" title={spec ?? undefined}>{spec}</p>
    <div class="mt-auto flex items-center justify-between gap-2 border-t border-white/[0.08] pt-1">
      {/* Pe telefon, cardul e prea îngust pentru marcă și buton („MAS…”); marca e oricum în nume. */}
      <span class="hidden truncate text-xs text-yp-white/50 sm:block">{brand}</span>
      <QuoteListButton slug={slug} name={name} location="card-produs" variant="card" />
    </div>
  </div>
  <span class="tilt-sheen" aria-hidden="true"></span>
</article>
