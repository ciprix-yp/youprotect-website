---
// Cardul de produs: aceeași structură și aceeași înălțime pe fiecare rând (poza pătrată, numele pe două rânduri,
// un rând pentru standard), ca grila să rămână aliniată oricât de lung e numele.
import type { CardProps } from '../../lib/product-card';

type Props = CardProps;
const { slug, name, brand, categoryName, spec, image } = Astro.props;
const href = `/produse/${slug}/`;
const offerHref = `/cere-oferta/?produs=${encodeURIComponent(slug)}`;
---

<article
  class="group relative flex h-full flex-col border border-yp-white/10 bg-yp-black transition-colors hover:border-yp-yellow/60 focus-within:border-yp-yellow"
>
  <div class="relative aspect-square overflow-hidden bg-white">
    <img src={image} alt={name} width="600" height="600" loading="lazy" class="absolute inset-0 h-full w-full object-contain p-3 sm:p-5" />
  </div>
  <div class="flex flex-1 flex-col p-3 sm:p-4">
    <p class="truncate text-xs text-yp-white/60">{brand}</p>
    <h3 class="mt-1 min-h-[3lh] text-sm font-medium leading-snug text-yp-white line-clamp-3 sm:text-base">
      <a href={href} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">{name}</a>
    </h3>
    <p class="mb-3 mt-2 min-h-[1lh] truncate text-xs text-yp-white/75" title={spec ?? undefined}>{spec}</p>
    <div class="mt-auto flex items-center justify-between gap-2 border-t border-yp-white/10 pt-3">
      <span class="hidden truncate text-xs text-yp-white/60 sm:block">{categoryName}</span>
      <a
        href={offerHref}
        class="relative z-10 shrink-0 py-2 text-xs font-medium text-yp-yellow underline-offset-4 hover:underline"
        aria-label={`Cere ofertă: ${name}`}
      >
        Cere ofertă
      </a>
    </div>
  </div>
</article>
