---
// Pagina de categorie din catalog (/produse/<slug>/). Textul general vine din src/lib/catalog-categories.ts; modelele,
// mărcile și certificările se generează din fișele de produs, ca să rămână adevărate când se schimbă catalogul.
import type { CollectionEntry } from 'astro:content';
import ProductCard from './ProductCard.astro';
import { toCardProps } from '../../lib/product-card';
import CertificationsTable from './CertificationsTable.astro';
import RiskFreeTesting from '../global/RiskFreeTesting.astro';
import { CATEGORIES } from '../../lib/catalog-taxonomy';
import { joinRo, type CategoryPage } from '../../lib/catalog-categories';
import { jsonLd } from '../../lib/json-ld';
import { PERSONALIZATION_PAGE } from '../../lib/personalization';
import { guideHref, guidesForCategory } from '../../lib/guides';
import { CTA_DISCUSS, SITE } from '../../lib/site';
import { btnPrimary, btnSecondary, breadcrumbNav, sectionTitle } from '../../lib/ui';

interface Props {
  page: CategoryPage;
  entries: CollectionEntry<'products'>[];
  /** Celelalte pagini de categorie, pentru legăturile de la final. */
  others: CategoryPage[];
}

const { page, entries, others } = Astro.props;
const roCollator = new Intl.Collator('ro', { sensitivity: 'base' });
const products = [...entries].sort((a, b) => roCollator.compare(a.data.name, b.data.name));
const brands = [...new Set(products.map((e) => e.data.supplier.brand))].sort(roCollator.compare);
// Dala „Nu găsești modelul potrivit?” apare doar unde completează un rând început (2, 3 sau 4 coloane); pe un rând
// plin ar sta singură. Clasele sunt scrise întregi, ca Tailwind să le găsească.
const n = products.length;
const closingTileClass = [
  n % 2 === 0 ? 'hidden' : 'block',
  n % 3 === 0 ? 'md:hidden' : 'md:block',
  n % 4 === 0 ? 'lg:hidden' : 'lg:block',
].join(' ');
const href = `/produse/${page.slug}/`;
const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const guides = guidesForCategory(page.key);

const faq: { q: string; a: string; link?: { href: string; label: string } }[] = [
  {
    q: `Ce certificări au ${page.plural} din catalogul You Protect?`,
    a: products
      .map((e) => `${e.data.name}: ${e.data.certifications.map((c) => c.code).join(', ') || 'fără certificare declarată de producător'}.`)
      .join(' '),
  },
  ...(page.logo
    ? [
        {
          q: `Pot personaliza ${page.plural} cu logo-ul firmei?`,
          a: 'Da. Personalizarea cu logo o facem prin parteneri, prin broderie, serigrafie sau transfer termic, în funcție de produs. Locul și mărimea logo-ului le stabilim împreună la ofertă.',
          link: { href: PERSONALIZATION_PAGE.href, label: PERSONALIZATION_PAGE.linkLabel },
        },
      ]
    : []),
  {
    q: `De unde comand ${page.plural} pentru firma mea?`,
    a: `De la You Protect, din Vetiș, județul Satu Mare. Ceri ofertă de pe youprotect.ro sau la ${SITE.telephoneDisplay}, iar livrarea se face în toată România.`,
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Acasă', item: siteOrigin.href },
    { '@type': 'ListItem', position: 2, name: 'Catalog', item: new URL('/produse/', siteOrigin).href },
    { '@type': 'ListItem', position: 3, name: page.heading, item: new URL(href, siteOrigin).href },
  ],
};
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: page.heading,
  itemListElement: products.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: e.data.name,
    url: new URL(`/produse/${e.id}/`, siteOrigin).href,
  })),
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};

---

<script type="application/ld+json" set:html={jsonLd(breadcrumbSchema)} />
<script type="application/ld+json" set:html={jsonLd(itemListSchema)} />
<script type="application/ld+json" set:html={jsonLd(faqSchema)} />

<section class="mx-auto max-w-7xl px-4 py-8 md:py-12">
  <nav aria-label="Breadcrumb" class={breadcrumbNav}>
    <a href="/" class="inline-flex min-h-11 items-center hover:text-yp-yellow transition-colors">Acasă</a>
    <span class="mx-2" aria-hidden="true">/</span>
    <a href="/produse/" class="inline-flex min-h-11 items-center hover:text-yp-yellow transition-colors">Catalog</a>
    <span class="mx-2" aria-hidden="true">/</span>
    <span class="text-yp-white">{CATEGORIES[page.key]}</span>
  </nav>

  <header class="max-w-3xl">
    <h1 class="text-3xl md:text-4xl font-light text-yp-white leading-tight">{page.heading}</h1>
    <p class="mt-4 text-base text-yp-white/80 leading-relaxed">{page.intro}</p>
    <p class="mt-3 text-sm text-yp-white/60">Modele {joinRo(brands)}. Prețul îl primești în ofertă, pentru cantitățile echipei tale.</p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a
        href="/cere-oferta/"
        class={btnPrimary}
      >
        Cere ofertă
      </a>
      <a
        href="/programeaza-discutie/"
        class={btnSecondary}
      >
        {CTA_DISCUSS}
      </a>
    </div>
    {products.every((e) => e.data.riskFreeTesting) && <RiskFreeTesting variant="inline" class="mt-6" />}
  </header>

  <ul class="mt-10 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4" aria-label={`Modele: ${CATEGORIES[page.key]}`}>
    {products.map((e) => (
      <li>
        <ProductCard {...toCardProps(e)} />
      </li>
    ))}
    <li class={closingTileClass}>
      <!-- Bloc de îndemn, nu card gol: conținutul stă la mijloc, oricât de înalt e rândul de produse. -->
      <div class="flex h-full flex-col items-start justify-center gap-4 border border-yp-yellow/30 bg-yp-yellow/[0.04] p-4 sm:p-6">
        <svg class="h-8 w-8 text-yp-yellow" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.2-5.2M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z" />
        </svg>
        <div>
          <p class="text-base font-medium text-yp-white sm:text-lg">Nu găsești modelul potrivit?</p>
          <p class="mt-2 text-sm leading-relaxed text-yp-white/75">
            Scrie-ne ce îți trebuie: modelul, clasa de protecție sau mărimile. Verificăm dacă îl putem aduce.
          </p>
        </div>
        <a href="/cere-oferta/" class={btnPrimary}>Cere ofertă</a>
        <a href="/programeaza-discutie/" class="-mt-2 py-2 text-sm text-yp-white/75 underline underline-offset-4 hover:text-yp-yellow">sau {CTA_DISCUSS.toLowerCase()}</a>
      </div>
    </li>
  </ul>

  {guides.length > 0 && (
    <aside class="mt-10 max-w-3xl border-l-2 border-yp-yellow pl-4" aria-label="Ghiduri">
      {guides.map((g) => (
        <p>
          <span class="block text-sm font-medium text-yp-yellow">Ghid</span>
          <a href={guideHref(g)} class="inline-flex min-h-11 items-center text-yp-white underline underline-offset-4 decoration-yp-white/30 hover:text-yp-yellow">{g.heading}</a>
        </p>
      ))}
    </aside>
  )}

  <CertificationsTable products={products} headingClass={sectionTitle} />

  <section class="mt-14 max-w-3xl" aria-labelledby="intrebari">
    <h2 id="intrebari" class={sectionTitle}>Întrebări frecvente</h2>
    <dl class="space-y-6">
      {faq.map((item) => (
        <div>
          <dt class="text-yp-white font-medium">{item.q}</dt>
          <dd class="mt-2 text-yp-white/75 leading-relaxed">
            {item.a}
            {item.link && (
              <a href={item.link.href} class="block w-fit py-2 text-yp-yellow underline underline-offset-4 hover:text-yp-white">{item.link.label}</a>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  {others.length > 0 && (
    <nav class="mt-14 pt-8 border-t border-yp-white/10" aria-label="Alte categorii">
      <h2 class={sectionTitle}>Alte categorii</h2>
      <ul class="flex flex-wrap gap-2">
        {others.map((o) => (
          <li>
            <a href={`/produse/${o.slug}/`} class="inline-flex min-h-11 items-center rounded-lg px-3 border border-yp-white/20 text-sm text-yp-white/80 hover:border-yp-yellow hover:text-yp-yellow transition-colors">
              {CATEGORIES[o.key]}
            </a>
          </li>
        ))}
        <li>
          <a href="/produse/" class="inline-flex min-h-11 items-center rounded-lg px-3 border border-yp-white/20 text-sm text-yp-white/80 hover:border-yp-yellow hover:text-yp-yellow transition-colors">Tot catalogul</a>
        </li>
      </ul>
    </nav>
  )}
</section>
