---
import { SITE } from "../lib/site";
import "../styles/vendor";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogType?: string;
  ogImage?: string;
}

const {
  title,
  description = "Echipamente de protecție și uniforme personalizate pentru companii.",
  noindex = true, // By default landing pages are hidden from SEO
  ogType = "website",
  ogImage = SITE.defaultOgImage,
} = Astro.props;

const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title} | You Protect</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/fonts/yp-text-300.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/yp-text-400.woff2" as="font" type="font/woff2" crossorigin />

    <!-- SEO & OG Tags -->
    <meta property="og:title" content={`${title} | You Protect`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={ogImageUrl} />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | You Protect`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="bg-yp-black text-yp-white font-body min-h-screen flex flex-col">
    <header class="py-6 px-4 md:px-8 bg-yp-black border-b border-white/5 flex justify-center">
      <a href="/" aria-label="You Protect, pagina principală" class="inline-block transition-transform hover:scale-105">
        <img
          src="/images/logo-yp-clean.png"
          alt="You Protect"
          width="56"
          height="56"
          class="h-12 md:h-14 w-auto object-contain"
        />
      </a>
    </header>

    <main class="flex-grow flex flex-col">
      <slot />
    </main>

    <footer class="py-6 text-center text-sm text-neutral-400 border-t border-white/5">
      &copy; {new Date().getFullYear()} You Protect. Toate drepturile rezervate.
    </footer>
    <script>
      import "../scripts/aos-init";
    </script>
  </body>
</html>
