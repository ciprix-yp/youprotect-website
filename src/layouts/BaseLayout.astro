---
import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Echipamente de protecție și uniforme personalizate pentru companii.",
} = Astro.props;
const defaultBookingsUrl =
  "https://outlook.office.com/book/Booking@youprotect.ro/?ismsaljsauthenabled";
const bookingsUrl =
  import.meta.env.PUBLIC_MICROSOFT_BOOKINGS_URL ||
  import.meta.env.PUBLIC_BOOKINGS_URL ||
  defaultBookingsUrl;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | You Protect</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Lato:wght@300;400;700&display=swap"
      rel="stylesheet"
    />
    <!-- AOS CSS -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />

    <!-- SEO & OG Tags -->
    <meta property="og:title" content={`${title} | You Protect`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <link rel="canonical" href={Astro.url.href} />

    <!-- JSON-LD LocalBusiness Schema -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "B2BBusiness",
        name: "You Protect",
        image: "https://youprotect.ro/favicon.png",
        description:
          "Furnizor premium de echipamente de protecție (SSM) și haine de lucru personalizate pentru companii din România.",
        url: "https://youprotect.ro",
        telephone: "+40742226127",
        email: "office@youprotect.ro",
        address: {
          "@type": "PostalAddress",
          streetAddress: "Strada Careiului nr 11",
          addressLocality: "Vetiș",
          addressRegion: "Satu Mare",
          addressCountry: "RO",
        },
        geo: {
          "@type": "GeoCoordinates",
          latitude: 47.7602,
          longitude: 22.8447,
        },
        priceRange: "$$",
      })}
    />
  </head>
  <body class="bg-yp-black text-yp-white font-body">
    <Header />

    <main>
      <slot />
    </main>

    <Footer />

    <!-- AOS Initialization -->
    <script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script is:inline>
      const initAOS = () => {
        // Only init if AOS is defined
        if (typeof AOS !== "undefined") {
          AOS.init({
            once: true, // animăm o singură dată, la prima apariție (mai puțin „template-y")
            mirror: false, // nu reluăm animația la scroll înapoi
            offset: 100, // offset (in px) from the original trigger point
            duration: 800, // values from 0 to 3000, with step 50ms
            easing: "ease-out-cubic", // default easing for AOS animations
            delay: 50, // values from 0 to 3000, with step 50ms
          });
        }
      };

      // Run on DOM loaded
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initAOS);
      } else {
        initAOS();
      }

      // If Astro ViewTransitions are ever added, this ensures AOS re-initializes on page swap:
      document.addEventListener("astro:after-swap", initAOS);
    </script>
  </body>
</html>
