---
const { title = "You Protect - Echipamente de Protecție" } = Astro.props;
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700&family=Lato:wght@400&family=Playfair+Display:ital@1&display=swap" rel="stylesheet">
  </head>
  <body class="bg-yp-black text-yp-white">
    <slot />
  </body>
</html>
