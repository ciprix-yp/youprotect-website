---
import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";
import { SITE, sameAs } from "../lib/site";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
}

const {
  title,
  description = "Echipamente de protecție și uniforme personalizate pentru companii.",
  ogType = "website",
  ogImage = SITE.defaultOgImage,
} = Astro.props;

// OG/Twitter cer URL-uri absolute. `new URL` ignoră baza dacă input-ul e deja absolut.
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url).href;
const defaultBookingsUrl =
  "https://outlook.office.com/book/Booking@youprotect.ro/?ismsaljsauthenabled";
const bookingsUrl =
  import.meta.env.PUBLIC_MICROSOFT_BOOKINGS_URL ||
  import.meta.env.PUBLIC_BOOKINGS_URL ||
  defaultBookingsUrl;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | You Protect</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Lato:wght@300;400;700&display=swap"
      rel="stylesheet"
    />
    <!-- AOS CSS -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />

    <!-- SEO & OG Tags -->
    <meta property="og:title" content={`${title} | You Protect`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={ogImageUrl} />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | You Protect`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD LocalBusiness Schema -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "@id": `${SITE.url}/#localbusiness`,
        name: SITE.name,
        image: new URL(SITE.defaultOgImage, SITE.url).href,
        description:
          "Furnizor premium de echipamente de protecție (SSM) și haine de lucru personalizate pentru companii din România.",
        url: SITE.url,
        telephone: SITE.telephone,
        email: SITE.email,
        address: {
          "@type": "PostalAddress",
          streetAddress: SITE.address.streetAddress,
          addressLocality: SITE.address.addressLocality,
          addressRegion: SITE.address.addressRegion,
          postalCode: SITE.address.postalCode,
          addressCountry: SITE.address.addressCountry,
        },
        geo: {
          "@type": "GeoCoordinates",
          latitude: SITE.geo.latitude,
          longitude: SITE.geo.longitude,
        },
        areaServed: SITE.areaServed,
        openingHoursSpecification: [
          {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: SITE.openingHours.days,
            opens: SITE.openingHours.opens,
            closes: SITE.openingHours.closes,
          },
        ],
        priceRange: "$$",
        ...(sameAs.length ? { sameAs } : {}),
      })}
    />
  </head>
  <body class="bg-yp-black text-yp-white font-body">
    <Header />

    <main>
      <slot />
    </main>

    <Footer />

    <!-- AOS Initialization -->
    <script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script is:inline>
      const initAOS = () => {
        // Only init if AOS is defined
        if (typeof AOS !== "undefined") {
          AOS.init({
            once: true, // animăm o singură dată, la prima apariție (mai puțin „template-y")
            mirror: false, // nu reluăm animația la scroll înapoi
            offset: 100, // offset (in px) from the original trigger point
            duration: 800, // values from 0 to 3000, with step 50ms
            easing: "ease-out-cubic", // default easing for AOS animations
            delay: 50, // values from 0 to 3000, with step 50ms
          });
        }
      };

      // Run on DOM loaded
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initAOS);
      } else {
        initAOS();
      }

      // If Astro ViewTransitions are ever added, this ensures AOS re-initializes on page swap:
      document.addEventListener("astro:after-swap", initAOS);
    </script>
  </body>
</html>
