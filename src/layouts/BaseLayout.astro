---
import { jsonLd } from '../lib/json-ld';
import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";
import Analytics from "../components/global/Analytics.astro";
import { SITE, sameAs } from "../lib/site";
import "../styles/vendor";
import "../styles/global.css";
// Același fișier pe care îl cere CSS-ul din @fontsource (h1 și titlurile): `?url` dă calea cu hash din build.
import headingLatin300 from "@fontsource/montserrat/files/montserrat-latin-300-normal.woff2?url";

const FONT_FILES = {
  "text-300": "/fonts/yp-text-300.woff2",
  "text-400": "/fonts/yp-text-400.woff2",
  "heading-300": headingLatin300,
} as const;
type FontKey = keyof typeof FONT_FILES;

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  noindex?: boolean;
  /** true: fonturile de text; lista: doar acelea ("text-300" | "text-400" | "heading-300"); false: niciunul. Lista scurtă pe paginile al căror LCP e o poză-erou: preload-urile de fonturi ar concura cu poza pentru lățimea de bandă. */
  preloadFonts?: boolean | FontKey[];
}

const {
  title,
  description = "Echipamente de protecție și uniforme personalizate pentru companii.",
  ogType = "website",
  ogImage = SITE.defaultOgImage,
  noindex = false,
  preloadFonts = true,
} = Astro.props;
const preloaded: FontKey[] = preloadFonts === true ? ["text-300", "text-400"] : preloadFonts === false ? [] : preloadFonts;

// OG/Twitter cer URL-uri absolute. `new URL` ignoră baza dacă input-ul e deja absolut.
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title} | You Protect</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    {/* Preload-urile pornesc în același moment cu poza-erou și, pe 4G lent, îi iau jumătate din bandă: LCP-ul pozei
        trecea de 2 s (măsurat 26.11.2026: fără preload ~1,0 s, cu preload ~2,1 s). Paginile cu poză-erou le opresc
        (preloadFonts={["heading-300"]}): preîncarcă doar fontul h1-ului, ca titlul să nu se schimbe vizibil; fontul de text se aplică atunci cu font-display: swap, imediat ce ajunge. */}
    {preloaded.map((k) => <link rel="preload" href={FONT_FILES[k]} as="font" type="font/woff2" crossorigin />)}
    <slot name="head" />
    <script is:inline>
      // Tranziția înapoi spre o listă de produse (vezi scripts/fluid.ts): cardul produsului de unde vii primește
      // numele pozei, ca poza să se întoarcă în card. Inline în <head>, ca să ruleze înainte de pagereveal.
      addEventListener("pagereveal", function (e) {
        var cards = document.querySelectorAll("[data-vt-photo]");
        var clear = function () {
          for (var i = 0; i < cards.length; i++) cards[i].style.viewTransitionName = "";
        };
        clear();
        var gallery = document.getElementById("gallery-well");
        if (gallery) gallery.style.viewTransitionName = "";
        var vt = e.viewTransition;
        var activation = window.navigation && window.navigation.activation;
        if (!vt || gallery || !activation || !activation.from || !activation.from.url) return;
        var m = /^\/produse\/([a-z0-9-]+)\/$/.exec(new URL(activation.from.url, location.href).pathname);
        var photo = m && document.querySelector('[data-vt-photo="' + m[1] + '"]');
        if (!photo) return;
        var r = photo.getBoundingClientRect();
        if (r.width === 0 || r.bottom <= 0 || r.top >= innerHeight) return;
        photo.style.viewTransitionName = "product-photo";
        vt.finished.then(clear, clear);
      });
    </script>

    <!-- SEO & OG Tags -->
    <meta property="og:title" content={`${title} | You Protect`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={ogImageUrl} />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | You Protect`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD LocalBusiness Schema -->
    <script
      type="application/ld+json"
      set:html={jsonLd({
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "@id": `${SITE.url}/#localbusiness`,
        name: SITE.name,
        legalName: SITE.legal.name,
        // Anul din Nr. Reg. Com. (J30/646/2022); fondatoarea e cea de pe /despre-noi/.
        foundingDate: SITE.legal.foundingYear,
        founder: { "@type": "Person", name: SITE.legal.founder },
        image: new URL(SITE.defaultOgImage, SITE.url).href,
        description:
          "Echipamente de protecție și haine de lucru MASCOT, Portwest și Sir Safety pentru firme, personalizate cu logo. Showroom cu cabină de probă în Vetiș, Satu Mare; livrare în toată România.",
        url: SITE.url,
        telephone: SITE.telephone,
        email: SITE.email,
        address: {
          "@type": "PostalAddress",
          streetAddress: SITE.address.streetAddress,
          addressLocality: SITE.address.addressLocality,
          addressRegion: SITE.address.addressRegion,
          postalCode: SITE.address.postalCode,
          addressCountry: SITE.address.addressCountry,
        },
        geo: {
          "@type": "GeoCoordinates",
          latitude: SITE.geo.latitude,
          longitude: SITE.geo.longitude,
        },
        areaServed: SITE.areaServed,
        openingHoursSpecification: [
          {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: SITE.openingHours.days,
            opens: SITE.openingHours.opens,
            closes: SITE.openingHours.closes,
          },
        ],
        // Showroom-ul are cabină de probă (owner, 20.11.2026).
        amenityFeature: [{ "@type": "LocationFeatureSpecification", name: "Cabină de probă", value: true }],
        priceRange: "$$",
        ...(sameAs.length ? { sameAs } : {}),
      })}
    />
  </head>
  <body class="bg-yp-black text-yp-white font-body">
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
    <Analytics />
    <script>
      import "../scripts/tilt";
      import "../scripts/fluid";
      import "../scripts/quote-list";
    </script>
  </body>
</html>
